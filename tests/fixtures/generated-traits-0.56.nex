module generated_traits;
trait Read {type Item;fn get(value:Self)->Read::Item<Self>;}
struct Box<T> {value:T;}
fn extract<T>(value:Box<T>)->T {return value.value;}
impl boxes<T>:Read for Box<T> {type Item=T;get=extract<T>;}
fn read<T:Read>(value:T)->Read::Item<T> {return Read<T>::get(value);}
trait Mapper<Self<_>> {fn map<A,B>(values:Self<A>,apply:fn(A)->B)->Self<B>;}
fn map_list<A,B>(values:list<A>,apply:fn(A)->B)->list<B> {
 var result:list<B>=[];var i:i64=0;
 while i<len(values){result=push(result,apply(values[i]));i=i+1;}
 return result;
}
impl lists:Mapper for list {map=map_list;}
fn convert<F<_>:Mapper,A,B>(values:F<A>,apply:fn(A)->B)->F<B> {return Mapper<F>::map<A,B>(values,apply);}
