      "id": "typed-error-finally",
      "kind": "change",
      "contract": {
        "objective": "Preserve typed error payloads and run finalization once on success and failure.",
        "domain": "Input is valid Unicode text. Only the exact text 42 denotes success.",
        "neutral_interface": "read_with_trace(text) -> success(value,trace) | failure(text,trace)",
        "visible_cases": [
          {
            "input": {
              "text": "42"
            },
            "expected": {
              "ok": 42,
              "trace": [
                "finished"
              ]
            }
          },
          {
            "input": {
              "text": "bad"
            },
            "expected": {
              "error_text": "bad",
              "trace": [
                "caught",
                "finished"
              ]
            }
          },
          {
            "input": {
              "text": "🧠\u0000x"
            },
            "expected": {
              "error_text": "🧠\u0000x",
              "trace": [
                "caught",
                "finished"
              ]
            }
          }
        ],
        "acceptance_rules": [
          "Finalize exactly once on every path.",
          "Keep the typed error payload; catch-all text matching is not equivalent."
        ],
