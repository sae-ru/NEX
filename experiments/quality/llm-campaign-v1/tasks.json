    {
      "id": "recoverable-selection",
      "kind": "change",
      "contract": {
        "objective": "Add a recoverable None/negative branch to a selected-value doubling pipeline.",
        "domain": "choice is None or Some(n), n in [-1000,1000].",
        "neutral_interface": "double_selected(choice) -> success(signed64) | failure(code,message)",
        "visible_cases": [
          {
            "input": {
              "choice": {
                "Some": 21
              }
            },
            "expected": {
              "ok": 42
            }
          },
          {
            "input": {
              "choice": {
                "Some": 0
              }
            },
            "expected": {
              "ok": 0
            }
          },
          {
            "input": {
              "choice": {
                "Some": -1
              }
            },
            "expected": {
              "error": {
                "code": "NEGATIVE",
                "message": "negative"
              }
            }
          },
          {
            "input": {
              "choice": "None"
            },
            "expected": {
              "error": {
                "code": "EMPTY",
                "message": "empty"
              }
            }
          }
        ],
        "acceptance_rules": [
          "Propagate the selection error unchanged.",
          "Errors are returned values; they do not abort the process."
        ],
        "held_out_cases_status": "pending independent harness review"
      },
