      "contract": {
        "objective": "Parameterize a yielding child task and return its value only after joined completion.",
        "domain": "Input value is signed64 in [-1000,1000]; the task scope has one worker.",
        "neutral_interface": "joined_answer(value) -> {value,trace}",
        "visible_cases": [
