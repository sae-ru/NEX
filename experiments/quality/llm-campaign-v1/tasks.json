    {
      "id": "unicode-window",
      "kind": "change",
      "contract": {
        "objective": "Extend text windows to Unicode scalar indexing, including embedded NUL.",
        "domain": "Text is valid UTF-8 without unpaired surrogates; start and count select an in-bounds scalar interval.",
        "neutral_interface": "window(text,start,count) -> text",
        "visible_cases": [
          {
            "input": {
              "text": "A🌍\u0000é",
              "start": 1,
              "count": 2
            },
            "expected": "🌍\u0000"
          },
          {
            "input": {
              "text": "éZ",
              "start": 1,
              "count": 1
            },
            "expected": "́"
          },
          {
            "input": {
              "text": "🧠",
              "start": 0,
              "count": 1
            },
            "expected": "🧠"
          },
          {
            "input": {
              "text": "",
              "start": 0,
              "count": 0
            },
            "expected": ""
          }
        ],
        "acceptance_rules": [
          "A combining mark is one scalar, not part of a grapheme-level index.",
          "Neither byte indexing nor UTF-16 code-unit indexing is accepted."
        ],
        "held_out_cases_status": "pending independent harness review"
      },
