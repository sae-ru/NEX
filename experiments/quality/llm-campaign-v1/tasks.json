    {
      "id": "immutable-byte-update",
      "kind": "change",
      "contract": {
        "objective": "Change one octet while preserving the original byte sequence and strict UTF-8 decoding.",
        "domain": "Octets are in [0,255]; replacement index is in bounds.",
        "neutral_interface": "updated_copy(octets,index,value) -> {original,updated,decoded-or-error}",
        "visible_cases": [
          {
            "input": {
              "octets": [
                65,
                66
              ],
              "index": 0,
              "value": 67
            },
            "expected": {
              "original": [
                65,
                66
              ],
              "updated": [
                67,
                66
              ],
              "decoded": "CB"
            }
          },
          {
            "input": {
              "octets": [
                65,
                0,
                66
              ],
              "index": 0,
              "value": 67
            },
            "expected": {
              "original": [
                65,
                0,
                66
              ],
              "updated": [
                67,
                0,
                66
              ],
              "decoded": "C\u0000B"
            }
          },
          {
            "input": {
              "octets": [
                65
              ],
              "index": 0,
              "value": 255
            },
            "expected": {
              "original": [
                65
              ],
              "updated": [
                255
              ],
              "decode_error": "E_UTF8"
            }
          }
        ],
        "acceptance_rules": [
          "The input object remains unchanged after the call.",
          "Invalid UTF-8 is rejected rather than replaced or silently truncated."
        ],
        "held_out_cases_status": "pending independent harness review"
