      "id": "bounded-total",
      "kind": "change",
      "contract": {
        "objective": "Extend a running total to include zero and the upper bound without losing the loop contract.",
        "domain": "n is an integer in [0,100].",
        "neutral_interface": "total(n) -> signed64",
        "visible_cases": [
          {
            "input": {
              "n": 0
            },
            "expected": 0
          },
          {
            "input": {
              "n": 1
            },
            "expected": 1
          },
          {
            "input": {
              "n": 10
            },
            "expected": 55
          },
          {
            "input": {
              "n": 100
            },
            "expected": 5050
          }
        ],
        "acceptance_rules": [
          "Return the sum of integers 1 through n.",
          "Do not widen the declared input domain."
        ],
        "held_out_cases_status": "pending independent harness review"
