module opencl_compute;
import "std/compute.nex" as c;
server extern fn gpu_raw(a:bytes,b:bytes,scale:i64)->result<bytes> !{ffi}=foreign("rk_gpu","gpu_compute","@PIN@");
fn device_result(value:result<bytes>)->result<bytes>{
 if !is_ok(value){let code:str=error_code(value);if code=="E_DEVICE_UNAVAILABLE"{return err("E_COMPUTE_UNAVAILABLE",error_message(value));}return err(code,error_message(value));}return value;
}
// These operator-reviewed descriptors are data, not device execution attestations.
fn gpu_device()->c::Device{return @GPU_DEVICE@;}
server fn provider(request:c::Request,device:c::Device)->result<c::Response> !{ffi}{
 let job:c::Request=c::validate_request(request)?;
 if device.kind==c::Kind::GPU() && device.id==gpu_device().id{
  var scale:i64=1;match job.operation{c::Operation::Affine(value)=>{scale=value;},c::Operation::Add()=>{},_=>{return err("E_COMPUTE_UNSUPPORTED","this OpenCL provider supports u8 Add/Affine");}}
  let a:bytes=job.inputs[0].data;let b:bytes=job.inputs[1].data;
  let data:bytes=device_result(gpu_raw(a,b,scale))?;
  let output:c::Tensor=c::tensor(c::DType::U8(),job.inputs[0].shape,data)?;
  return ok(c::Response(1,job.id,output,device,false,""));
 }
 return err("E_COMPUTE_UNAVAILABLE","device is outside this reviewed context");
}
server fn devices()->c::Context{return unwrap(c::context([gpu_device()],provider));}
server fn gpu()->unit !{ffi}{
 let a:c::Tensor=unwrap(c::tensor(c::DType::U8(),[3],unwrap(bytes([1,20,50]))));let b:c::Tensor=unwrap(c::tensor(c::DType::U8(),[3],unwrap(bytes([2,3,4]))));
 let request:c::Request=c::request("gpu",c::Operation::Affine(3),[a,b],c::Selection(c::Kind::GPU(),""),c::Fallback::Deny());
 let actual:c::Response=unwrap(c::execute(devices(),request));assert(actual.output.data==unwrap(bytes([5,63,154])));assert(actual.device==gpu_device());assert(!actual.fallback_used);
}
fn repeated(value:i64,power:i64)->bytes{var data:bytes=unwrap(bytes([value]));var i:i64=0;while i<power{data=data+data;i=i+1;}return data;}
server fn gpu_value(a:bytes,b:bytes,operation:c::Operation)->c::Response !{ffi}{
 let x:c::Tensor=unwrap(c::tensor(c::DType::U8(),[len(a)],a));let y:c::Tensor=unwrap(c::tensor(c::DType::U8(),[len(b)],b));
 let job:c::Request=c::request("general-gpu",operation,[x,y],c::Selection(c::Kind::GPU(),gpu_device().id),c::Fallback::Deny());
 let actual:c::Response=unwrap(c::execute(devices(),job));assert(actual.device==gpu_device());assert(!actual.fallback_used);return actual;
}
server fn general_gpu()->unit !{ffi}{
 assert(gpu_value(unwrap(bytes([255,128,1,0])),unwrap(bytes([0,127,254,0])),c::Operation::Add()).output.data==unwrap(bytes([255,255,255,0])));
 assert(gpu_value(unwrap(bytes([255])),unwrap(bytes([255])),c::Operation::Affine(0)).output.data==unwrap(bytes([255])));
 assert(gpu_value(unwrap(bytes([1])),unwrap(bytes([0])),c::Operation::Affine(255)).output.data==unwrap(bytes([255])));
 assert(gpu_value(unwrap(bytes([2])),unwrap(bytes([1])),c::Operation::Affine(127)).output.data==unwrap(bytes([255])));
 let a:c::Tensor=unwrap(c::tensor(c::DType::U8(),[1],unwrap(bytes([1]))));
 let job:c::Request=c::request("GPU-overflow",c::Operation::Affine(255),[a,a],c::Selection(c::Kind::GPU(),""),c::Fallback::CPU());
 assert(error_code(c::execute(devices(),job))=="E_COMPUTE_OVERFLOW");
 let image:c::Tensor=unwrap(c::tensor(c::DType::U8(),[512,512],repeated(85,18)));
 let zero:c::Tensor=unwrap(c::tensor(c::DType::U8(),[512,512],repeated(0,18)));
 let big:c::Request=c::request("maximum-image",c::Operation::Affine(3),[image,zero],c::Selection(c::Kind::GPU(),""),c::Fallback::Deny());
 let actual:c::Response=unwrap(c::execute(devices(),big));assert(actual.output.shape==[512,512]);assert(actual.output.data==repeated(255,18));assert(actual.device.kind==c::Kind::GPU());assert(!actual.fallback_used);
 let wrong:c::Tensor=c::Tensor(c::DType::U8(),[1,1],a.data);
 assert(error_code(c::execute(devices(),c::request("bad-shape",c::Operation::Add(),[a,wrong],job.device,c::Fallback::CPU())))=="E_COMPUTE_SHAPE");
}
server fn fallbacks()->unit !{ffi}{
 let a:c::Tensor=unwrap(c::from_i8([2,3],[1,-2,3,4,0,-1]));let b:c::Tensor=unwrap(c::from_i8([3,2],[2,1,-1,3,4,-2]));
 let request:c::Request=c::request("unsupported",c::Operation::Matmul(),[a,b],c::Selection(c::Kind::GPU(),gpu_device().id),c::Fallback::Deny());
 assert(error_code(c::execute(devices(),request))=="E_COMPUTE_UNSUPPORTED");
 let fallback:c::Response=unwrap(c::execute(devices(),c::on(request,request.device,c::Fallback::CPU())));
 assert(fallback.device.kind==c::Kind::CPU());assert(fallback.fallback_used);assert(fallback.fallback_reason!="");assert(c::to_i32(fallback.output)==ok([16,-11,4,6]));
 assert(error_code(c::execute(devices(),c::on(request,c::Selection(c::Kind::GPU(),"missing"),c::Fallback::Deny())))=="E_COMPUTE_UNAVAILABLE");
}
server fn main()->unit !{ffi,io}{gpu();general_gpu();fallbacks();print("NEX COMMON OPENCL OK");}
server test fn gpu_case()->unit !{ffi}{gpu();}
server test fn general_gpu_case()->unit !{ffi}{general_gpu();}
server test fn fallback_cases()->unit !{ffi}{fallbacks();}
