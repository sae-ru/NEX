module rk_npu;
@API@
fn input(count:i64,stride:i64,offset:i64)->list<i64>{var v:list<i64>=[];var i:i64=0;while i<count{v=push(v,(i*stride+offset)%7-3);i=i+1;}return v;}
server fn one(m:i64,k:i64,n:i64)->unit !{ffi}{
 let a:list<i64>=input(m*k,3,0);let b:list<i64>=input(k*n,5,2);
 let c:list<i64>=unwrap(npu_matmul(a,b,m,k,n));assert(len(c)==m*n);
 var row:i64=0;while row<m{var col:i64=0;while col<n{var expected:i64=0;var j:i64=0;while j<k{expected=expected+a[row*k+j]*b[j*n+col];j=j+1;}assert(c[row*n+col]==expected);col=col+1;}row=row+1;}
}
server fn checks()->unit !{ffi}{
 one(4,64,32);one(8,32,32);one(4,32,64);
 assert(error_code(npu_matmul_bytes(unwrap(bytes([])),unwrap(bytes([])),0,32,32))=="E_SHAPE");
 assert(error_code(npu_matmul_bytes(unwrap(bytes([1])),unwrap(bytes([1])),4,64,32))=="E_INPUT_SIZE");
 assert(error_code(npu_matmul([],[],0,32,32))=="E_SHAPE");
 assert(error_code(npu_matmul([],[],1,16,32))=="E_SHAPE");
 assert(error_code(npu_matmul([1],[1],4,64,32))=="E_INPUT_SIZE");
 var a:list<i64>=input(32,3,0);let b:list<i64>=input(1024,5,2);
 a=set(a,0,128);assert(error_code(npu_matmul(a,b,1,32,32))=="E_INPUT_RANGE");
 a=set(a,0,-129);assert(error_code(npu_matmul(a,b,1,32,32))=="E_INPUT_RANGE");
}
server fn main()->unit !{ffi,io}{checks();print("NEX RK3588 NPU OK");}
server test fn npu_test()->unit !{ffi}{checks();}
