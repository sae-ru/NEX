server extern fn npu_matmul_bytes(a:bytes,b:bytes,m:i64,k:i64,n:i64)->result<bytes> !{ffi}=foreign("rk_npu","npu_matmul_bytes","@PIN@");
fn pack_int8(values:list<i64>)->result<bytes>{
 let count:i64=len(values);var octets:list<i64>=[];var i:i64=0;while i<count{let v:i64=values[i];if v< -128 || v>127{return err("E_INPUT_RANGE","int8 input outside -128..127");}octets=push(octets,(v+256)%256);i=i+1;}return bytes(octets);
}
server fn npu_matmul(a:list<i64>,b:list<i64>,m:i64,k:i64,n:i64)->result<list<i64>> !{ffi}{
 if m<1 || m>32 || k<32 || k>128 || k%32!=0 || n<32 || n>128 || n%32!=0{return err("E_SHAPE","matmul requires bounded M/K/N");}
 if len(a)!=m*k || len(b)!=k*n{return err("E_INPUT_SIZE","row-major input length disagrees with shape");}
 let data:bytes=npu_matmul_bytes(pack_int8(a)?,pack_int8(b)?,m,k,n)?;
 if len(data)!=m*n*4{return err("E_PROTOCOL","wrong int32 output byte size");}
 let elements:i64=m*n;var result:list<i64>=[];var i:i64=0;while i<elements{
  let offset:i64=4*i;var value:i64=data[offset]+data[offset+1]*256+data[offset+2]*65536+data[offset+3]*16777216;
  if value>=2147483648{value=value-4294967296;}
  result=push(result,value);i=i+1;
 }return ok(result);
}
