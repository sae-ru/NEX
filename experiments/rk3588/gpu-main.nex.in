module rk_gpu;
server extern fn gpu_compute(a:bytes,b:bytes,scale:i64)->result<bytes> !{ffi}=foreign("rk_gpu","gpu_compute","@PIN@");
fn input(n:i64,seed:i64,range:i64)->bytes{var v:list<i64>=[];var i:i64=0;while i<n{v=push(v,(i+seed)%range);i=i+1;}return unwrap(bytes(v));}
server fn one(seed:i64)->unit !{ffi}{let a:bytes=input(1024,seed,51);let b:bytes=input(1024,seed+7,21);let c:bytes=unwrap(gpu_compute(a,b,3));assert(len(c)==1024);var i:i64=0;while i<1024{assert(c[i]==a[i]*3+b[i]);i=i+1;}}
server fn checks()->unit !{ffi}{one(0);one(17);one(997);assert(error_code(gpu_compute(unwrap(bytes([1,2])),unwrap(bytes([1])),3))=="E_INPUT_SIZE");assert(unwrap(gpu_compute(unwrap(bytes([255,200])),unwrap(bytes([0,20])),1))==unwrap(bytes([255,220])));
assert(unwrap(gpu_compute(unwrap(bytes([255])),unwrap(bytes([255])),0))==unwrap(bytes([255])));
assert(unwrap(gpu_compute(unwrap(bytes([1])),unwrap(bytes([0])),255))==unwrap(bytes([255])));
assert(unwrap(gpu_compute(unwrap(bytes([2])),unwrap(bytes([1])),127))==unwrap(bytes([255])));
assert(unwrap(gpu_compute(unwrap(bytes([1])),unwrap(bytes([127])),128))==unwrap(bytes([255])));
assert(error_code(gpu_compute(unwrap(bytes([1])),unwrap(bytes([1])),255))=="E_COMPUTE_OVERFLOW");
assert(error_code(gpu_compute(unwrap(bytes([1])),unwrap(bytes([1])),-1))=="E_COMPUTE_RANGE");
assert(error_code(gpu_compute(unwrap(bytes([1])),unwrap(bytes([1])),256))=="E_COMPUTE_RANGE");}
server fn main()->unit !{ffi,io}{checks();print("NEX RK3588 GPU OK");}
server test fn gpu_test()->unit !{ffi}{checks();}
