module owned_cuda_codegen;
import "std/compute.nex" as c;
import "std/device.nex" as d;
server resource ReadCursor;
// A fault carries values, while only the completed alternative owns a buffer.
enum Dispatch{Complete(buffer:d::Buffer);SourceFault(code:str,message:str);}
enum Outcome{Data(value:bytes);SourceFault(code:str,message:str);HostFault(code:str,message:str);}
server extern fn open_raw(index:i64)->result<d::Session> !{ffi}=foreign("gpu","open","@PIN@");
server extern fn upload_raw(session:d::Session,dtype:i64,data:bytes)->result<d::Buffer> !{ffi}=foreign("gpu","upload","@PIN@");
server extern fn map_raw(session:d::Session,columns:list<d::Buffer>,count:i64,steps:i64)->result<Dispatch> !{ffi}=foreign("gpu","map","@PIN@");
server extern fn download_raw(buffer:d::Buffer)->result<ReadCursor> !{ffi}=foreign("gpu","download","@PIN@");
server extern fn read_next_raw(cursor:ReadCursor)->result<bytes> !{ffi}=foreign("gpu","read_next","@PIN@");
server extern fn name_raw(session:d::Session)->str !{ffi}=foreign("gpu","name","@PIN@");
server extern fn kernel_ns_raw(buffer:d::Buffer)->i64 !{ffi}=foreign("gpu","kernel_ns","@PIN@");
server extern fn busy_raw(session:d::Session)->i64 !{ffi}=foreign("gpu","busy","@PIN@");
server extern fn fatal_raw(code:str,message:str)->unit !{ffi}=foreign("gpu","fatal","@PIN@");
server extern fn encode_f64_raw(values:list<f64>,offset:i64,count:i64)->result<bytes> !{ffi}=foreign("gpu","encode_f64","@PIN@");
server extern fn decode_f64_raw(data:bytes,offset:i64,count:i64)->result<list<f64>> !{ffi}=foreign("gpu","decode_f64","@PIN@");

fn kernel_argument_count()->i64{return @ARGUMENTS@;}
fn kernel_source_hash()->str{return "@ROOT_HASH@";}
fn kernel_argument_words(index:i64)->i64{@ARGUMENT_WORDS@}
fn kernel_output_words()->i64{return @OUTPUT_WORDS@;}
fn kernel_batch_lanes()->i64{return @BATCH_LANES@;}
fn kernel_all_f64()->bool{return @F64_INTERFACE@;}
server fn make_context()->result<d::Session> !{task,ffi}{return open_raw(@INDEX@);}
server fn close_columns(columns:list<d::Buffer>)->unit !{task,ffi}{var i:i64=0;while i<len(columns){resource_close(columns[i]);i=i+1;}}
server fn read_buffer(buffer:d::Buffer)->result<bytes> !{task,ffi}{
 if !resource_is_open(buffer){return err("E_DEVICE_CLOSED","device buffer is closed");}
 let cursor:ReadCursor=download_raw(buffer)?;var output:bytes=unwrap(bytes([]));var done:bool=false;
 while !done{
  let read:result<bytes>=read_next_raw(cursor);
  if !is_ok(read){resource_close(cursor);return err(error_code(read),error_message(read));}
  let chunk:bytes=read?;
  if len(chunk)>262144 || len(output)>262144-len(chunk){resource_close(cursor);return err("E_GPU_RESPONSE","generated output exceeded its bound");}
  output=output+chunk;done=len(chunk)<262144;
 }
 resource_close(cursor);return ok(output);
}
server fn execute_batch(session:d::Session,columns:list<bytes>,count:i64,steps:i64)->Outcome !{task,ffi}{
 if count<1 || count>32768 || steps<1 || steps>65536{return Outcome::HostFault("E_GPU_INPUT","generated kernel geometry exceeds bounds");}
 if count*steps>16777216 || len(columns)!=kernel_argument_count(){return Outcome::HostFault("E_GPU_INPUT","generated kernel shape or work bound differs");}
 if !resource_is_open(session){return Outcome::HostFault("E_DEVICE_CLOSED","GPU session is closed");}
 var i:i64=0;while i<len(columns){if len(columns[i])!=count*8*kernel_argument_words(i){return Outcome::HostFault("E_GPU_INPUT","column bytes differ from count");}i=i+1;}
 var buffers:list<d::Buffer>=[];i=0;
 while i<len(columns){
  let uploaded:result<d::Buffer>=upload_raw(session,1,columns[i]);
  if !is_ok(uploaded){close_columns(buffers);return Outcome::HostFault(error_code(uploaded),error_message(uploaded));}
  buffers=buffers+[unwrap(uploaded)];i=i+1;
 }
 let dispatched:result<Dispatch>=map_raw(session,buffers,count,steps);close_columns(buffers);
 if !is_ok(dispatched){return Outcome::HostFault(error_code(dispatched),error_message(dispatched));}
 match unwrap(dispatched){
  Dispatch::SourceFault(code,message)=>{return Outcome::SourceFault(code,message);},
  Dispatch::Complete(buffer)=>{
   let read:result<bytes>=read_buffer(buffer);resource_close(buffer);
   if !is_ok(read){return Outcome::HostFault(error_code(read),error_message(read));}
   return Outcome::Data(unwrap(read));
  }
 }
}
fn outcome_result(value:Outcome)->result<bytes>{return match value{
 Outcome::Data(data)=>ok(data),
 Outcome::SourceFault(code,message)=>err<bytes>("E_RESULT",code+": "+message),
 Outcome::HostFault(code,message)=>err<bytes>(code,message)
};}
server fn try_apply_batch(session:d::Session,columns:list<bytes>,count:i64,steps:i64)->result<bytes> !{task,ffi}{return outcome_result(execute_batch(session,columns,count,steps));}
// Each physical batch settles and closes its resources before any outcome
// leaves this frame. Source faults preserve their two strings across batching.
server fn execute(session:d::Session,columns:list<bytes>,count:i64,steps:i64)->Outcome !{task,ffi}{
 if count<1 || count>32768 || steps<1 || steps>65536 || len(columns)!=kernel_argument_count(){return Outcome::HostFault("E_GPU_INPUT","generated kernel geometry differs");}
 if count*steps>16777216{return Outcome::HostFault("E_GPU_INPUT","generated work exceeds bounds");}
 var i:i64=0;while i<len(columns){if len(columns[i])!=count*8*kernel_argument_words(i){return Outcome::HostFault("E_GPU_INPUT","fixed value column byte count differs");}i=i+1;}
 var output:bytes=unwrap(bytes([]));var offset:i64=0;
 while offset<count{
  var lanes:i64=count-offset;if lanes>kernel_batch_lanes(){lanes=kernel_batch_lanes();}
  var chunks:list<bytes>=[];i=0;
  while i<len(columns){let width:i64=8*kernel_argument_words(i);chunks=chunks+[slice(columns[i],offset*width,lanes*width)];i=i+1;}
  let outcome:Outcome=execute_batch(session,chunks,lanes,steps);
  match outcome{
   Outcome::Data(part)=>{
    if len(part)!=lanes*8*kernel_output_words(){return Outcome::HostFault("E_GPU_RESPONSE","fixed value output byte count differs");}
    output=output+part;
   },
   Outcome::SourceFault(_,_)=>{return outcome;},
   Outcome::HostFault(_,_)=>{return outcome;}
  }
  offset=offset+lanes;
 }
 return Outcome::Data(output);
}
server fn try_apply(session:d::Session,columns:list<bytes>,count:i64,steps:i64)->result<bytes> !{task,ffi}{return outcome_result(execute(session,columns,count,steps));}
server fn apply(session:d::Session,columns:list<bytes>,count:i64,steps:i64)->bytes !{task,ffi}{
 match execute(session,columns,count,steps){
  Outcome::Data(data)=>{return data;},
  Outcome::SourceFault(code,message)=>{return unwrap(err<bytes>(code,message));},
  Outcome::HostFault(code,message)=>{fatal_raw(code,message);return unwrap(err<bytes>(code,message));}
 }
}

fn encode_i64s(values:list<i64>)->bytes{
 var output:bytes=unwrap(bytes([]));var i:i64=0;
 while i<len(values){var value:i64=values[i];var j:i64=0;while j<8{var octet:i64=value%256;if octet<0{octet=octet+256;}output=output+unwrap(bytes([octet]));value=(value-octet)/256;j=j+1;}i=i+1;}
 return output;
}
fn decode_i64s(value:bytes)->list<i64>{
 assert(len(value)%8==0);var output:list<i64>=[];var offset:i64=0;
 while offset<len(value){var top:i64=value[offset+7];if top>=128{top=top-256;}var scalar:i64=top;var j:i64=7;while j>0{j=j-1;scalar=scalar*256+value[offset+j];}output=output+[scalar];offset=offset+8;}
 return output;
}
server fn encode_f64s(values:list<f64>)->result<bytes> !{task,ffi}{
 if len(values)>32768{return err("E_GPU_INPUT","f64 column exceeds32768 values");}
 var output:bytes=unwrap(bytes([]));var offset:i64=0;
 while offset<len(values){var count:i64=len(values)-offset;if count>1024{count=1024;}var chunk:list<f64>=[];var i:i64=0;while i<count{chunk=chunk+[values[offset+i]];i=i+1;}output=output+encode_f64_raw(chunk,0,count)?;offset=offset+count;}
 return ok(output);
}
server fn decode_f64s(data:bytes)->result<list<f64>> !{task,ffi}{
 if len(data)>262144 || len(data)%8!=0{return err("E_GPU_INPUT","f64 column byte shape differs");}
 var output:list<f64>=[];var offset:i64=0;let length:i64=len(data)/8;
 while offset<length{var count:i64=length-offset;if count>1024{count=1024;}let chunk:bytes=slice(data,offset*8,count*8);output=output+decode_f64_raw(chunk,0,count)?;offset=offset+count;}
 return ok(output);
}
server fn encoded_columns(columns:list<list<f64>>,count:i64,steps:i64)->result<list<bytes>> !{task,ffi}{
 if !kernel_all_f64(){return err("E_GPU_INPUT","selected scalar function is not all-f64");}
 if count<1 || count>32768 || steps<1 || steps>65536 || len(columns)!=kernel_argument_count(){return err("E_GPU_INPUT","f64 kernel geometry differs");}
 if count*steps>16777216{return err("E_GPU_INPUT","f64 work exceeds bounds");}
 var encoded:list<bytes>=[];var i:i64=0;
 while i<len(columns){if len(columns[i])!=count{return err("E_GPU_INPUT","f64 column length differs");}encoded=encoded+[encode_f64s(columns[i])?];i=i+1;}
 return ok(encoded);
}
server fn try_apply_f64(session:d::Session,columns:list<list<f64>>,count:i64,steps:i64)->result<list<f64>> !{task,ffi}{
 let encoded:list<bytes>=encoded_columns(columns,count,steps)?;
 let data:bytes=try_apply(session,encoded,count,steps)?;let values:list<f64>=decode_f64s(data)?;
 if len(values)!=count{return err("E_GPU_RESPONSE","f64 output count differs");}return ok(values);
}
server fn apply_f64(session:d::Session,columns:list<list<f64>>,count:i64,steps:i64)->list<f64> !{task,ffi}{
 let encoded:result<list<bytes>>=encoded_columns(columns,count,steps);
 if !is_ok(encoded){fatal_raw(error_code(encoded),error_message(encoded));}
 let data:bytes=apply(session,unwrap(encoded),count,steps);
 let result:result<list<f64>>=decode_f64s(data);
 if !is_ok(result){fatal_raw(error_code(result),error_message(result));}
 let values:list<f64>=unwrap(result);
 if len(values)!=count{fatal_raw("E_GPU_RESPONSE","f64 output count differs");}
 return values;
}
client fn client_value()->i64{return 42;}
server fn main()->unit !{task,ffi,io}{let session:d::Session=unwrap(make_context());resource_close(session);print(42);}
