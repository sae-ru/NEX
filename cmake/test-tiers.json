    "sdk": "Installed delivery, package/archive/provider preparation and notices.",
    "scale": "Stress/workload coverage or an existing declared wall budget of at least900 seconds; a budget is not measured duration."
  },
  "core_requirements": [
    "configured compiler and its shared dependencies",
    "Python3.10+",
    "nex_core_tests build target"
  ],
