module std::hash_set;
import "./hash_map.nex" as tables;

pub struct Set<T> { table: tables::Map<T, bool>; }
pub fn empty<T>(hash: fn(T) -> i64, equal: fn(T, T) -> bool) -> Set<T> { return Set(tables::empty(hash, equal)); }
pub fn add<T>(set: Set<T>, value: T) -> Set<T> { return Set(tables::put(set.table, value, true)); }
pub fn remove<T>(set: Set<T>, value: T) -> Set<T> { return Set(tables::remove(set.table, value)); }
pub fn has<T>(set: Set<T>, value: T) -> bool { return tables::has(set.table, value); }
pub fn items<T>(set: Set<T>) -> list<T> { return tables::keys(set.table); }
pub fn size<T>(set: Set<T>) -> i64 { return tables::size(set.table); }
pub fn is_empty<T>(set: Set<T>) -> bool { return tables::is_empty(set.table); }
pub fn height<T>(set: Set<T>) -> i64 { return tables::height(set.table); }
pub fn validate<T>(set: Set<T>) -> bool { return tables::validate(set.table); }
pub fn union<T>(left: Set<T>, right: Set<T>) -> Set<T> {
  var output: Set<T> = left;
  let values: list<T> = items(right);
  var index: i64 = 0;
  while index < len(values) { output = add(output, values[index]); index = index + 1; }
  return output;
}
pub fn intersection<T>(left: Set<T>, right: Set<T>) -> Set<T> {
  let normalized: Set<T> = union(empty(left.table.hash, left.table.equal), right);
  var output: Set<T> = empty(left.table.hash, left.table.equal);
  let values: list<T> = items(left);
  var index: i64 = 0;
  while index < len(values) { if has(normalized, values[index]) { output = add(output, values[index]); } index = index + 1; }
  return output;
}
pub fn difference<T>(left: Set<T>, right: Set<T>) -> Set<T> {
  let normalized: Set<T> = union(empty(left.table.hash, left.table.equal), right);
  var output: Set<T> = empty(left.table.hash, left.table.equal);
  let values: list<T> = items(left);
  var index: i64 = 0;
  while index < len(values) { if !has(normalized, values[index]) { output = add(output, values[index]); } index = index + 1; }
  return output;
}
