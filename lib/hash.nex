module std::hash;

// Stable source hashes for bucket selection; ordinary checked arithmetic stays
// unchanged. text/binary use a polynomial over bytes modulo2^32.
pub fn integer(value: i64) -> i64 { return value; }
pub fn boolean(value: bool) -> i64 { if value { return 1; } return 0; }
pub fn binary(value: bytes) -> i64 {
  var result: i64 = 0;
  var index: i64 = 0;
  while index < len(value) {
    result = (result * 257 + value[index] + 1) % 4294967296;
    index = index + 1;
  }
  return result;
}
pub fn text(value: str) -> i64 { return binary(utf8_bytes(value)); }
pub fn equal<T>(left: T, right: T) -> bool { return left == right; }
