module std::model;
import "std/compute.nex" as c;

// Checked immutable model contract. Context is not an owned resource or host grant.
pub enum DType { F32(); U8(); I8(); I32(); }
pub struct Port { name:str; dtype:DType; shape:list<i64>; }
pub struct Tensor { name:str; dtype:DType; shape:list<i64>; data:bytes; }
pub enum Precision { MatchCPU(); Vendor(); }
pub struct Model { id:str; sha256:str; precision:Precision; inputs:list<Port>; outputs:list<Port>; }
pub struct Device { kind:c::Kind; id:str; provider:str; version:str; provenance:str; models:list<Model>; }
pub struct Request { version:i64; id:str; model:Model; inputs:list<Tensor>; device:c::Selection; fallback:c::Fallback; }
pub struct Response { version:i64; id:str; model_sha256:str; precision:Precision; outputs:list<Tensor>; device:Device; fallback_used:bool; fallback_reason:str; }
pub struct Context { devices:list<Device>; invoke:server fn(Request,Device)->result<Response> !{ffi}; }

fn identifier(value:str,limit:i64)->bool {
 if len(value)<1 || len(value)>limit{return false;}
 let data:bytes=utf8_bytes(value);var i:i64=0;
 while i<len(data){if data[i]==0{return false;}i=i+1;}return true;
}
pub fn is_sha256(value:str)->bool {
 let data:bytes=utf8_bytes(value);if len(data)!=64{return false;}
 var i:i64=0;while i<64{let v:i64=data[i];if !(v>=48 && v<=57) && !(v>=97 && v<=102){return false;}i=i+1;}return true;
}
pub fn width(dtype:DType)->i64{return match dtype{DType::F32()=>4,DType::U8()=>1,DType::I8()=>1,DType::I32()=>4};}
pub fn elements(shape:list<i64>)->result<i64>{
 if len(shape)<1 || len(shape)>4{return err("E_MODEL_SHAPE","tensor rank must be1..4");}
 var n:i64=1;var i:i64=0;while i<len(shape){let d:i64=shape[i];if d<1 || d>262144 || n>262144/d{return err("E_MODEL_LIMIT","tensor exceeds262144 elements");}n=n*d;i=i+1;}return ok(n);
}
pub fn size(port:Port)->result<i64>{
 if !identifier(port.name,128){return err("E_MODEL_PORT","invalid tensor port name");}
 let n:i64=elements(port.shape)?;return ok(n*width(port.dtype));
}
pub fn validate_tensor(value:Tensor)->result<Tensor>{
 let n:i64=size(Port(value.name,value.dtype,value.shape))?;
 if len(value.data)!=n{return err("E_MODEL_SIZE","tensor bytes disagree with dtype and shape");}
 if value.dtype==DType::F32(){
  var i:i64=0;while i<n{if (value.data[i+3]%128)*2+value.data[i+2]/128==255{return err("E_MODEL_NONFINITE","model f32 payload must be finite IEEE754 binary32 little-endian");}i=i+4;}
 }
 return ok(value);
}
pub fn tensor(name:str,dtype:DType,shape:list<i64>,data:bytes)->result<Tensor>{return validate_tensor(Tensor(name,dtype,shape,data));}
fn port_bytes(values:list<Port>)->result<i64>{
 if len(values)<1 || len(values)>16{return err("E_MODEL_PORT","model needs1..16 named ports per direction");}
 var total:i64=0;var i:i64=0;while i<len(values){let n:i64=size(values[i])?;if n>786432-total{return err("E_MODEL_LIMIT","model bulk IO exceeds786432 bytes");}total=total+n;var j:i64=0;while j<i{if values[j].name==values[i].name{return err("E_MODEL_PORT","duplicate tensor port name");}j=j+1;}i=i+1;}return ok(total);
}
pub fn validate_model(value:Model)->result<Model>{
 if !identifier(value.id,128) || !is_sha256(value.sha256){return err("E_MODEL_ID","model needs a bounded identity and lowercase SHA256");}
 let a:i64=port_bytes(value.inputs)?;let b:i64=port_bytes(value.outputs)?;
 if a>786432-b{return err("E_MODEL_LIMIT","combined input/output exceeds786432 bytes");}
 return ok(value);
}
fn match_tensors(ports:list<Port>,values:list<Tensor>)->result<bool>{
 if len(ports)!=len(values){return err("E_MODEL_PORT","tensor count disagrees with model ports");}
 var i:i64=0;while i<len(values){let t:Tensor=validate_tensor(values[i])?;let p:Port=ports[i];if t.name!=p.name || t.dtype!=p.dtype || t.shape!=p.shape{return err("E_MODEL_PORT","tensor order/name/dtype/shape disagrees with model");}i=i+1;}return ok(true);
}
pub fn request(id:str,model:Model,inputs:list<Tensor>,device:c::Selection,fallback:c::Fallback)->Request{return Request(1,id,model,inputs,device,fallback);}
pub fn on(value:Request,device:c::Selection,fallback:c::Fallback)->Request{return Request(value.version,value.id,value.model,value.inputs,device,fallback);}
pub fn validate_request(value:Request)->result<Request>{
 if value.version!=1{return err("E_MODEL_VERSION","unsupported model contract version");}
 if !identifier(value.id,128) || (value.device.id!="" && !identifier(value.device.id,256)){return err("E_MODEL_ID","invalid request/device identity");}
 let model:Model=validate_model(value.model)?;match_tensors(model.inputs,value.inputs)?;return ok(value);
}
pub fn validate_device(value:Device)->result<Device>{
 if !identifier(value.id,256) || !identifier(value.provider,128) || !identifier(value.version,128) || !identifier(value.provenance,4096) || len(value.models)<1 || len(value.models)>16{return err("E_MODEL_DEVICE","invalid device descriptor");}
 var i:i64=0;while i<len(value.models){let model:Model=validate_model(value.models[i])?;var j:i64=0;while j<i{if value.models[j].sha256==model.sha256 && value.models[j].precision==model.precision{return err("E_MODEL_DEVICE","duplicate supported model");}j=j+1;}i=i+1;}return ok(value);
}
pub server fn context(devices:list<Device>,invoke:server fn(Request,Device)->result<Response> !{ffi})->result<Context>{
 if len(devices)>16{return err("E_MODEL_LIMIT","context exceeds16 devices");}
 var i:i64=0;while i<len(devices){let device:Device=validate_device(devices[i])?;var j:i64=0;while j<i{if devices[j].id==device.id{return err("E_MODEL_DEVICE","duplicate device identity");}j=j+1;}i=i+1;}return ok(Context(devices,invoke));
}
fn capable(device:Device,model:Model)->bool{var i:i64=0;while i<len(device.models){if device.models[i]==model{return true;}i=i+1;}return false;}
fn select(ctx:Context,value:Request)->result<Device>{
 var found:bool=false;var i:i64=0;
 while i<len(ctx.devices){let d:Device=ctx.devices[i];if d.kind==value.device.kind && (value.device.id=="" || value.device.id==d.id){found=true;if capable(d,value.model){return ok(d);}if value.device.id!=""{return err("E_MODEL_UNSUPPORTED","selected device has no binding for this model");}}i=i+1;}
 if found{return err("E_MODEL_UNSUPPORTED","available devices have no binding for this model");}return err("E_MODEL_UNAVAILABLE","requested model device is unavailable");
}
pub fn validate_response(request:Request,device:Device,value:Response)->result<Response>{
 let job:Request=validate_request(request)?;let d:Device=validate_device(device)?;
 if d.kind!=job.device.kind || (job.device.id!="" && d.id!=job.device.id) || !capable(d,job.model) || value.version!=1 || value.id!=job.id || value.model_sha256!=job.model.sha256 || value.precision!=job.model.precision || value.device!=d || value.fallback_used || value.fallback_reason!=""{return err("E_MODEL_RESPONSE","provider changed correlation, model, placement or fallback");}
 let valid:result<bool>=match_tensors(job.model.outputs,value.outputs);if !is_ok(valid){return err("E_MODEL_RESPONSE","provider output violates declared model ports or finite tensor contract");}return ok(value);
}
server fn invoke(ctx:Context,value:Request,device:Device)->result<Response> !{ffi}{return validate_response(value,device,ctx.invoke(value,device)?);}
server fn cpu_fallback(ctx:Context,value:Request,code:str,message:str)->result<Response> !{ffi}{
 if value.fallback!=c::Fallback::CPU() || value.device.kind==c::Kind::CPU(){return err(code,message);}
 let job:Request=on(value,c::Selection(c::Kind::CPU(),""),c::Fallback::Deny());
 let d:Device=select(ctx,job)?;let out:Response=invoke(ctx,job,d)?;
 return ok(Response(out.version,out.id,out.model_sha256,out.precision,out.outputs,out.device,true,code+": "+message));
}
pub server fn execute(ctx:Context,request:Request)->result<Response> !{ffi}{
 let value:Request=validate_request(request)?;let checked:Context=context(ctx.devices,ctx.invoke)?;
 let selected:result<Device>=select(checked,value);
 if !is_ok(selected){return cpu_fallback(checked,value,error_code(selected),error_message(selected));}
 let response:result<Response>=invoke(checked,value,selected?);
 if !is_ok(response){let code:str=error_code(response);if code=="E_MODEL_UNAVAILABLE" || code=="E_MODEL_UNSUPPORTED"{return cpu_fallback(checked,value,code,error_message(response));}return err(code,error_message(response));}
 return response;
}

// Explicit helper for exactly representable integers, without f64 narrowing.
pub fn from_exact_i32(name:str,shape:list<i64>,values:list<i64>)->result<Tensor>{
 let n:i64=elements(shape)?;if len(values)!=n{return err("E_MODEL_SIZE","integer count disagrees with shape");}
 var data:list<i64>=[];var i:i64=0;
 while i<n{let v:i64=values[i];if v< -16777216 || v>16777216{return err("E_MODEL_PRECISION","integer is outside exact binary32 helper range");}
  var x:i64=v;var sign:i64=0;if x<0{x= -x;sign=2147483648;}
  var bits:i64=0;if x!=0{var power:i64=1;var e:i64=0;while power<=x/2{power=power*2;e=e+1;}var fraction:i64=x-power;var j:i64=e;while j<23{fraction=fraction*2;j=j+1;}bits=sign+(e+127)*8388608+fraction;}
  var j:i64=0;while j<4{data=push(data,bits%256);bits=bits/256;j=j+1;}i=i+1;
 }
 return tensor(name,DType::F32(),shape,bytes(data)?);
}
pub fn to_exact_i32(value:Tensor)->result<list<i64>>{
 let t:Tensor=validate_tensor(value)?;if t.dtype!=DType::F32(){return err("E_MODEL_DTYPE","exact integer helper requires binary32 tensor");}
 var out:list<i64>=[];var i:i64=0;while i<len(t.data){let bits:i64=t.data[i]+t.data[i+1]*256+t.data[i+2]*65536+t.data[i+3]*16777216;let sign:bool=bits>=2147483648;let exp:i64=(bits/8388608)%256;let fraction:i64=bits%8388608;
  var x:i64=0;if exp!=0 || fraction!=0{let e:i64=exp-127;if e<0 || e>24{return err("E_MODEL_PRECISION","binary32 output is outside exact integer helper range");}var mantissa:i64=8388608+fraction;var j:i64=e;if e<=23{var divisor:i64=1;while j<23{divisor=divisor*2;j=j+1;}if mantissa%divisor!=0{return err("E_MODEL_PRECISION","binary32 value is not an integer");}x=mantissa/divisor;}else{x=mantissa*2;}if x>16777216{return err("E_MODEL_PRECISION","binary32 output is outside exact integer helper range");}}
  if sign{x= -x;}out=push(out,x);i=i+4;
 }return ok(out);
}
