module std::net;
import "./web.nex" as web;

// Pure command values. Only the browser adapter performs the described effects.
pub struct Command {
  kind: str;
  id: str;
  method: str;
  path: str;
  body: str;
  token: str;
  action: str;
  timeout_ms: i64;
}
pub struct Response { id: str; status: i64; body: result<str>; }
pub struct TypedPayload { body: str; schema: str; }

pub fn request(id: str, method: str, path: str, body: str, token: str, action: str, timeout_ms: i64) -> Command {
  return Command("request", id, method, path, body, token, action, timeout_ms);
}
pub fn typed_request(id: str, method: str, path: str, body: str, token: str, action: str, timeout_ms: i64, schema: str) -> Command {
  return Command("typed_request", id, method, path, encode_json(TypedPayload(body, schema)), token, action, timeout_ms);
}
pub fn cancel(id: str) -> Command { return Command("cancel", id, "", "", "", "", "", 0); }
pub fn cancel_all() -> Command { return Command("cancel_all", "", "", "", "", "", "", 0); }
pub fn response(event: web::Event) -> result<Response> { return decode_json<Response>(event.value); }

test fn response_values_test() -> unit {
  let value: Response = Response("1", 200, ok("[]"));
  assert(unwrap(decode_json<Response>(encode_json(value))) == value);
  let failure: Response = Response("2", 0, err("E_NETWORK", "Request failed"));
  assert(error_code(unwrap(decode_json<Response>(encode_json(failure))).body) == "E_NETWORK");
}
