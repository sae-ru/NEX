module std::device;
import "./compute.nex" as c;

pub server resource Session;
pub server resource Buffer;
pub struct Tensor { dtype:c::DType; shape:list<i64>; buffer:Buffer; device_id:str; download:server fn(Buffer)->result<bytes> !{task,ffi}; }
pub struct Context {
 session:Session; device:c::Device;
 upload:server fn(Session,c::DType,bytes)->result<Buffer> !{task,ffi};
 dispatch:server fn(Session,c::Operation,list<Tensor>)->result<Buffer> !{task,ffi};
 download:server fn(Buffer)->result<bytes> !{task,ffi};
}

pub server fn context(session:Session,device:c::Device,
 upload:server fn(Session,c::DType,bytes)->result<Buffer> !{task,ffi},
 dispatch:server fn(Session,c::Operation,list<Tensor>)->result<Buffer> !{task,ffi},
 download:server fn(Buffer)->result<bytes> !{task,ffi})->result<Context>{
 let checked:c::Device=c::validate_device(device)?;
 if checked.kind==c::Kind::CPU() || checked.id=="cpu"{return err("E_COMPUTE_DEVICE","owned context requires an external GPU/NPU device");}
 return ok(Context(session,checked,upload,dispatch,download));
}
pub fn byte_count(dtype:c::DType,shape:list<i64>)->result<i64>{
 let count:i64=c::elements(shape)?;let width:i64=c::width(dtype);
 if count>1048576/width{return err("E_COMPUTE_LIMIT","owned tensor byte limit exceeded");}
 return ok(count*width);
}
server fn output_shape(op:c::Operation,a:Tensor,b:Tensor)->list<i64>{return match op{c::Operation::Matmul()=>[a.shape[0],b.shape[1]],_=>a.shape};}
fn output_dtype(op:c::Operation)->c::DType{return match op{c::Operation::Matmul()=>c::DType::I32(),_=>c::DType::U8()};}
server fn validate_inputs(op:c::Operation,inputs:list<Tensor>,device:str)->result<bool>{
 if len(inputs)!=2{return err("E_COMPUTE_INPUTS","owned dispatch requires two tensors");}
 let a:Tensor=inputs[0];let b:Tensor=inputs[1];
 let an:i64=byte_count(a.dtype,a.shape)?;let bn:i64=byte_count(b.dtype,b.shape)?;
 if a.device_id!=device || b.device_id!=device{return err("E_COMPUTE_DEVICE","tensor belongs to another configured device");}
 match op{
  c::Operation::Matmul()=>{
   if a.dtype!=c::DType::I8() || b.dtype!=c::DType::I8(){return err("E_COMPUTE_DTYPE","matmul requires signed int8 inputs");}
   if len(a.shape)!=2 || len(b.shape)!=2 || a.shape[1]!=b.shape[0]{return err("E_COMPUTE_SHAPE","matmul requires compatible rank2 tensors");}
   let size:i64=byte_count(c::DType::I32(),[a.shape[0],b.shape[1]])?;
  },
  _=>{
   if a.dtype!=c::DType::U8() || b.dtype!=c::DType::U8(){return err("E_COMPUTE_DTYPE","elementwise operations require u8 inputs");}
   if a.shape!=b.shape{return err("E_COMPUTE_SHAPE","owned elementwise shapes must agree");}
   match op{c::Operation::Affine(scale)=>{if scale<0 || scale>255{return err("E_COMPUTE_RANGE","affine scale must be0..255");}},_=>{}}
  }
 }
 return ok(true);
}
fn capable(device:c::Device,op:c::Operation,input:c::DType)->bool{
 let wanted:c::Capability=c::Capability(c::operation_kind(op),input,output_dtype(op));
 var i:i64=0;while i<len(device.capabilities){if device.capabilities[i]==wanted{return true;}i=i+1;}return false;
}
pub server fn upload(ctx:Context,value:c::Tensor)->result<Tensor> !{task,ffi}{
 let checked:Context=context(ctx.session,ctx.device,ctx.upload,ctx.dispatch,ctx.download)?;
 let input:c::Tensor=c::validate_tensor(value)?;
 if !resource_is_open(checked.session){return err("E_DEVICE_CLOSED","device session is closed");}
 let owner:Buffer=checked.upload(checked.session,input.dtype,input.data)?;
 return ok(Tensor(input.dtype,input.shape,owner,checked.device.id,checked.download));
}
pub server fn dispatch(ctx:Context,op:c::Operation,inputs:list<Tensor>)->result<Tensor> !{task,ffi}{
 let checked:Context=context(ctx.session,ctx.device,ctx.upload,ctx.dispatch,ctx.download)?;
 validate_inputs(op,inputs,checked.device.id)?;
 if !capable(checked.device,op,inputs[0].dtype){return err("E_COMPUTE_UNSUPPORTED","owned context lacks requested capability");}
 if !resource_is_open(checked.session){return err("E_DEVICE_CLOSED","device session is closed");}
 if !resource_is_open(inputs[0].buffer) || !resource_is_open(inputs[1].buffer){return err("E_DEVICE_CLOSED","input buffer is closed");}
 let owner:Buffer=checked.dispatch(checked.session,op,inputs)?;
 return ok(Tensor(output_dtype(op),output_shape(op,inputs[0],inputs[1]),owner,checked.device.id,checked.download));
}
pub server fn download(value:Tensor)->result<c::Tensor> !{task,ffi}{
 let size:i64=byte_count(value.dtype,value.shape)?;
 if !resource_is_open(value.buffer){return err("E_DEVICE_CLOSED","device buffer is closed");}
 // The genuine buffer retains its physical session; no fresh session borrow
 // or reconstructed owner is required after the original Context is closed.
 let data:bytes=value.download(value.buffer)?;
 if len(data)!=size{return err("E_COMPUTE_RESPONSE","owned buffer byte count disagrees with tensor metadata");}
 return c::tensor(value.dtype,value.shape,data);
}

pub server fn close_tensor(value:Tensor)->bool !{task,ffi}{return resource_close(value.buffer);}
pub server fn close_context(value:Context)->bool !{task,ffi}{return resource_close(value.session);}
fn fallback(value:c::Request,code:str,message:str)->result<c::Response>{
 if value.fallback!=c::Fallback::CPU(){return err(code,message);}
 let cpu:c::Response=c::execute_cpu(c::on(value,c::Selection(c::Kind::CPU(),"cpu"),c::Fallback::Deny()))?;
 return ok(c::Response(cpu.version,cpu.id,cpu.output,cpu.device,true,code+": "+message));
}
server fn invoke(ctx:Context,value:c::Request)->result<c::Response> !{task,ffi}{
 let a:Tensor=upload(ctx,value.inputs[0])?;let second:result<Tensor>=upload(ctx,value.inputs[1]);
 if !is_ok(second){resource_close(a.buffer);return err(error_code(second),error_message(second));}
 let b:Tensor=second?;let invoked:result<Tensor>=dispatch(ctx,value.operation,[a,b]);resource_close(a.buffer);resource_close(b.buffer);
 let owner:Tensor=invoked?;let readback:result<c::Tensor>=download(owner);resource_close(owner.buffer);let output:c::Tensor=readback?;
 return c::validate_response(value,ctx.device,c::Response(1,value.id,output,ctx.device,false,""));
}
pub server fn execute(ctx:Context,request:c::Request)->result<c::Response> !{task,ffi}{
 let value:c::Request=c::validate_request(request)?;
 let checked:Context=context(ctx.session,ctx.device,ctx.upload,ctx.dispatch,ctx.download)?;
 if value.device.kind==c::Kind::CPU(){return c::execute_cpu(value);}
 if value.device.kind!=checked.device.kind || (value.device.id!="" && value.device.id!=checked.device.id){return fallback(value,"E_COMPUTE_UNAVAILABLE","requested device is outside this owned context");}
 if !capable(checked.device,value.operation,value.inputs[0].dtype){return fallback(value,"E_COMPUTE_UNSUPPORTED","owned context lacks requested capability");}
 let invoked:result<c::Response>=invoke(checked,value);
 if !is_ok(invoked){let code:str=error_code(invoked);if code=="E_COMPUTE_UNAVAILABLE" || code=="E_COMPUTE_UNSUPPORTED"{return fallback(value,code,error_message(invoked));}return err(code,error_message(invoked));}
 return invoked;
}
