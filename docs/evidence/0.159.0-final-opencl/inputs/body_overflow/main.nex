module owned_opencl;
import "std/compute.nex" as c;
import "std/device.nex" as d;
server extern fn open_raw(index:i64)->result<d::Session> !{ffi}=foreign("gpu","open","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server extern fn upload_raw(session:d::Session,dtype:i64,data:bytes)->result<d::Buffer> !{ffi}=foreign("gpu","upload","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server extern fn dispatch_raw(session:d::Session,a:d::Buffer,b:d::Buffer,mode:i64,scale:i64)->result<d::Buffer> !{ffi}=foreign("gpu","dispatch","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server extern fn download_raw(buffer:d::Buffer)->result<bytes> !{ffi}=foreign("gpu","download","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server extern fn name_raw(session:d::Session)->str !{ffi}=foreign("gpu","name","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server extern fn kernel_ns_raw(buffer:d::Buffer)->i64 !{ffi}=foreign("gpu","kernel_ns","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server extern fn busy_raw(session:d::Session)->i64 !{ffi}=foreign("gpu","busy","1b90b34efcc808031cef5761fe5ce8e363033f68d091f2ca7bc5f1aaee971bf3");
server fn upload_provider(session:d::Session,dtype:c::DType,data:bytes)->result<d::Buffer> !{task,ffi}{
 let code:i64=match dtype{c::DType::U8()=>1,c::DType::I8()=>2,c::DType::I32()=>3};return upload_raw(session,code,data);
}
server fn dispatch_provider(session:d::Session,op:c::Operation,inputs:list<d::Tensor>)->result<d::Buffer> !{task,ffi}{
 if len(inputs)!=2{return err("E_COMPUTE_INPUTS","owned OpenCL requires two tensors");}
 var mode:i64=1;var scale:i64=1;match op{c::Operation::Affine(value)=>{mode=2;scale=value;},c::Operation::Matmul()=>{mode=3;scale=0;},_=>{}}
 return dispatch_raw(session,inputs[0].buffer,inputs[1].buffer,mode,scale);
}
server fn download_provider(buffer:d::Buffer)->result<bytes> !{task,ffi}{return download_raw(buffer);}
server fn make_context()->result<d::Context> !{task,ffi}{
 let session:d::Session=open_raw(0)?;let name:str=name_raw(session);
 let device:c::Device=c::Device(c::Kind::GPU(),"opencl.gpu.0","nex.opencl.owned","1","pinned persistent OpenCL worker: "+name,
 [c::Capability(c::OperationKind::Add(),c::DType::U8(),c::DType::U8()),c::Capability(c::OperationKind::Affine(),c::DType::U8(),c::DType::U8())]);
 return d::context(session,device,upload_provider,dispatch_provider,download_provider);
}
client fn client_value()->i64{return 42;}

fn tensor(data:bytes)->c::Tensor{return unwrap(c::tensor(c::DType::U8(),[len(data)],data));}
fn expected(a:bytes,b:bytes)->c::Tensor{
 let cpu:c::Request=c::request("contract-cpu",c::Operation::Add(),[tensor(a),tensor(b)],c::Selection(c::Kind::CPU(),"cpu"),c::Fallback::Deny());
 return unwrap(c::execute_cpu(cpu)).output;
}
struct Tagged<T>{tag:T;response:c::Response;}
fn same<T>(left:T,right:T)->bool{return left==right;}
server fn guarded<T>(ctx:d::Context,a:bytes,b:bytes,tag:T)->Tagged<T> !{task,ffi}
 requires(ctx.device.kind==c::Kind::GPU()) requires(len(a)>0) requires(len(a)==len(b)) requires(same<T>(tag,tag))
 ensures(value=>false)
{
 let request:c::Request=c::request("inline-contract-GPU",c::Operation::Add(),[tensor(a),tensor(b)],c::Selection(c::Kind::GPU(),ctx.device.id),c::Fallback::Deny());
 let response:c::Response=unwrap(d::execute(ctx,request));return Tagged<T>(tag,response);
}
server fn main()->unit !{task,ffi,io,throw}{let ctx:d::Context=unwrap(make_context());let value:Tagged<str>=guarded<str>(ctx,unwrap(bytes([255])),unwrap(bytes([1])),"tag🙂");assert(value.tag=="tag🙂");print(42);}
