(* Toolchain0.98 internal coroutine scheduler adds no source syntax. *)
(* Toolchain0.97 browser worker entries are ordinary functions; no syntax change. *)
(* Toolchain0.87 scoped discovery is external metadata, with no grammar or migration. *)
(* Toolchain0.86 internal worker probes add no source builtin or grammar;
   source concurrency and its explicit language migration remain pending. *)
(* Toolchain0.81 editor project launches add no source syntax or migration. *)
(* Toolchain0.80 replay isolation adds no source syntax or migration. *)
(* Toolchain0.79 project package task checks add no source syntax or migration. *)
(* Toolchain0.77 project actions add no source syntax, semantics or migration. *)
(* Toolchain0.78 project task captures/replay and test builds add no source syntax. *)
(* Project source/static linkage and concrete export roots are external
   nex.build.json metadata, not language syntax or a version migration. *)
(* NEX 0.18. ASCII identifiers, decimal integers/floats, UTF-8 source, // line comments. *)
(* Toolchain0.73 native application lifetime adds no syntax or migration. *)
(* Toolchain0.74 shared native project images are external build metadata;
   language0.16 source grammar and canonical identities are unchanged. *)
(* Toolchain 0.60 scalar Wasm uses this same syntax; target restrictions are semantic. *)
(* Toolchain 0.61 iOS archives use this syntax unchanged; SDK/ABI selection is external. *)
(* Toolchain0.62 mobile projects reuse the web contract without syntax changes. *)
(* Toolchain0.63 HTTPS host/CORS configuration is external; syntax is unchanged. *)
(* Toolchain0.64 Windows GNU/UCRT target selection is external; syntax is unchanged. *)
(* Toolchain0.65 Windows environment/SQLite adapters add no source syntax. *)
(* Toolchain0.69 editor name origins add no source syntax or semantic identity. *)
(* Toolchain0.70 identifier descriptions add no source syntax or semantic identity. *)
program       = "module", qualified_name, ";", { import | function | structure | enumeration | endpoint | trait | implementation } ;
endpoint      = "endpoint", identifier, "(", string, ",", string, [ ",", integer ], ")",
                "=", qualified_name, ";" ;
import        = "import", string, "as", identifier, ";" ;
structure     = [ "pub" ], "struct", identifier, [ type_parameters ], "{", { parameter, ";" }, "}" ;
enumeration   = [ "pub" ], "enum", identifier, [ type_parameters ], "{", variant, { variant }, "}" ;
variant       = identifier, [ "(", [ parameters ], ")" ], ";" ;
function      = [ "pub" ], [ realm ], [ "extern" ], [ "test" ], "fn", identifier, [ type_parameters ], "(", [ parameters ], ")",
                "->", type, [ effects ], ( block | foreign_body ) ;
foreign_body  = "=", "foreign", "(", string, ",", string, ",", string, ")", ";" ;
realm         = "shared" | "client" | "server" ;
parameters    = parameter, { ",", parameter } ;
parameter     = identifier, ":", type ;
type          = "i64" | "f64" | "bool" | "unit" | "str" | "bytes" | "file" | ( "list" | "result" ), "<", type, ">" |
                qualified_name, [ type_arguments ] | "list" | function_type | "(", type, ")" ;
function_type = [ realm ], "fn", "(", [ types ], ")", "->", type, [ effects ] ;
types         = type, { ",", type } ;
type_parameters = "<", type_parameter, { ",", type_parameter }, ">" ;
type_parameter = identifier, [ constructor_parameters ], [ ":", constraint, { "+", constraint } ] ;
constructor_parameters = "<", "_", { ",", "_" }, ">" ;
constraint    = "add" | "ordered" | "integer" | "number" | "wire" | qualified_name ;
type_arguments = "<", type, { ",", type }, ">" ;
effects       = "!", "{", [ effect, { ",", effect } ], "}" ;
effect        = "io" | "db" | "fs" | "ffi" ;
block         = "{", { statement }, "}" ;
statement     = declaration | assignment | return | if | while | match | expression, ";" ;
declaration   = ( "let" | "var" ), identifier, ":", type, "=", expression, ";" ;
assignment    = identifier, "=", expression, ";" ;
return        = "return", [ expression ], ";" ;
if            = "if", expression, block, [ "else", ( block | if ) ] ;
while         = "while", expression, block ;
match         = "match", expression, "{", match_arm, { match_arm }, "}" ;
match_arm     = pattern, [ "if", expression ], "=>", block, [ "," ] ;
match_expression = "match", expression, "{", expression_arm, { ",", expression_arm }, [ "," ], "}" ;
expression_arm = pattern, [ "if", expression ], "=>", expression ;
pattern       = "_" | identifier | [ "-" ], integer | "true" | "false" | string |
                "[", [ pattern, { ",", pattern } ], "]" |
                qualified_name, "(", [ pattern, { ",", pattern } ], ")" ;
expression    = logical_or ;
logical_or    = logical_and, { "||", logical_and } ;
logical_and   = equality, { "&&", equality } ;
equality      = ordering, { ( "==" | "!=" ), ordering } ;
ordering      = addition, { ( "<" | "<=" | ">" | ">=" ), addition } ;
addition      = product, { ( "+" | "-" ), product } ;
product       = unary, { ( "*" | "/" | "%" ), unary } ;
unary         = ( "-" | "!" ), unary | postfix ;
postfix       = primary, { ".", identifier | "[", expression, "]" | "(", [ arguments ], ")" | "?" } ;
primary       = match_expression | lambda | floating | integer | "true" | "false" | string | list_literal | generic_builtin | qualified_name,
                [ type_arguments, [ "::", identifier, [ type_arguments ] ] ] | "str", "(", [ arguments ], ")" |
                "(", expression, ")" ;
lambda        = [ realm ], "fn", "(", [ parameters ], ")", "->", type, [ effects ], block ;
list_literal  = "[", [ arguments ], "]" ;
generic_builtin = ( "decode_json" | "err" ), "<", type, ">", "(", [ arguments ], ")" ;
string        = '"', { string_char | escape }, '"' ;
string_char   = ? Unicode scalar except U+0000..U+001F, double quote and backslash ? ;
escape        = "\\", ( '"' | "\\" | "/" | "b" | "f" | "n" | "r" | "t" |
                "u", hex, hex, hex, hex ) ;
hex           = digit | "a" .. "f" | "A" .. "F" ;
arguments     = expression, { ",", expression } ;
identifier    = ( letter | "_" ), { letter | digit | "_" } ;
qualified_name = identifier, { "::", identifier } ;
integer       = digit, { digit } ;
floating      = integer, ( ".", integer, [ exponent ] | exponent ) ;
exponent      = ( "e" | "E" ), [ "+" | "-" ], integer ;
letter        = "A" .. "Z" | "a" .. "z" ;
digit         = "0" .. "9" ;
(* Keywords cannot be identifiers. Unit parameters, locals and elements are rejected
   by typing. Escaped surrogate pairs must form a Unicode scalar. Integer range,
   effects, realm restrictions, constructor arity and returns are semantic checks.
   Imported names in source use alias::name or alias::Enum::Case for variants;
   arbitrary deep names are not implicit lookup paths. Imports require a literal
   relative/library .nex path. Enum constructors and patterns require parentheses,
   including empty payloads. Typed coverage and unreachable-arm checks apply; pattern
   names are immutable, and _ discards without introducing a binding. enum is
   contextual at declaration position; match is contextual before its arm block.
   In a scrutinee, a symbolic postfix/binary use of the name match keeps its
   ordinary meaning; parenthesize an ambiguous nested match expression. Existing function/local/type names enum and match remain valid.
   result is contextual as a type constructor; names such as a local result remain
   valid. endpoint is contextual at declaration position; its route, method,
   status, handler realm/signature and public wire types are semantic checks.
   Generic constructors use Box<T>(...) or Maybe<T>::Some(...), with inference
   from value arguments/expected types when omitted. A variant pattern keeps its
   uninstantiated name (Maybe::Some), inferred from the checked scrutinee.
   Generic parameters denote non-unit types; template bodies are checked even
   when unused. Bounds add/ordered/integer/number/wire are contextual builtin capabilities;
   integer implies number, add, ordered and wire; number implies add, ordered
   and wire; ordered implies wire. f64 literals round to nearest/ties-to-even,
   are bounded to 4096 bytes and finite binary64; zeros normalize to positive zero.
   Plain integer literals never implicitly become f64. Floating literal patterns
   are not supported; use a binding and guard. Function types
   and lambdas have explicit parameter/result types, realm and effects. A returned
   function type can be parenthesized to disambiguate its effects from the outer
   function. Free lexical values are immutable snapshots captured on creation.
   Generic named references infer from an expected function type or use explicit
   type arguments. Builtin/nominal constructors and tests are not function values.
   User traits, associated projections and fixed constructor kinds follow
   traits.md; type defaults and type lambdas remain pending. Bounds are checked also for unused declarations.
   Generic test declarations and unspecialized executable entries are rejected. *)

(* Toolchain 0.11 verification contracts are detached JSON metadata. They reuse
   the scalar expression parser and do not add source declarations or keywords. *)
(* Toolchain 0.12 task contracts are external JSON; no new source syntax. *)
(* Toolchain 0.13 stopped-frame expressions reuse this expression/type grammar.
   Their purity, capture and helper resource limits do not alter source programs. *)
(* Toolchain 0.14 partial frame captures are external debugger metadata.
   Demand-driven aggregate reads add no source syntax or runtime ABI changes. *)

(* Toolchain 0.15 operation identities are derived metadata, without source syntax. *)

(* Language 0.12 adds server-only fs text-file intrinsics and explicit migration
   from 0.11. No resource descriptor is a source value. See files.md. *)

(* Language 0.13 adds contextual primitive bytes and checked codecs/binary file
   intrinsics. bytes remains an identifier in ordinary local/field/module names
   and qualified import aliases, but cannot name a nominal declaration or generic
   parameter. Intrinsic definitions are reserved. Binary values have no literals
   or pattern syntax; see language.md for exact signatures, bounds and migration. *)

(* Language 0.14 adds contextual primitive file and server/fs streaming intrinsics.
   Local variables and qualified import aliases may still be named file. Nominal
   declarations, generic parameters and the ten intrinsic declaration names are
   reserved. File-bearing values, including phantom type arguments and captures,
   require server realm and cannot enter JSON/API or browser code. Identity
   equality and immutable owner aliases add no pointer or constructor syntax.
   Explicit migration from 0.13 preserves history; see resources.md. *)

(* Language 0.15 adds contextual extern/foreign declarations, not reserved names.
   An external declaration requires server realm, declared ffi effect, a concrete
   non-test signature and foreign_body instead of a block. Binding literals are
   logical library/export identifiers and exact lowercase SHA-256 manifest pin.
   A host grants access separately; declarations execute no native code at check
   time. Language 0.14 snapshots require explicit history-preserving migration. *)

(* Toolchain 0.48 syntax intervals and graph operation patches add no syntax.
   Statement/expression parser recursion, resulting expression trees and each postfix/binary chain are bounded
   to 256; type, pattern and lambda bounds remain as documented. *)

(* Toolchain0.51 project/language/schema preflight changes no source grammar.
   Explicit nex.json root/reachable-library versions must match the compiler;
   archived source and explicit migration remain independent of live metadata. *)

(* Toolchain0.52 captured frontend diagnostics add no source syntax. Reported
   diagnostic spans are separate from editable source ranges and committed IDs. *)

(* Toolchain0.53 adds archived graph-query commands; source grammar is unchanged. *)

(* Toolchain0.54 adds stopped-string capture ranges; source grammar is unchanged. *)

(* Language0.16 declarations. Self is contextual inside trait signatures.
   Bare list/result/eligible nominal constructors are permitted as kinded
   generic arguments; value positions require full application. *)
trait = [ "pub" ], "trait", identifier, [ "<", "Self", [ constructor_parameters ], ">" ],
        "{", { associated_type | trait_method }, "}" ;
associated_type = "type", identifier, [ ":", constraint, { "+", constraint } ], ";" ;
trait_method = [ realm ], "fn", identifier, [ type_parameters ], "(", [ parameters ], ")", "->", type, [ effects ], ";" ;
implementation = [ "pub" ], "impl", identifier, [ type_parameters ], ":", qualified_name, "for", type,
                 "{", { associated_binding | method_binding }, "}" ;
associated_binding = "type", identifier, "=", type, ";" ;
method_binding = identifier, "=", qualified_name, [ type_arguments ], ";" ;

(* Toolchain0.59 core capsule commands add no source syntax or language migration. *)

(* Toolchain0.66 editor analysis/LSP reuses the current source grammar; no migration. *)

(* Toolchain0.67 VS Code LSP client reuses this grammar; no language migration. *)

(* Toolchain0.68 checked editor references are external metadata; syntax and language0.16 remain unchanged. *)

(* Toolchain0.71 project build descriptions are external JSON metadata in
   nex.build.json, not source grammar. They do not add concurrency, GPU/NPU
   syntax or change language0.16 canonical identities. *)

(* Toolchain0.75 owned-image frame/core/capsule metadata adds no source grammar
   or canonical-format change and requires no language0.16 migration. *)

(* Toolchain0.76 project packages are external deployment metadata; source
   grammar/canonical language0.16 and graph history are unchanged. *)

(* Toolchain0.82 server workloads are external JSON metadata; the source
   grammar, canonical language0.16 identities and migration policy are unchanged. *)

(* Toolchain0.83 workload tasks/budgets use external JSON, with no source
   syntax, canonical language0.16 identity or migration change. *)

(* Toolchain0.84 project-wide foreign package projection is external build/task
   metadata. Source syntax and language0.16 semantics remain unchanged. *)

(* Toolchain0.85 server debug sessions and runtime launch metadata do not change
   language0.16 syntax, typing, realm/effect rules or canonical formats. *)

(* Language0.17 adds postfix result propagation ?. Its operand must be result<T>
   and the current function must return result<U>. Errors return unchanged from
   that function, including a lifted lambda. Success yields T. Evaluation is once,
   left-to-right; checked traps remain terminating. Explicit migration from0.16
   preserves archived revisions/IDs. No identifiers are newly reserved. *)

(* Language0.18 adds the reserved intrinsic parallel_map(items, callback, workers)
+   through ordinary call syntax. Callback typing/effects/realm, resource graphs,
+   bounds and explicit history-preserving migration are semantic rules; see
+   concurrency-design.md. No new expression kind or existing AST ordinal changes. *)
+