(* Explicit C++028 candidate, not the ordinary027 source grammar. *)
function = [ "pub" ], [ realm ], [ "test" ], "fn", identifier,
           [ type_parameters ], "(", [ parameters ], ")", "->", type,
           [ effects ], { precondition | postcondition }, block ;
precondition = "requires", "(", expression, ")" ;
postcondition = "ensures", "(", [ identifier, "=>" ], expression, ")" ;
while = "while", expression,
        [ invariant, { invariant }, "decreases", "(", expression, ")" ], block ;
invariant = "invariant", "(", expression, ")" ;
(* Non-unit postconditions require a result binder; unit ones reject it.
   Other productions use grammar.ebnf. These four names stay contextual. *)
