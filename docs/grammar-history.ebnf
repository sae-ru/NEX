(* Historical development notes, preserved verbatim; current grammar is grammar.ebnf. *)
(* Toolchain0.151 explicit027 snapshots and pure scalar Wasm add no grammar
   productions. Public/default026 and retained canonical identities remain. *)
(* Toolchain0.150 checked027 browser maps/adapters add no source productions;
   ordinary026 syntax/defaults and retained AST identities are unchanged. *)
(* Toolchain0.149 bounded027 debugger views add no grammar productions;
   public/default source026 and retained AST identities remain unchanged. *)
(* Toolchain0.148 explicit C++027 native provider delivery adds ABI/record
   versions, not source productions; public/default source remains026. *)
(* Toolchain147 explicit C++ archival/migration assigns027 nex.program/15;
   retained026 nex.program/14 and ordinary CLI selection are unchanged.
   Migration changes graph state only through guarded explicit publication. *)
(* Candidate027 authority transfer uses existing syntax. Cohort0x2702 and
   checked source-error contracts are runtime/codegen rules; public026 and
   retained0x2701 identities are unchanged. *)
(* Candidate027 task continuations reuse the same throw/catch productions;
   development cohort0x2701 grants no public027 project/provider selection. *)
(* Candidate0.27 sequential native lowering uses these same productions;
   public026/default and027 graph publication/migration remain unchanged. *)
(* Candidate0.27 synchronous TypeScript uses these same version-selected
   productions. Public026 syntax/defaults and027 graph migration remain unchanged. *)
(* Candidate0.27 C++ version-selected frontend adds the separate productions
   below. Public statement/try/catch/throw remain026; CLI selection, graph
   migration and full backend delivery are not enabled. *)
development027_try = "try", block, ( development027_catch, { development027_catch }, [ "finally", block ] | "finally", block ) ;
development027_catch = "catch", "(", identifier, ( ":", type | ",", identifier ), ")", [ "if", expression ], block ;
development027_throw = "throw", [ "(", expression, [ ",", expression ], ")" ], ";" ;

