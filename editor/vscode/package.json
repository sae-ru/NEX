{
  "name": "nex-language-tools",
  "displayName": "NEX Language Tools",
  "description": "NEX source diagnostics, type hints, navigation and native debugging from the installed compiler.",
  "publisher": "sae-ru",
  "version": "0.7.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nex",
    "onDebug:nex",
    "onCommand:nex.restartLanguageServer",
    "onCommand:nex.debugProject"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "NEX language tools start the configured local compiler; debugging also builds and executes the project."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "NEX requires physical files and a native development SDK on the extension host."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "nex",
        "aliases": [
          "NEX",
          "nex"
        ],
        "extensions": [
          ".nex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "nex"
      }
    ],
    "configuration": {
      "title": "NEX",
      "properties": {
        "nex.compilerPath": {
          "type": "string",
          "default": "nex",
          "scope": "machine-overridable",
          "description": "Installed NEX executable on the extension host. A path is one executable, never a shell command."
        },
        "nex.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Check unsaved NEX code and enable type hints, navigation and the outline."
        }
      }
    },
    "debuggers": [
      {
        "type": "nex",
        "label": "NEX",
        "languages": [
          "nex"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "source": {
                "type": "string",
                "description": "NEX entry source file to compile with its matching frozen sources."
              },
              "cwd": {
                "type": "string",
                "description": "Project directory on the extension host."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Individual runtime arguments: at most128,4 KiB each and64 KiB total, including compiler grant arguments.",
                "maxItems": 128
              },
              "project": {
                "type": "object",
                "required": [
                  "manifest",
                  "component",
                  "configuration"
                ],
                "additionalProperties": false,
                "properties": {
                  "manifest": {
                    "type": "string",
                    "description": "Explicit architecture manifest, resolved relative to cwd."
                  },
                  "component": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
                  },
                  "configuration": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
                  }
                },
                "description": "Debug the declared native application or HTTP server using its actual static/shared dependencies."
              },
              "target": {
                "enum": [
                  "native",
                  "server"
                ],
                "default": "native",
                "description": "Source launch only: native application or HTTP server. Projects select their kind through the architecture."
              },
              "foreign": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Current trusted operator catalogue, resolved relative to cwd and checked by the compiler. Use this field instead of grant flags in args."
              }
            },
            "oneOf": [
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "project"
                ]
              }
            ]
          }
        },
        "initialConfigurations": [
          {
            "type": "nex",
            "request": "launch",
            "name": "Debug NEX source",
            "source": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "NEX: native launch",
            "body": {
              "type": "nex",
              "request": "launch",
              "name": "Debug NEX",
              "source": "${file}",
              "cwd": "${workspaceFolder}"
            }
          },
          {
            "label": "NEX: project architecture launch",
            "description": "Debug a declared native component with its actual library images.",
            "body": {
              "type": "nex",
              "request": "launch",
              "name": "Debug NEX project",
              "cwd": "${workspaceFolder}",
              "project": {
                "manifest": "nex.build.json",
                "component": "app",
                "configuration": "debug"
              },
              "stopOnEntry": false,
              "args": []
            }
          },
          {
            "label": "NEX: project HTTP server",
            "body": {
              "type": "nex",
              "request": "launch",
              "name": "Debug NEX server",
              "cwd": "${workspaceFolder}",
              "project": {
                "manifest": "nex.build.json",
                "component": "service",
                "configuration": "debug"
              },
              "args": [
                "--auth",
                "private/auth.json",
                "--database",
                "private/debug.sqlite",
                "--port",
                "0",
                "--timeout-ms",
                "60000"
              ]
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "nex.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "NEX",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nex.debugProject",
        "title": "NEX: Debug Project Component",
        "enablement": "isWorkspaceTrusted"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "@vscode/test-electron": "3.1.0"
  },
  "files": [
    "extension.js",
    "session.js",
    "language-configuration.json",
    "README.md",
    "language.js",
    "lsp-client.js",
    "project-command.js"
  ],
  "scripts": {
    "test": "node --test test.js language.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  }
}
