module native_diagnostics;

fn divide(denominator:i64)->i64{return 42/denominator;}

// Intentionally exits with E_DIV_ZERO. Inspect native_diagnostics in run --json.
fn main()->unit!{io}{print("before failure");print(divide(0));}

// Select --entry message to inspect escaped NUL and Unicode in fatal text.
fn message()->i64{return unwrap(err<i64>("CUSTOM","before\u0000after 🌍"));}
