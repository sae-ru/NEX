{
  "schema": "nex.project-build/1",
  "default_configuration": "debug",
  "configurations": {
    "debug": {"profile": "debug", "target": "native"},
    "release": {"profile": "release", "target": "native"}
  },
  "components": {
    "core": {"kind": "source", "root": "core", "entry": "core/value.nex"},
    "app": {"kind": "executable", "root": "app", "entry": "app/main.nex", "dependencies": {"core": "source"}},
    "archive": {"kind": "static_library", "root": "archive", "entry": "archive/main.nex", "entry_function": "answer", "dependencies": {"core": "source"}},
    "browser": {"kind": "web", "root": "browser", "entry": "browser/main.nex", "dependencies": {"core": "source"}}
  }
}
