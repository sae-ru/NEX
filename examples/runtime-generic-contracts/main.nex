module generic_guards;

pub fn maximum<T:ordered>(left:T,right:T)->T {
  if left<right { return right; }
  return left;
}

pub fn identity<T>(value:T)->T { return value; }

fn main()->unit !{io} {
  print(maximum<i64>(17,42));
  print(identity<str>("🙂"));
}

test fn values()->unit {
  assert(maximum<i64>(17,42)==42);
  assert(maximum<f64>(1.25,2.5)==2.5);
  assert(identity<str>("🙂")=="🙂");
}
