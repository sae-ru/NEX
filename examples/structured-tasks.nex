module structured_tasks;

fn main()->i64 !{task}{
  return with_tasks(2,fn(scope:task_scope)->i64 !{task}{
    let queue:channel<i64>=channel_new<i64>(scope,0);
    let sender:task<unit>=task_spawn(scope,fn()->unit !{task}{
      task_yield();
      assert(task_send(queue,42));
    });
    let value:i64=unwrap(task_recv(queue));
    task_wait(sender);
    assert(task_close(queue));
    return value;
  });
}

test fn rendezvous()->unit !{task}{assert(main()==42);}
