module source_resources;
pub server resource Session;
pub server resource Buffer<T>;
pub server fn alive(value:Session)->bool !{ffi}{return resource_is_open(value);}
pub server fn close(value:Session)->bool !{ffi}{return resource_close(value);}
pub server fn forward<T>(value:Buffer<T>)->Buffer<T>{return value;}
fn preserve<resource>(value:resource)->resource{return value;}
fn main()->i64{return preserve<i64>(42);}
test fn ordinary_name()->unit{assert(preserve<i64>(42)==42);}
