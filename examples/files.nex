module files_example;

server fn roundtrip(path: str, value: str) -> result<str> !{fs} {
  let written: result<bool> = file_write_text(path, value);
  if !is_ok(written) { return err(error_code(written), error_message(written)); }
  return file_read_text(path);
}

server fn main() -> unit !{fs, io} {
  print(unwrap(roundtrip("nex-message.txt", "Я🧠\u0000text")));
}

test fn immutable_text() -> unit {
  let value: str = "Я🧠\u0000text";
  assert(len(value) == 7);
}
