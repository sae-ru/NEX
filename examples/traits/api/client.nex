// Copy into generated/client/consumer.nex after API generation.
module traits::api::consumer;
import "./api.nex" as sdk;
import "./models/traits/api/model.nex" as model;
import "helpers/contracts.nex" as contract;
import "std/net.nex" as net;

test fn values() -> unit {
  assert(contract::Readable<model::Box<i64>>::get(model::Box(42)) == 42);
  let value: model::Envelope<model::Box<i64>> = model::Envelope<model::Box<i64>>(42);
  let command: net::Command = sdk::request_echo_value("id", "runtime-token", value, "done", 1000);
  let payload: net::TypedPayload = unwrap(decode_json<net::TypedPayload>(command.body));
  assert(unwrap(decode_json<model::Envelope<model::Box<i64>>>(payload.body)) == value);
}
fn main() -> unit {}
