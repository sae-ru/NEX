module runtime_loop_contracts;

pub fn double(n: i64) -> i64 {
  var i: i64 = 0;
  var total: i64 = 0;
  while i < n {
    total = total + 2;
    i = i + 1;
  }
  return total;
}
fn main() -> unit !{io} { print(double(5)); }
test fn normal_inputs() -> unit { assert(double(0) == 0); assert(double(5) == 10); }
