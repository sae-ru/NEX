module propagation;

struct Entry { label:str; values:list<str>; }

fn display(text:str)->result<str> {
  let value:i64=decode_json<i64>(text)?;
  return ok("value="+str(value));
}
fn forward<T>(value:result<T>)->result<T> {return ok(value?);}
fn nested(value:result<result<i64>>)->result<i64> {return ok(value??);}
fn choose(flag:bool)->result<bool> {return ok(flag && err<bool>("STOP","guard")?);}
fn select(flag:bool)->result<str> {
  return ok(match flag {true if ok(true)?=>"yes", _=>"no"});
}
fn partial()->result<str> {
  let entry:Entry=Entry("before"+" temporary", [ok("first")?,err<str>("PARTIAL","same error 🦊")?]);
  return ok(entry.label);
}
fn lambda_boundary()->result<str> {
  let run:fn()->result<i64>=fn()->result<i64>{return ok(err<i64>("INNER","local")?);};
  let value:result<i64>=run();
  return ok("outer:"+error_code(value));
}
fn main()->unit!{io} {
  print(display("\"42\""));
  print(partial());
  print(lambda_boundary());
}

test fn propagation_semantics()->unit {
  assert(display("\"42\"")==ok("value=42"));
  assert(error_code(display("wrong"))=="E_JSON");
  assert(forward(ok("Я\u0000🦊"))==ok("Я\u0000🦊"));
  assert(forward(err<str>("X","m"))==err<str>("X","m"));
  assert(nested(ok(ok(42)))==ok(42));
  assert(nested(ok(err<i64>("INNER","m")))==err<i64>("INNER","m"));
  assert(nested(err<result<i64>>("OUTER","m"))==err<i64>("OUTER","m"));
  assert(choose(false)==ok(false));
  assert(choose(true)==err<bool>("STOP","guard"));
  assert(select(true)==ok("yes"));assert(select(false)==ok("no"));
  assert(partial()==err<str>("PARTIAL","same error 🦊"));
  assert(lambda_boundary()==ok("outer:INNER"));
}
