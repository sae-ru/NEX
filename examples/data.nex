module data;

struct User {
  id: i64;
  name: str;
  active: bool;
  tags: list<str>;
}

fn user(name: str) -> User {
  let tags: list<str> = ["nex", "web"];
  return User(7, name, true, tags);
}

fn greeting(value: User) -> str {
  return "Привет, " + value.name + "!";
}

fn main() -> i64 !{io} {
  let original: User = user("Саша 🦊");
  print(greeting(original));
  print(original);
  var names: list<str> = [original.name];
  names = push(names, "Ada");
  let changed: list<str> = set(names, 0, "Lin");
  print(names);
  print(changed);
  print(len("A🦊Я"));
  print("A🦊Я"[1]);
  print(slice("A🦊Я", 1, 2));
  return 0;
}

test fn values_test() -> unit {
  let value: User = user("Ada");
  assert(value == User(7, "Ada", true, ["nex", "web"]));
  assert(greeting(value) == "Привет, Ada!");
  assert(contains(value.name, "da"));
  assert(len(value.tags) == 2);
  assert(value.tags[0] == "nex");
  let nested: list<list<str>>=[[], ["a", "b"]];
  assert(nested[1][1] == "b");
  assert(len(nested[0]) == 0);
  assert(push([], 4) == [4]);
  assert([true, false][0]);
  assert("\uD83E\uDD8A" == "🦊");
  assert(len("a\u0000b") == 3);
  assert(str(123) == "123");
  assert(str(true) == "true");
}
