{
  "schema": "nex.project-build/1",
  "default_configuration": "debug",
  "configurations": {
    "debug": {
      "profile": "debug",
      "task_limits": {
        "steps": 1000000,
        "timeout_ms": 10000,
        "workers": 2
      }
    },
    "release": {
      "profile": "release",
      "task_limits": {
        "steps": 1000000,
        "timeout_ms": 10000,
        "workers": 2
      }
    }
  },
  "components": {
    "leaf": {
      "kind": "static_library",
      "root": "leaf",
      "entry": "leaf/value.nex",
      "entry_function": "make",
      "exports": [
        "bump",
        "fail",
        "pure",
        "cycle"
      ],
      "dependencies": {
        "pure": "static"
      }
    },
    "mid": {
      "kind": "static_library",
      "root": "mid",
      "entry": "mid/value.nex",
      "entry_function": "twice",
      "exports": [
        "fail"
      ],
      "dependencies": {
        "leaf": "static"
      }
    },
    "app": {
      "kind": "executable",
      "root": "app",
      "entry": "app/main.nex",
      "dependencies": {
        "leaf": "static",
        "mid": "static"
      }
    },
    "pure": {
      "kind": "static_library",
      "root": "pure",
      "entry": "pure/value.nex",
      "entry_function": "next"
    }
  }
}
