module exceptions;

fn leaf<T:integer>(value:T)->str !{throw} {
  throw("LEAF",str(value));
}

fn recovered()->i64 {
  try { let ignored:str=leaf(42); return 0; }
  catch(code,message) { assert(code=="LEAF"); return len(message)+40; }
}

fn main()->i64 { return recovered(); }

test fn generic_error()->unit { assert(recovered()==42); }

test fn unicode_payload()->unit {
  try { throw("Я🧠","λ\u0000🙂"); }
  catch(code,message) {
    assert(len(code)==2&&code[1]=="🧠");
    assert(len(message)==3&&message[1]=="\u0000"&&message[2]=="🙂");
  }
}

test fn lexical_rethrow()->unit {
  try {
    try { throw("ORIGINAL","value"); }
    catch(code,message) { throw; }
  } catch(code,message) { assert(code=="ORIGINAL"&&message=="value"); }
}

test fn retained_closure()->unit {
  var saved:fn()->str=fn()->str{return "old";};
  try {
    let values:list<str>=["snapshot","retained"];
    saved=fn()->str{return values[0]+values[1];};
    throw("DISCARD","temporary");
  } catch(code,message) { assert(code=="DISCARD"); }
  assert(saved()=="snapshotretained");
}

fn result_error()->result<i64> {
  try { let value:i64=err<i64>("RESULT","unchanged")?; return ok(value); }
  catch(code,message) { return ok(0); }
}

test fn result_boundary()->unit {
  let value:result<i64>=result_error();
  assert(!is_ok(value)&&error_code(value)=="RESULT");
}

fn part(value:str)->str !{io} { print(value); return value; }
fn stop()->str !{throw} { throw("STOP","second"); }
fn join(a:str,b:str,c:str)->str { return a+b+c; }

test fn argument_order()->unit !{io} {
  try { let ignored:str=join(part("first"),stop(),part("third")); assert(false); }
  catch(code,message) { assert(code=="STOP"); }
}

test fn parallel_catches()->unit {
  let values:list<i64>=parallel_map([1,2,3],fn(value:i64)->i64 {
    try { throw("MAP",str(value)); }
    catch(code,message) { assert(code=="MAP"); return value+10; }
  },2);
  assert(values==[11,12,13]);
}

fn child()->i64 !{task,throw} { task_yield(); throw("CHILD","worker"); }

test fn child_error()->unit !{task} {
  try {
    let ignored:i64=with_tasks(2,fn(scope:task_scope)->i64 !{task,throw} {
      let future:task<i64>=task_spawn(scope,child);
      return task_wait(future);
    });
    assert(false);
  } catch(code,message) { assert(code=="CHILD"&&message=="worker"); }
}

test fn scope_join_error()->unit !{task} {
  try {
    let ignored:i64=with_tasks(2,fn(scope:task_scope)->i64 !{task} {
      let future:task<i64>=task_spawn(scope,child);
      return 0;
    });
    assert(false);
  } catch(code,message) { assert(code=="CHILD"&&message=="worker"); }
}
