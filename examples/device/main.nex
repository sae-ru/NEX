module device_contract;
import "std/compute.nex" as c;
import "std/device.nex" as d;

// Metadata can be checked without loading a driver or creating a device.
pub fn checked_sizes()->bool{
 return d::byte_count(c::DType::U8(),[3])==ok(3)
  && d::byte_count(c::DType::I32(),[262144])==ok(1048576)
  && error_code(d::byte_count(c::DType::U8(),[]))=="E_COMPUTE_SHAPE"
  && error_code(d::byte_count(c::DType::I32(),[262145]))=="E_COMPUTE_LIMIT"
  && error_code(d::byte_count(c::DType::U8(),[9223372036854775807,2]))=="E_COMPUTE_LIMIT";
}
client fn client_value()->i64{return 42;}
fn main()->unit !{io}{assert(checked_sizes());print(42);}
test fn sizes()->unit{assert(checked_sizes());}
