module enums::web;
import "./main.nex" as model;
import "std/web.nex" as web;

client fn title() -> str { return "NEX enum state"; }
client fn initial() -> model::Event { return model::Event::Set(0); }

client fn update(state: model::Event, event: web::Event) -> model::Event {
  if event.name == "reset" { return model::Event::Reset(); }
  if event.name == "label" { return model::Event::Label(event.value, []); }
  if event.name == "increment" {
    match state {
      model::Event::Set(n) => { return model::Event::Set(n + 1); },
      model::Event::Reset() => { return model::Event::Set(1); },
      model::Event::Label(text, _) => { return model::Event::Set(len(text)); }
    }
  }
  return state;
}

client fn view(state: model::Event) -> web::View {
  var text: str = "";
  match state {
    model::Event::Set(n) => { text = str(n); },
    model::Event::Reset() => { text = "reset"; },
    model::Event::Label(label, _) => { text = label; }
  }
  return web::element("main", [], [], [
    web::element("h1", [], [], [web::text(title())]),
    web::element("p", [web::attr("role", "status")], [], [web::text(text)]),
    web::button("Increment", "increment"),
    web::button("Reset", "reset"),
    web::element("label", [web::attr("for", "label")], [], [web::text("Label")]),
    web::input("label", "", "label")
  ]);
}

client test fn enum_transitions() -> unit {
  assert(update(initial(), web::Event("increment", "", "/")) == model::Event::Set(1));
  assert(update(initial(), web::Event("label", "🧠", "/")) == model::Event::Label("🧠", []));
}
