module module_example;
import "./model.nex" as model;
import "std/math.nex" as math;
import "std/text.nex" as text;

fn main() -> unit !{io} {
  let item: model::Item = model::create("NEX", ["native", "web"]);
  print(item);
  print(text::join(item.tags, " + "));
  print(math::clamp(15, 0, 10));
}

test fn application_test() -> unit {
  assert(model::create("NEX", []).name == "NEX");
  assert(text::starts_with("NEX language", "NEX"));
}
