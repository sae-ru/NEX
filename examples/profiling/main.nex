module profiling;

fn sum(n: i64) -> i64 {
  var total: i64 = 0;
  var i: i64 = 0;
  while i < n { total = total + i; i = i + 1; }
  return total;
}

fn labels(n: i64) -> list<str> {
  var items: list<str> = [];
  var i: i64 = 0;
  while i < n { items = push(items, "NEX " + str(i)); i = i + 1; }
  return items;
}

fn main() -> unit !{io} {
  print(sum(20000));
  print(len(labels(80)));
}

test fn behavior() -> unit {
  assert(sum(5) == 10);
  assert(labels(2) == ["NEX 0", "NEX 1"]);
}
