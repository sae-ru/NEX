module ordered_containers;
import "std/ordered_map.nex" as maps;
import "std/ordered_set.nex" as sets;

fn compare(a: i64, b: i64) -> i64 {
  if a < b { return -1; }
  if a > b { return 1; }
  return 0;
}
fn exercise() -> unit {
  var table: maps::Map<i64, str> = maps::empty(compare);
  table = maps::put(table, 3, "three");
  table = maps::put(table, 1, "one");
  table = maps::put(table, 2, "two");
  let previous: maps::Map<i64, str> = table;
  table = maps::put(table, 2, "updated");
  assert(unwrap(maps::get(previous, 2)) == "two");
  assert(unwrap(maps::get(table, 2)) == "updated");
  assert(maps::keys(table) == [1, 2, 3]);
  assert(maps::height(table) == 2 && maps::validate(table));
  table = maps::remove(table, 2);
  assert(maps::keys(table) == [1, 3] && maps::validate(table));

  let left: sets::Set<i64> = sets::add(sets::add(sets::empty(compare), 3), 1);
  let right: sets::Set<i64> = sets::add(sets::add(sets::empty(compare), 2), 3);
  assert(sets::items(sets::union(left, right)) == [1, 2, 3]);
  assert(sets::items(sets::intersection(left, right)) == [3]);
  assert(sets::items(sets::difference(left, right)) == [1]);
  assert(sets::items(left) == [1, 3] && sets::validate(left));
}
test fn ordered_test() -> unit { exercise(); }
fn main() -> unit !{io} { exercise(); print("ordered-containers-ok"); }
