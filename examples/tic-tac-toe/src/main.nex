module tic_tac_toe;
import "./rules.nex" as rules;
import "./gui.nex" as gui;

client fn portable_demo()->i64 { return rules::sequence([0,3,1,4,2]).winner; }

server fn paint(window:gui::Window,game:rules::Game,x:i64,o:i64,draws:i64)->unit !{ffi} {
  assert(gui::draw(window,unwrap(bytes(game.cells)),game.turn,game.winner,game.line,x,o,draws));
}
server fn main()->i64 !{ffi,io} {
  let opened:result<gui::Window>=gui::open();
  if !is_ok(opened) { print(error_message(opened)); return 1; }
  let window:gui::Window=unwrap(opened);
  try {
    let automated:bool=is_ok(read_env("NEX_GAME_SMOKE"));
    print("GPU: "+gui::adapter(window));
    var game:rules::Game=rules::fresh();
    var x:i64=0; var o:i64=0; var draws:i64=0;
    paint(window,game,x,o,draws);
    var running:bool=true;
    while running {
      let event:i64=gui::event(window);
      if event<0 { running=false; }
      else if event==10 { game=rules::fresh(); paint(window,game,x,o,draws); }
      else if event>=1 && event<=9 {
        let next:rules::Game=rules::move(game,event-1);
        if game.winner==0 && next.winner!=0 {
          if next.winner==1 { x=x+1; }
          else if next.winner==2 { o=o+1; }
          else { draws=draws+1; }
        }
        game=next; paint(window,game,x,o,draws);
      }
    }
    if automated {
      assert(game.winner==1 && game.line==0 && game.moves==5 && x==1 && o==0 && draws==0);
      let pixels:i64=gui::verify_gpu(window);assert(pixels>1000);
      print("GPU_SMOKE_PIXELS: "+str(pixels));
      print("GPU_SMOKE_OK: "+gui::adapter(window));
    }
  } finally { resource_close(window); }
  return 0;
}

// The same NEX state machine drives a real window and GPU in smoke mode.
server fn smoke()->unit !{ffi,io} {
  let window:gui::Window=unwrap(gui::open());
  try {
    let win:rules::Game=rules::sequence([0,3,1,4,2]);
    paint(window,win,1,0,0);
    assert(gui::verify_gpu(window)>1000);
    print("GPU_SMOKE_OK: "+gui::adapter(window));
  } finally { resource_close(window); }
}
