module runtime_values;

pub struct Batch { label: str; values: list<i64>; }

pub fn complete(input: Batch) -> Batch !{io} {
  print(input.label);
  return Batch(input.label, push(input.values, 42));
}

fn main() -> unit !{io} {
  let original: Batch = Batch("NEX🙂", [1, 2]);
  let completed: Batch = complete(original);
  assert(original.values == [1, 2]);
  print(completed.values);
}

test fn preserves_input() -> unit !{io} {
  let input: Batch = Batch("test", [7]);
  let output: Batch = complete(input);
  assert(output.values == [7, 42]);
  assert(input.values == [7]);
}
