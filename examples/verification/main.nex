module verified;

pub fn increment(x: i64) -> i64 { return x + 1; }

pub fn double(n: i64) -> i64 {
  var i: i64 = 0;
  var total: i64 = 0;
  while i < n { total = total + 2; i = i + 1; }
  return total;
}

fn main() -> unit !{io} {
  print(increment(2));
  print(double(4));
}

test fn examples() -> unit {
  assert(increment(0) == 1);
  assert(double(0) == 0);
  assert(double(8) == 16);
}
