module tasks;
import "std/web.nex" as web;

struct Task { id: i64; text: str; complete: bool; }
struct State { next_id: i64; draft: str; tasks: list<Task>; path: str; }

client fn title() -> str { return "NEX Tasks"; }
client fn initial() -> State {
  return State(2, "", [Task(1, "Build an application from NEX", false)], "/");
}

client fn update(state: State, event: web::Event) -> State {
  if event.name == "draft" { return State(state.next_id, event.value, state.tasks, state.path); }
  if event.name == "route" { return State(state.next_id, state.draft, state.tasks, event.path); }
  if event.name == "add" {
    if len(state.draft) == 0 { return state; }
    return State(state.next_id + 1, "", push(state.tasks, Task(state.next_id, state.draft, false)), state.path);
  }
  var items: list<Task> = [];
  var i: i64 = 0;
  while i < len(state.tasks) {
    let task: Task = state.tasks[i];
    if event.name == "toggle:" + str(task.id) {
      items = push(items, Task(task.id, task.text, !task.complete));
    } else {
      if event.name != "delete:" + str(task.id) { items = push(items, task); }
    }
    i = i + 1;
  }
  return State(state.next_id, state.draft, items, state.path);
}

client fn task_view(task: Task) -> web::View {
  var status: str = "Mark complete";
  var appearance: str = "task";
  if task.complete { status = "Mark active"; appearance = "task completed"; }
  return web::element("li", [web::attr("key", str(task.id)), web::attr("class", appearance)], [], [
    web::element("span", [web::attr("class", "task-text")], [], [web::text(task.text)]),
    web::button(status, "toggle:" + str(task.id)),
    web::button("Delete", "delete:" + str(task.id))
  ]);
}

client fn view(state: State) -> web::View {
  var rows: list<web::View> = [];
  var i: i64 = 0;
  var remaining: i64 = 0;
  while i < len(state.tasks) {
    let task: Task = state.tasks[i];
    if !task.complete { remaining = remaining + 1; }
    if state.path != "/active" || !task.complete { rows = push(rows, task_view(task)); }
    i = i + 1;
  }
  return web::element("main", [web::attr("class", "app")], [], [
    web::element("header", [], [], [
      web::element("p", [web::attr("class", "eyebrow")], [], [web::text("COMPILED FROM NEX")]),
      web::element("h1", [], [], [web::text(title())]),
      web::element("p", [], [], [web::text("One language. Typed state. A real browser application.")])
    ]),
    web::element("nav", [web::attr("aria-label", "Task filters")], [], [web::link("All tasks", "/"), web::link("Active tasks", "/active")]),
    web::element("form", [web::attr("class", "add-form")], [web::on("submit", "add")], [
      web::element("label", [web::attr("for", "new-task")], [], [web::text("New task")]),
      web::input("new-task", state.draft, "draft"),
      web::element("button", [web::attr("type", "submit")], [], [web::text("Add task")])
    ]),
    web::element("p", [web::attr("role", "status"), web::attr("aria-live", "polite")], [], [web::text(str(remaining) + " active")]),
    web::element("ul", [web::attr("class", "tasks"), web::attr("aria-label", "Tasks")], [], rows)
  ]);
}

client test fn task_transitions_test() -> unit {
  let start: State = initial();
  let typed: State = update(start, web::Event("draft", "Unicode 🦊 task", "/"));
  let added: State = update(typed, web::Event("add", "", "/"));
  assert(len(added.tasks) == 2);
  assert(added.tasks[1].text == "Unicode 🦊 task");
  assert(added.draft == "");
  assert(len(start.tasks) == 1);
  let toggled: State = update(added, web::Event("toggle:2", "", "/"));
  assert(toggled.tasks[1].complete);
  assert(!added.tasks[1].complete);
  let removed: State = update(toggled, web::Event("delete:1", "", "/"));
  assert(len(removed.tasks) == 1);
  assert(removed.tasks[0].id == 2);
  assert(view(start).tag == "main");
}
