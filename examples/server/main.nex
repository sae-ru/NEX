module server_tasks;
import "std/http.nex" as http;

struct Task { id: i64; text: str; complete: bool; }
struct State { next_id: i64; tasks: list<Task>; }
struct Create { text: str; }
struct Update { id: i64; text: str; complete: bool; }
struct Id { id: i64; }
struct ApiError { error: str; }
struct Identity { user: str; request_id: str; }

fn failed(status: i64, code: str) -> http::Response { return http::json_response(status, encode_json(ApiError(code))); }

server fn load() -> result<State> !{db} {
  let saved: result<str> = store_get("tasks");
  if is_ok(saved) { return decode_json<State>(unwrap(saved)); }
  if error_code(saved) == "NOT_FOUND" { return ok(State(1, [])); }
  return err(error_code(saved), error_message(saved));
}
server fn save(state: State) -> result<bool> !{db} { return store_put("tasks", encode_json(state)); }

server fn handle(request: http::Request) -> http::Response !{db} {
  if request.path == "/api/me" { return http::json_response(200, encode_json(Identity(request.user, request.request_id))); }
  let loaded: result<State> = load();
  if !is_ok(loaded) { return failed(503, "storage_unavailable"); }
  let state: State = unwrap(loaded);
  if request.path == "/api/tasks" {
    if request.method == "GET" { return http::json_response(200, encode_json(state.tasks)); }
    if request.method == "POST" {
      let decoded: result<Create> = decode_json<Create>(request.body);
      if !is_ok(decoded) { return failed(400, "invalid_request"); }
      let input: Create = unwrap(decoded);
      if len(input.text) == 0 || len(input.text) > 2000 { return failed(400, "invalid_text"); }
      if len(state.tasks) >= 5000 { return failed(409, "task_limit"); }
      let task: Task = Task(state.next_id, input.text, false);
      if !is_ok(save(State(state.next_id + 1, push(state.tasks, task)))) { return failed(503, "storage_unavailable"); }
      return http::json_response(201, encode_json(task));
    }
    if request.method == "PUT" {
      let decoded: result<Update> = decode_json<Update>(request.body);
      if !is_ok(decoded) { return failed(400, "invalid_request"); }
      let input: Update = unwrap(decoded);
      if len(input.text) == 0 || len(input.text) > 2000 { return failed(400, "invalid_text"); }
      var items: list<Task> = []; var found: bool = false; var i: i64 = 0;
      while i < len(state.tasks) {
        let task: Task = state.tasks[i];
        if task.id == input.id { items = push(items, Task(task.id, input.text, input.complete)); found = true; }
        else { items = push(items, task); }
        i = i + 1;
      }
      if !found { return failed(404, "not_found"); }
      if !is_ok(save(State(state.next_id, items))) { return failed(503, "storage_unavailable"); }
      return http::json_response(200, encode_json(items));
    }
    if request.method == "DELETE" {
      let decoded: result<Id> = decode_json<Id>(request.body);
      if !is_ok(decoded) { return failed(400, "invalid_request"); }
      let input: Id = unwrap(decoded);
      var items: list<Task> = []; var found: bool = false; var i: i64 = 0;
      while i < len(state.tasks) {
        let task: Task = state.tasks[i];
        if task.id == input.id { found = true; } else { items = push(items, task); }
        i = i + 1;
      }
      if !found { return failed(404, "not_found"); }
      if !is_ok(save(State(state.next_id, items))) { return failed(503, "storage_unavailable"); }
      return http::json_response(200, encode_json(items));
    }
    return failed(405, "method_not_allowed");
  }
  return failed(404, "not_found");
}

test fn strict_api_models_test() -> unit {
  assert(is_ok(decode_json<Create>("{\"text\":\"Я🦊\"}")));
  assert(!is_ok(decode_json<Create>("{\"text\":\"x\",\"user\":\"other\"}")));
  assert(!is_ok(decode_json<Id>("{\"id\":1}")));
}
