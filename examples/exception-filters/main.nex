module filtered_errors;

fn required(name:str)->str !{throw}{
  if len(name)==0{throw("INPUT","empty name");}
  return name;
}

fn greeting(name:str)->str !{throw}{
  try{return "Hello, "+required(name);}
  catch(code,message) if code=="INPUT" {return "Hello, guest";}
}

fn main()->unit !{io,throw}{print(greeting(""));}
test fn empty_name()->unit !{throw}{assert(greeting("")=="Hello, guest");}
test fn named()->unit !{throw}{assert(greeting("NEX")=="Hello, NEX");}
