module native_arithmetic;

fn next(value:i64)->i64{return (value*3+1)%1000003;}

fn run_steps(count:i64)->i64{
 var index:i64=0;var value:i64=1;
 while index<count{value=next(value);index=index+1;}
 return value;
}

fn main()->unit!{io}{print(run_steps(1000000));}

test fn boundaries()->unit{
 assert(run_steps(1000)==609825);
 let minimum:i64=-9223372036854775808;
 assert(minimum%-1==0);
 assert(-7/3==-2);
 assert(-7%3==-1);
 assert(7%-3==1);
 assert(9223372036854775807+0==9223372036854775807);
 assert(minimum*1==minimum);
}
