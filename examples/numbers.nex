module numbers;

struct Sample<T> { values:list<T>; response:result<T>; }
fn twice<T:number>(value:T)->T { return value+value; }
fn difference<T:number>(left:T,right:T)->T { return left-right; }
fn offset(base:f64)->fn(f64)->f64 { return fn(value:f64)->f64 { return base+value; }; }
fn classify(value:result<f64>)->f64 { return match value {ok(n) if n>0e0=>n, _=>0e0}; }
fn main()->unit!{io} {
  let transform:fn(f64)->f64=offset(0.25);
  let item:Sample<f64>=Sample(set([1.0,2.0],1,transform(2.5)),ok(0.1+0.2));
  print(twice(1.25));
  print(item);
  print(encode_json(item));
  print(unwrap(decode_json<Sample<f64>>(encode_json(item))));
  print(as_f64(9007199254740993));
  print(as_i64(9223372036854775808e0));
}
test fn numeric_cases()->unit {
  assert(twice(21)==42);
  assert(twice(1.25)==2.5);
  assert(difference(3.5,1.25)==2.25);
  assert(offset(0.25)(2.5)==2.75);
  assert(classify(ok(3.5))==3.5);
  assert(classify(ok(-3.5))==0e0);
  assert(unwrap(as_i64(-1.9))==-1);
  assert(as_f64(9007199254740993)==9007199254740992e0);
  assert(5e-324/2e0==0e0);
  assert(2.2250738585072014e-308/2e0>0e0);
  assert(-0.0==0e0);
  assert(-5.5%2.0==-1.5);
  assert((false && 1e0/0e0==0e0)==false);
}
