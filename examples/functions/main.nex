module functions;

struct Handler<T> { callback:fn(T)->T; }

fn add(offset:i64) -> (fn(i64)->i64) {
  return fn(value:i64)->i64 { return value+offset; };
}

fn twice<T>(callback:fn(T)->T,value:T) -> T {
  return callback(callback(value));
}

fn prefix(label:str) -> (fn(str)->str) {
  return fn(value:str)->str { return label+value; };
}

fn main() -> unit !{io} {
  let handler:Handler<i64> = Handler(add(1));
  print(twice(handler.callback,40));
  print(prefix("NEX ")("🧠"));
}

test fn callbacks() -> unit {
  var offset:i64=40;
  let saved:fn(i64)->i64=fn(value:i64)->i64 {return value+offset;};
  offset=900;
  assert(saved(2)==42);
  assert(twice(add(1),40)==42);
  assert(prefix("NEX ")("🧠")=="NEX 🧠");
}
