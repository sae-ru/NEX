module constraints;

pub struct Pair<T: add> { left: T; right: T; }
pub enum Number<T: integer> { Empty; Value(value: T); }

pub fn combine<T: add>(left: T, right: T) -> T {
  return left + right;
}

pub fn maximum<T: ordered>(left: T, right: T) -> T {
  if left < right { return right; }
  return left;
}

pub fn increment<T: integer>(value: T) -> T {
  return value + 1;
}

pub fn twice<T: integer>(value: T) -> T {
  return combine(value, value);
}

fn main() -> unit !{io} {
  print(combine("NEX ", "🧠"));
  print(maximum(increment(40), twice(21)));
  print(combine([1], [2, 3]));
}

test fn constrained_operations() -> unit {
  let pair: Pair<str> = Pair("left", "right");
  assert(combine(pair.left, pair.right) == "leftright");
  assert(maximum(1, 42) == 42);
  assert(increment(41) == 42);
  assert(twice(21) == 42);
  assert(combine([1], [2, 3]) == [1, 2, 3]);
  match Number<i64>::Value(42) {
    Number::Empty() => { assert(false); },
    Number::Value(value) => { assert(value == 42); }
  }
}
