module stdlib_example;
import "std/text.nex" as text;
import "std/list.nex" as seq;
import "std/math.nex" as math;
import "std/ordered_map.nex" as maps;
import "std/ordered_set.nex" as sets;
import "std/java_int.nex" as java_int;

fn compare(a:i64,b:i64)->i64 {
  if a<b{return -1;}if a>b{return 1;}return 0;
}
fn ordered_helpers()->unit {
  assert(java_int::to_i64(java_int::add(java_int::from_i64(2147483647),java_int::from_i64(1)))==-2147483648);
  assert(java_int::to_i64(java_int::unsigned_shift_right(java_int::from_i64(-1),1))==2147483647);
  var table:maps::Map<i64,str>=maps::empty(compare);
  table=maps::put(maps::put(maps::put(table,3,"three"),1,"one"),2,"two");
  let old:maps::Map<i64,str>=table;
  table=maps::remove(table,2);
  assert(maps::keys(table)==[1,3] && maps::keys(old)==[1,2,3]);
  assert(unwrap(maps::get(old,2))=="two" && maps::validate(table));
  let left:sets::Set<i64>=sets::add(sets::empty(compare),1);
  let right:sets::Set<i64>=sets::add(sets::empty(compare),2);
  assert(sets::items(sets::union(left,right))==[1,2] && sets::validate(left));
}

fn total(values:list<i64>)->i64 {
  return seq::fold(values,0,fn(sum:i64,value:i64)->i64{return sum+value;});
}
fn main()->unit !{io} {
  ordered_helpers();
  let original:list<i64>=[3,1,2,1];
  let sorted:list<i64>=seq::sort(original);
  let mapped:list<str>=seq::map(sorted,fn(value:i64)->str{return str(value);});
  print(text::join(mapped,","));
  print(text::replace(text::trim("\u2003Я 🌍\u00a0")," "," + "));
  print(total(seq::filter(original,fn(value:i64)->bool{return value>1;})));
  print(unwrap(math::gcd(-48,18)));
  assert(original==[3,1,2,1]);
}
test fn helpers_test()->unit {
  ordered_helpers();
  assert(total([3,1,2,1])==7);
  assert(text::split("Я🌍Я","Я")==["","🌍",""]);
}
