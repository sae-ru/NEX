module fullstack::model;

pub struct Task { id: i64; text: str; complete: bool; }
pub struct Create { text: str; }
pub struct Update { id: i64; text: str; complete: bool; }
pub struct Id { id: i64; }
pub struct ApiError { error: str; }
pub struct Identity { user: str; request_id: str; }

server fn private_server_value() -> str { return "SERVER_ONLY_FULLSTACK_SENTINEL"; }
