module fullstack::client_app;
import "std/web.nex" as web;
import "std/net.nex" as net;
import "./model.nex" as model;

struct State {
  credential: str; token: str; draft: str; tasks: list<model::Task>;
  serial: i64; pending: str; method: str; payload: str; notice: str; path: str;
}

client fn title() -> str { return "NEX Connected Tasks"; }
client fn initial() -> State { return State("", "", "", [], 0, "", "", "", "Enter a bearer token to sign in.", "/"); }
client fn settled(state: State, tasks: list<model::Task>, notice: str) -> State {
  return State(state.credential, state.token, state.draft, tasks, state.serial, "", "", "", notice, state.path);
}
client fn begin(state: State, method: str, payload: str) -> State {
  return State(state.credential, state.token, state.draft, state.tasks, state.serial + 1, str(state.serial + 1), method, payload, "Loading...", state.path);
}

client fn update(state: State, event: web::Event) -> State {
  if event.name == "credential" { return State(event.value, state.token, state.draft, state.tasks, state.serial, state.pending, state.method, state.payload, state.notice, state.path); }
  if event.name == "draft" { return State(state.credential, state.token, event.value, state.tasks, state.serial, state.pending, state.method, state.payload, state.notice, state.path); }
  if event.name == "route" { return State(state.credential, state.token, state.draft, state.tasks, state.serial, state.pending, state.method, state.payload, state.notice, event.path); }
  if event.name == "logout" { return State("", "", "", [], state.serial, "", "", "", "Signed out.", state.path); }
  if event.name == "response" {
    let decoded: result<net::Response> = net::response(event);
    if !is_ok(decoded) { return settled(state, state.tasks, "Invalid response envelope."); }
    let response: net::Response = unwrap(decoded);
    if response.id != state.pending { return state; }
    if !is_ok(response.body) { return settled(state, state.tasks, error_code(response.body) + ": refresh to confirm saved data."); }
    if response.status == 401 { return State("", "", "", [], state.serial, "", "", "", "Authentication failed. Enter a valid token.", state.path); }
    if response.status < 200 || response.status >= 300 { return settled(state, state.tasks, "HTTP " + str(response.status) + ": request rejected."); }
    if state.method == "POST" {
      let task: result<model::Task> = decode_json<model::Task>(unwrap(response.body));
      if !is_ok(task) { return settled(state, state.tasks, "Invalid task response."); }
      return State("", state.token, "", push(state.tasks, unwrap(task)), state.serial, "", "", "", "Saved.", state.path);
    }
    let tasks: result<list<model::Task>> = decode_json<list<model::Task>>(unwrap(response.body));
    if !is_ok(tasks) { return settled(state, state.tasks, "Invalid task response."); }
    return settled(state, unwrap(tasks), "Saved data loaded.");
  }
  if state.pending != "" { return state; }
  if event.name == "login" {
    if len(state.credential) == 0 { return state; }
    return begin(State("", state.credential, "", [], state.serial, "", "", "", "", state.path), "GET", "");
  }
  if state.token == "" { return state; }
  if event.name == "refresh" { return begin(state, "GET", ""); }
  if event.name == "add" {
    if len(state.draft) == 0 || len(state.draft) > 2000 { return settled(state, state.tasks, "Task text must contain 1..2000 characters."); }
    return begin(state, "POST", encode_json(model::Create(state.draft)));
  }
  var i: i64 = 0;
  while i < len(state.tasks) {
    let task: model::Task = state.tasks[i];
    if event.name == "toggle:" + str(task.id) { return begin(state, "PUT", encode_json(model::Update(task.id, task.text, !task.complete))); }
    if event.name == "replace:" + str(task.id) {
      if len(state.draft) == 0 || len(state.draft) > 2000 { return settled(state, state.tasks, "Enter replacement task text first."); }
      return begin(state, "PUT", encode_json(model::Update(task.id, state.draft, task.complete)));
    }
    if event.name == "delete:" + str(task.id) { return begin(state, "DELETE", encode_json(model::Id(task.id))); }
    i = i + 1;
  }
  return state;
}

client fn commands(before: State, after: State, event: web::Event) -> list<net::Command> {
  if event.name == "logout" { return [net::cancel_all()]; }
  if event.name == "cancel" && before.pending != "" { return [net::cancel(before.pending)]; }
  if after.pending != "" && after.pending != before.pending {
    return [net::request(after.pending, after.method, "/api/tasks", after.payload, after.token, "response", 5000)];
  }
  return [];
}

client fn view(state: State) -> web::View {
  let status: web::View = web::element("p", [web::attr("role", "status"), web::attr("aria-live", "polite")], [], [web::text(state.notice)]);
  if state.token == "" {
    return web::element("main", [web::attr("class", "app")], [], [
      web::element("h1", [], [], [web::text(title())]), status,
      web::element("form", [], [web::on("submit", "login")], [
        web::element("label", [web::attr("for", "credential")], [], [web::text("Bearer token")]),
        web::element("input", [web::attr("id", "credential"), web::attr("type", "password"), web::attr("value", state.credential), web::attr("autocomplete", "off")], [web::on("input", "credential")], []),
        web::element("button", [web::attr("type", "submit")], [], [web::text("Sign in")])
      ])
    ]);
  }
  var rows: list<web::View> = [];
  var i: i64 = 0;
  while i < len(state.tasks) {
    let task: model::Task = state.tasks[i];
    if state.path != "/active" || !task.complete {
      var label: str = "Mark complete"; if task.complete { label = "Mark active"; }
      rows = push(rows, web::element("li", [web::attr("key", str(task.id)), web::attr("data-id", str(task.id))], [], [
        web::element("span", [web::attr("class", "task-text")], [], [web::text(task.text)]),
        web::button(label, "toggle:" + str(task.id)), web::button("Replace text", "replace:" + str(task.id)), web::button("Delete", "delete:" + str(task.id))
      ]));
    }
    i = i + 1;
  }
  return web::element("main", [web::attr("class", "app")], [], [
    web::element("h1", [], [], [web::text(title())]),
    web::element("nav", [web::attr("aria-label", "Task filters")], [], [web::link("All tasks", "/"), web::link("Active tasks", "/active")]),
    web::button("Sign out", "logout"), web::button("Refresh", "refresh"), web::button("Cancel request", "cancel"), status,
    web::element("form", [], [web::on("submit", "add")], [
      web::element("label", [web::attr("for", "task-text")], [], [web::text("New or replacement task text")]),
      web::input("task-text", state.draft, "draft"),
      web::element("button", [web::attr("type", "submit")], [], [web::text("Add task")])
    ]),
    web::element("ul", [web::attr("aria-label", "Tasks")], [], rows)
  ]);
}

client test fn request_transition_test() -> unit {
  let start: State = initial();
  let typed: State = update(start, web::Event("credential", "runtime-token", "/"));
  let event: web::Event = web::Event("login", "", "/");
  let loading: State = update(typed, event);
  assert(loading.pending == "1"); assert(loading.credential == "");
  let work: list<net::Command> = commands(typed, loading, event);
  assert(work[0].method == "GET"); assert(work[0].token == "runtime-token");
  let response: net::Response = net::Response("1", 200, ok("[]"));
  let loaded: State = update(loading, web::Event("response", encode_json(response), "/"));
  assert(loaded.pending == ""); assert(len(loaded.tasks) == 0);
  assert(update(loaded, web::Event("response", encode_json(response), "/")) == loaded);
  let signed_out: State = update(loading, web::Event("logout", "", "/"));
  assert(signed_out.token == ""); assert(signed_out.pending == "");
  assert(update(signed_out, web::Event("response", encode_json(response), "/")) == signed_out);
}
