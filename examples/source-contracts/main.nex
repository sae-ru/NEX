module source_contract_example;
fn repeat<T>(value:T,n:i64)->list<T>
 requires(n>=0 && n<=8)
 ensures(values=>len(values)==n)
{
 var i:i64=0;
 var values:list<T>=[];
 while i<n invariant(i>=0 && i<=n) invariant(len(values)==i) decreases(n-i){
  values=values+[value];
  i=i+1;
 }
 return values;
}
fn main()->i64{assert(repeat("🙂",3)==["🙂","🙂","🙂"]);return 42;}

test fn repeat_is_checked()->unit{assert(repeat("🙂",3)==["🙂","🙂","🙂"]);}
