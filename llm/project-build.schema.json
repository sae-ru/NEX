{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/project-build-1.json",
  "title": "Checked NEX project build architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "components",
    "configurations",
    "default_configuration"
  ],
  "properties": {
    "schema": {
      "const": "nex.project-build/1"
    },
    "default_configuration": {
      "$ref": "#/$defs/name"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "root",
          "entry"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "executable",
              "static_library",
              "shared_library",
              "server",
              "web"
            ]
          },
          "root": {
            "$ref": "#/$defs/path"
          },
          "entry": {
            "$ref": "#/$defs/path"
          },
          "entry_function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "dependencies": {
            "type": "object",
            "maxProperties": 128,
            "propertyNames": {
              "$ref": "#/$defs/name"
            },
            "additionalProperties": {
              "enum": [
                "source",
                "static",
                "dynamic"
              ]
            }
          },
          "exports": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "static_library",
                    "shared_library"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "entry_function"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "web"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "entry_function"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "exports"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "enum": [
                    "static_library",
                    "shared_library"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "configurations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "enum": [
              "debug",
              "profile",
              "release"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "not": {
              "enum": [
                "web",
                "server",
                "wasm"
              ]
            }
          },
          "toolchain": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\\\:\\u0000]+$"
    }
  },
  "description": "Filesystem containment, normalized paths, disjoint roots, acyclic direct dependencies, language, entry contracts and locks are compiler-checked. Source edges compile reachable source. Static edges consume checked native archives. Dynamic edges consume separately linked shared libraries and one common runtime on macOS/Linux. All binary edges require exact compiler/toolchain/runtime ABI, checked source and explicit generic instantiation. Project foreign-pin projection, packaged debug provenance, Windows DLLs, source GPU/NPU adapters, binary-only packages and full-static executable policy remain pending."
}
