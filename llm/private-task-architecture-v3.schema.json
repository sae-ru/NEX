{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.private-task-architecture/3",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "mode", "application", "components"],
  "properties": {
    "schema": {"const": "nex.private-task-architecture/3"},
    "mode": {"const": "mixed-fixed"},
    "application": {"type": "string", "minLength": 1, "maxLength": 64},
    "components": {"type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,64}$"},
      "additionalProperties": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "strings": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "units", "exports", "dependencies", "linkage", "instantiations"],
      "properties": {
        "entry": {"type": "string", "minLength": 1},
        "units": {"allOf": [{"$ref": "#/$defs/strings"}], "minItems": 1},
        "exports": {"$ref": "#/$defs/strings"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "linkage": {"enum": ["application", "static", "shared"]},
        "instantiations": {"$ref": "#/$defs/strings"}
      }
    }
  },
  "description": "Compiler-private025 checked-source specialization placement. Select existing concrete function names from describeSourceExceptionTaskInstances; the source checker must already have instantiated them. Every explicit root/family and physical image has a unique owner. External roots require public templates and direct source-component dependencies. Source visibility, actual trait witnesses, derived support edges, native signatures and image ownership must be rederived, not inferred from JSON shape."
}
