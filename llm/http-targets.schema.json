{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.http-targets/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resolvers", "authorities"],
  "properties": {
    "schema": {"const": "nex.http-targets/1"},
    "maximum_calls": {"type": "integer", "minimum": 1, "maximum": 64, "default": 16},
    "ca_file": {"type": "string", "description": "Explicit regular public PEM CA bundle, at most1MiB; relative to the policy file; required for HTTPS"},
    "resolvers": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["address", "port"],
        "properties": {
          "address": {"type": "string", "description": "Numeric unicast IPv4/IPv6 without scope; canonical uniqueness checked by preparer"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "authorities": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "domain", "subdomains", "schemes", "ports", "methods"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "domain": {"type": "string", "description": "Canonical ASCII hostname, numeric unicast IP, or explicit * with subdomains=true"},
          "subdomains": {"type": "boolean"},
          "schemes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["http", "https"]}},
          "ports": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
          "methods": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,32}$"}},
          "cross_origin_redirects": {"type": "boolean", "default": false}
        }
      }
    }
  },
  "$comment": "The preparer enforces strict UTF-8, duplicate-field/name rejection, bounded regular non-symlink input, canonical resolver uniqueness, valid hostname/IP syntax, no CONNECT methods, explicit HTTPS CA trust and IP/wildcard subdomain rules. Schemas do not grant authority."
}
