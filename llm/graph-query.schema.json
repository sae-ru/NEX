{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.invalid/schemas/graph-query.schema.json",
  "title": "NEX checked archived graph queries",
  "oneOf": [
    {
      "$ref": "#/$defs/search"
    },
    {
      "$ref": "#/$defs/subgraph"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol",
        "path",
        "id",
        "hash",
        "context_hash"
      ],
      "properties": {
        "kind": {
          "enum": [
            "module",
            "type",
            "function",
            "endpoint",
            "trait",
            "impl"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "path": {
          "const": ""
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_begin",
        "byte_end"
      ],
      "properties": {
        "byte_begin": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_to",
        "source_hash",
        "source_bytes",
        "byte_begin",
        "byte_end",
        "text",
        "truncated_before",
        "truncated_after",
        "match"
      ],
      "properties": {
        "relative_to": {
          "const": "declaration_source"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "byte_begin": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 2048
        },
        "truncated_before": {
          "type": "boolean"
        },
        "truncated_after": {
          "type": "boolean"
        },
        "match": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/span"
            }
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "limit",
        "total",
        "returned",
        "next_offset",
        "truncated",
        "byte_limited"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "next_offset": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "byte_limited": {
          "type": "boolean"
        }
      }
    },
    "searchNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol",
        "path",
        "id",
        "hash",
        "context_hash",
        "module",
        "file",
        "derived",
        "editable",
        "preview",
        "matched_fields"
      ],
      "properties": {
        "kind": {
          "enum": [
            "module",
            "type",
            "function",
            "endpoint",
            "trait",
            "impl"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "path": {
          "const": ""
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "derived": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "preview": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/preview"
            }
          ]
        },
        "matched_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "symbol",
              "module",
              "file",
              "source"
            ]
          }
        }
      }
    },
    "subgraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol",
        "path",
        "id",
        "hash",
        "context_hash",
        "module",
        "file",
        "derived",
        "editable",
        "preview",
        "distance"
      ],
      "properties": {
        "kind": {
          "enum": [
            "module",
            "type",
            "function",
            "endpoint",
            "trait",
            "impl"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "path": {
          "const": ""
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000]+$"
        },
        "derived": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "preview": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/preview"
            }
          ]
        },
        "distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/reference"
        },
        "target": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_policy",
        "language",
        "namespace",
        "revision",
        "source_hash",
        "query_hash",
        "schema",
        "selection",
        "page",
        "nodes"
      ],
      "properties": {
        "query_policy": {
          "const": "nex.graph-query/1"
        },
        "language": {
          "const": "0.21"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "query_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "schema": {
          "const": "nex.graph-search/1"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "entity",
            "field"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000]+$"
            },
            "entity": {
              "enum": [
                "all",
                "module",
                "type",
                "function",
                "endpoint",
                "trait",
                "impl"
              ]
            },
            "field": {
              "enum": [
                "symbol",
                "source",
                "any"
              ]
            }
          }
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/searchNode"
          }
        }
      }
    },
    "subgraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_policy",
        "language",
        "namespace",
        "revision",
        "source_hash",
        "query_hash",
        "schema",
        "selection",
        "root",
        "depth_limited",
        "boundary_references",
        "node_page",
        "edge_page",
        "nodes",
        "edges"
      ],
      "properties": {
        "query_policy": {
          "const": "nex.graph-query/1"
        },
        "language": {
          "const": "0.21"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "query_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "schema": {
          "const": "nex.subgraph/1"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity",
            "symbol",
            "direction",
            "depth"
          ],
          "properties": {
            "entity": {
              "enum": [
                "module",
                "type",
                "function",
                "endpoint",
                "trait",
                "impl"
              ]
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[^\\u0000]+$"
            },
            "direction": {
              "enum": [
                "dependencies",
                "dependents",
                "both"
              ]
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "root": {
          "$ref": "#/$defs/reference"
        },
        "depth_limited": {
          "type": "boolean"
        },
        "boundary_references": {
          "type": "integer",
          "minimum": 0
        },
        "node_page": {
          "$ref": "#/$defs/page"
        },
        "edge_page": {
          "$ref": "#/$defs/page"
        },
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/subgraphNode"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    }
  }
}
