{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/project-action-1.json",
  "title": "Captured project action and owned-test results",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graph_store_opened": {
          "const": false
        },
        "schema": {
          "const": "nex.project-session/1"
        },
        "action": {
          "enum": [
            "run",
            "debug",
            "profile"
          ]
        },
        "component": {
          "type": "string"
        },
        "plan": {
          "type": "object"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object"
          }
        },
        "native_runtime_image": {},
        "observation": {
          "type": "object"
        },
        "browser_ui_execution_verified": {
          "const": false
        }
      },
      "required": [
        "ok",
        "exit_code",
        "plan_hash",
        "graph_store_opened",
        "schema",
        "action",
        "component",
        "plan",
        "artifacts",
        "native_runtime_image",
        "observation",
        "browser_ui_execution_verified"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graph_store_opened": {
          "const": false
        },
        "schema": {
          "const": "nex.project-test/1"
        },
        "configuration": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "component": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "realm": {
                "enum": [
                  "shared",
                  "client",
                  "server"
                ]
              },
              "native": {
                "type": "boolean"
              },
              "typescript": {
                "type": "boolean"
              },
              "reference": {
                "type": "boolean"
              },
              "reference_skip_reason": {
                "type": "string"
              },
              "reference_error": {
                "type": "object"
              },
              "artifact": {
                "type": "object"
              },
              "plan_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ok": {
                "type": "boolean"
              },
              "observation": {
                "type": "object"
              },
              "typescript_observation": {
                "type": "object"
              },
              "report": {
                "type": "string"
              },
              "response_truncated": {
                "const": true
              }
            },
            "required": [
              "component",
              "name",
              "realm",
              "native",
              "typescript",
              "reference",
              "ok",
              "observation"
            ]
          }
        },
        "test_execution": {
          "const": true
        },
        "effectful_reference_replay": {
          "const": false
        }
      },
      "required": [
        "ok",
        "exit_code",
        "plan_hash",
        "graph_store_opened",
        "schema",
        "configuration",
        "tests",
        "test_execution",
        "effectful_reference_replay"
      ]
    }
  ]
}
