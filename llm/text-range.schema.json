{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.invalid/schemas/text-range.schema.json",
  "title": "NEX stopped-string Unicode scalar range request or capture",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/capture"
    }
  ],
  "$defs": {
    "textStart": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])",
      "maxLength": 19
    },
    "textCount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])(?![\\s\\S])",
      "maxLength": 4
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "path",
        "kind",
        "start",
        "count",
        "type",
        "wire_schema"
      ],
      "properties": {
        "binding": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}(?![\\s\\S])"
        },
        "path": {
          "type": "array",
          "maxItems": 56,
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            ]
          }
        },
        "kind": {
          "const": "text_range"
        },
        "start": {
          "$ref": "#/$defs/textStart"
        },
        "count": {
          "$ref": "#/$defs/textCount"
        },
        "type": {
          "const": "str"
        },
        "wire_schema": {
          "const": {
            "schema": "nex.wire/2",
            "root": "str",
            "records": {},
            "enums": {}
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "path",
        "kind",
        "start",
        "count"
      ],
      "properties": {
        "binding": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}(?![\\s\\S])"
        },
        "path": {
          "type": "array",
          "maxItems": 56,
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            ]
          }
        },
        "kind": {
          "const": "text_range"
        },
        "start": {
          "$ref": "#/$defs/textStart"
        },
        "count": {
          "$ref": "#/$defs/textCount"
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "unavailable": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*(?![\\s\\S])"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "unavailable"
            ]
          }
        },
        {
          "required": [
            "unavailable"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  }
}
