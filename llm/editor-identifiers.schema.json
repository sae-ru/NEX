{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.dev/schema/editor-identifiers-3.json",
  "title": "NEX checked identifiers, signatures and exact word-token classifications",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "language",
    "compiler",
    "revision",
    "entry",
    "files",
    "symbols",
    "expressions",
    "graph_written",
    "source_written",
    "executed",
    "occurrences",
    "identifiers"
  ],
  "properties": {
    "schema": {
      "const": "nex.analysis/3"
    },
    "ok": {
      "const": true
    },
    "language": {
      "enum": [
        "0.25",
        "0.26",
        "0.27",
        "0.28"
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "build"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/hash"
    },
    "entry": {
      "type": "string"
    },
    "graph_written": {
      "const": false
    },
    "source_written": {
      "const": false
    },
    "executed": {
      "const": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "path",
          "hash",
          "text"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "hash": {
            "$ref": "#/$defs/hash"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "symbols": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "name",
          "kind",
          "file",
          "range",
          "selection",
          "detail"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "function",
              "struct",
              "enum",
              "trait",
              "impl",
              "endpoint",
              "resource"
            ]
          },
          "file": {
            "type": "string"
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "selection": {
            "$ref": "#/$defs/range"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "expressions": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "range",
          "type",
          "definition"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "type": {
            "type": "string"
          },
          "definition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/location"
              }
            ]
          }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "range",
          "definition",
          "role"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "definition": {
            "$ref": "#/$defs/location"
          },
          "role": {
            "enum": [
              "declaration",
              "read",
              "write",
              "call",
              "pattern"
            ]
          }
        }
      }
    },
    "identifiers": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "range",
          "kind",
          "detail",
          "definition"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "kind": {
            "enum": [
              "function",
              "struct",
              "enum",
              "trait",
              "impl",
              "endpoint",
              "parameter",
              "local",
              "pattern_binding",
              "field",
              "variant",
              "type_parameter",
              "associated_type",
              "trait_method",
              "import_alias",
              "builtin_type",
              "builtin_bound",
              "builtin_function",
              "literal",
              "syntax",
              "resource"
            ]
          },
          "detail": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            ]
          },
          "definition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/location"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "begin",
        "end"
      ],
      "properties": {
        "begin": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "range"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      }
    }
  }
}
