{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.dev/schemas/cuda-emission.schema.json",
  "title": "Checked scalar CUDA source emission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "kind",
    "language",
    "toolchain",
    "compiler_build",
    "descriptor_hash",
    "revision",
    "entry",
    "kernel",
    "input_layout",
    "parameter_types",
    "result_type",
    "functions",
    "function_map",
    "shader_sha256",
    "source_bytes",
    "driver_initialized",
    "device_executed"
  ],
  "properties": {
    "schema": {
      "const": "nex.cuda-emission/1"
    },
    "ok": {
      "const": true
    },
    "kind": {
      "const": "cuda"
    },
    "language": {
      "const": "0.28"
    },
    "toolchain": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 64
    },
    "compiler_build": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "descriptor_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "kernel": {
      "const": "nex_generated_cuda_map"
    },
    "input_layout": {
      "enum": [
        "rows",
        "columns"
      ]
    },
    "parameter_types": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "i64",
          "f64",
          "bool"
        ]
      }
    },
    "result_type": {
      "type": "string",
      "enum": [
        "i64",
        "f64",
        "bool",
        "unit"
      ]
    },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 8192
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "function_map": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "shader_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "driver_initialized": {
      "const": false
    },
    "device_executed": {
      "const": false
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16777216
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "floating_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "word_encoding",
        "rounding",
        "positive_zero_normalized",
        "nonfinite_status",
        "host_environment_status",
        "owned_provider_transport_accepted"
      ],
      "properties": {
        "format": {
          "const": "finite binary64"
        },
        "word_encoding": {
          "const": "IEEE754 bits"
        },
        "rounding": {
          "const": "nearest_ties_even"
        },
        "positive_zero_normalized": {
          "const": true
        },
        "nonfinite_status": {
          "const": 7
        },
        "host_environment_status": {
          "const": 8
        },
        "owned_provider_transport_accepted": {
          "const": false
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "source"
      ],
      "not": {
        "required": [
          "path"
        ]
      }
    },
    {
      "required": [
        "path"
      ],
      "not": {
        "required": [
          "source"
        ]
      }
    }
  ],
  "$defs": {
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "hash",
        "source_file",
        "source_line",
        "source_column",
        "generated_first_line",
        "generated_last_line"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "symbol": {
          "type": "string",
          "pattern": "^nex_fn_[0-9]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_file": {
          "type": "string",
          "maxLength": 65536
        },
        "source_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "source_column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "generated_first_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "generated_last_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    }
  }
}
