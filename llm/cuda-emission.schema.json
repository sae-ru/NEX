{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.dev/schemas/cuda-emission.schema.json",
  "title": "Checked CUDA source emission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "kind",
    "language",
    "toolchain",
    "compiler_build",
    "descriptor_hash",
    "revision",
    "entry",
    "kernel",
    "input_layout",
    "parameter_types",
    "result_type",
    "functions",
    "function_map",
    "shader_sha256",
    "source_bytes",
    "driver_initialized",
    "device_executed"
  ],
  "properties": {
    "schema": {
      "enum": [
        "nex.cuda-emission/1",
        "nex.cuda-emission/2",
        "nex.cuda-emission/3",
        "nex.cuda-emission/4",
        "nex.cuda-emission/5"
      ]
    },
    "ok": {
      "const": true
    },
    "kind": {
      "const": "cuda"
    },
    "language": {
      "const": "0.28"
    },
    "toolchain": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 64
    },
    "compiler_build": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "descriptor_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "kernel": {
      "const": "nex_generated_cuda_map"
    },
    "input_layout": {
      "enum": [
        "rows",
        "columns"
      ]
    },
    "parameter_types": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "result_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 8192
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "function_map": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "shader_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "driver_initialized": {
      "const": false
    },
    "device_executed": {
      "const": false
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16777216
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "floating_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "word_encoding",
        "rounding",
        "positive_zero_normalized",
        "nonfinite_status",
        "host_environment_status",
        "owned_provider_transport_accepted"
      ],
      "properties": {
        "format": {
          "const": "finite binary64"
        },
        "word_encoding": {
          "const": "IEEE754 bits"
        },
        "rounding": {
          "const": "nearest_ties_even"
        },
        "positive_zero_normalized": {
          "const": true
        },
        "nonfinite_status": {
          "const": 7
        },
        "host_environment_status": {
          "const": 8
        },
        "owned_provider_transport_accepted": {
          "const": false
        }
      }
    },
    "value_abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "word_bytes",
        "byte_order",
        "maximum_words",
        "maximum_depth",
        "inactive_words_zero",
        "parameter_words",
        "result_words",
        "types",
        "text_pool"
      ],
      "properties": {
        "schema": {
          "enum": [
            "nex.cuda-values/1",
            "nex.cuda-values/2",
            "nex.cuda-values/3",
            "nex.cuda-values/4"
          ]
        },
        "word_bytes": {
          "const": 8
        },
        "byte_order": {
          "const": "little"
        },
        "maximum_words": {
          "enum": [
            64,
            4096
          ]
        },
        "maximum_depth": {
          "const": 32
        },
        "inactive_words_zero": {
          "const": true
        },
        "result_failure_status_mask": {
          "const": 2147483648
        },
        "result_code_shift": {
          "const": 10
        },
        "result_text_id_bits": {
          "const": 10
        },
        "parameter_words": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "result_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "type",
              "kind",
              "words"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "kind": {
                "enum": [
                  "scalar",
                  "text_id",
                  "record",
                  "enum",
                  "result",
                  "list",
                  "bytes",
                  "utf8"
                ]
              },
              "words": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "fields": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "offset"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  }
                }
              },
              "element_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "element_words": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "capacity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32760
              },
              "length_offset": {
                "const": 0
              },
              "elements_offset": {
                "const": 1
              },
              "octets_per_word": {
                "const": 8
              },
              "octet_order": {
                "const": "least_significant_first"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "list"
                    }
                  }
                },
                "then": {
                  "required": [
                    "element_type",
                    "element_words",
                    "capacity",
                    "length_offset",
                    "elements_offset"
                  ],
                  "properties": {
                    "capacity": {
                      "maximum": 1024
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "bytes"
                    }
                  }
                },
                "then": {
                  "required": [
                    "capacity",
                    "length_offset",
                    "elements_offset",
                    "octets_per_word",
                    "octet_order"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "utf8"
                    }
                  }
                },
                "then": {
                  "required": [
                    "capacity",
                    "length_offset",
                    "elements_offset",
                    "octets_per_word",
                    "octet_order"
                  ]
                }
              }
            ]
          }
        },
        "text_pool": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32760
          }
        },
        "list_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "list_bounds_status": {
          "const": 9
        },
        "list_capacity_status": {
          "const": 10
        },
        "maximum_words_without_lists": {
          "const": 64
        },
        "byte_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32760
        },
        "byte_index_status": {
          "const": 11
        },
        "byte_slice_status": {
          "const": 12
        },
        "byte_range_status": {
          "const": 13
        },
        "byte_capacity_status": {
          "const": 14
        },
        "maximum_words_without_containers": {
          "const": 64
        },
        "text_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32760
        },
        "text_words": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "diagnostic_words": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8192
        },
        "result_failure_status": {
          "const": 15
        },
        "text_index_status": {
          "const": 16
        },
        "text_slice_status": {
          "const": 17
        },
        "text_capacity_status": {
          "const": 18
        },
        "UTF8_strict": {
          "const": true
        },
        "text_NUL_allowed": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema": {
                "enum": [
                  "nex.cuda-values/2",
                  "nex.cuda-values/3",
                  "nex.cuda-values/4"
                ]
              }
            }
          },
          "then": {
            "required": [],
            "properties": {
              "maximum_words": {
                "const": 4096
              }
            }
          },
          "else": {
            "properties": {
              "maximum_words": {
                "const": 64
              },
              "parameter_words": {
                "items": {
                  "maximum": 64
                }
              },
              "result_words": {
                "maximum": 64
              },
              "types": {
                "items": {
                  "properties": {
                    "words": {
                      "maximum": 64
                    },
                    "kind": {
                      "not": {
                        "enum": [
                          "list",
                          "bytes"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/2"
              }
            }
          },
          "then": {
            "required": [
              "list_capacity",
              "list_bounds_status",
              "list_capacity_status",
              "maximum_words_without_lists"
            ],
            "properties": {
              "types": {
                "items": {
                  "properties": {
                    "kind": {
                      "not": {
                        "const": "bytes"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/3"
              }
            }
          },
          "then": {
            "required": [
              "byte_capacity",
              "byte_index_status",
              "byte_slice_status",
              "byte_range_status",
              "byte_capacity_status",
              "maximum_words_without_containers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "types": {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "list"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "list_capacity",
              "list_bounds_status",
              "list_capacity_status"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/4"
              }
            }
          },
          "then": {
            "required": [
              "text_capacity",
              "text_words",
              "diagnostic_words",
              "result_failure_status",
              "text_index_status",
              "text_slice_status",
              "text_capacity_status",
              "UTF8_strict",
              "text_NUL_allowed"
            ]
          },
          "else": {
            "required": [
              "result_failure_status_mask",
              "result_code_shift",
              "result_text_id_bits"
            ],
            "properties": {
              "text_pool": {
                "items": {
                  "maxLength": 1023
                }
              },
              "types": {
                "items": {
                  "properties": {
                    "kind": {
                      "not": {
                        "const": "utf8"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "source"
      ],
      "not": {
        "required": [
          "path"
        ]
      }
    },
    {
      "required": [
        "path"
      ],
      "not": {
        "required": [
          "source"
        ]
      }
    }
  ],
  "$defs": {
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "hash",
        "source_file",
        "source_line",
        "source_column",
        "generated_first_line",
        "generated_last_line"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "symbol": {
          "type": "string",
          "pattern": "^nex_fn_[0-9]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_file": {
          "type": "string",
          "maxLength": 65536
        },
        "source_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "source_column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "generated_first_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "generated_last_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "enum": [
              "nex.cuda-emission/2",
              "nex.cuda-emission/3",
              "nex.cuda-emission/4",
              "nex.cuda-emission/5"
            ]
          }
        }
      },
      "then": {
        "required": [
          "value_abi"
        ]
      },
      "else": {
        "not": {
          "required": [
            "value_abi"
          ]
        },
        "properties": {
          "parameter_types": {
            "items": {
              "enum": [
                "i64",
                "f64",
                "bool"
              ]
            }
          },
          "result_type": {
            "enum": [
              "i64",
              "f64",
              "bool",
              "unit"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.cuda-emission/2"
          }
        }
      },
      "then": {
        "properties": {
          "value_abi": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.cuda-emission/3"
          }
        }
      },
      "then": {
        "properties": {
          "value_abi": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/2"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.cuda-emission/4"
          }
        }
      },
      "then": {
        "properties": {
          "value_abi": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/3"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.cuda-emission/5"
          }
        }
      },
      "then": {
        "properties": {
          "value_abi": {
            "properties": {
              "schema": {
                "const": "nex.cuda-values/4"
              }
            }
          }
        }
      }
    }
  ]
}
