{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/debug-frame-2.json",
  "title": "NEX stopped frame with exact demand-driven captures",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nex.debug-frame/2"
    },
    "language": {
      "const": "0.11"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "build_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "function": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*(?![\\s\\S])",
      "minLength": 1
    },
    "stop": {
      "type": "object",
      "properties": {
        "process_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(?![\\s\\S])"
        },
        "thread_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(?![\\s\\S])"
        },
        "frame_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stop_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(?![\\s\\S])"
        }
      },
      "required": [
        "process_id",
        "thread_id",
        "frame_id",
        "stop_id"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}(?![\\s\\S])"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "value": {"description": "Exact typed value; types containing callables use nex.debug-wire/1 rather than application JSON."},
          "unavailable": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "unavailable"
              ]
            }
          },
          {
            "required": [
              "unavailable"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "captures": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "binding": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}(?![\\s\\S])"
          },
          "path": {
            "type": "array",
            "maxItems": 56,
            "items": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              ]
            }
          },
          "kind": {
            "enum": [
              "value",
              "shape"
            ]
          },
          "value": {"description": "A full typed value or a checked shape. Callable shape is exactly function plus nonzero decimal identity. Subsequent capture-name paths are checked against that target's environment."},
          "unavailable": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "required": [
          "binding",
          "path",
          "kind"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "unavailable"
              ]
            }
          },
          {
            "required": [
              "unavailable"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "language",
    "revision",
    "build_key",
    "function",
    "stop",
    "bindings",
    "truncated",
    "captures"
  ],
  "additionalProperties": false
}
