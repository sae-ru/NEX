{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/debug-frame-2.json",
  "title": "NEX stopped frame with exact demand-driven captures",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nex.debug-frame/2"
    },
    "language": {
      "enum": [
        "0.24",
        "0.25",
        "0.26",
        "0.27",
        "0.28"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "build_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "function": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*(?![\\s\\S])",
      "minLength": 1
    },
    "stop": {
      "type": "object",
      "properties": {
        "process_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(?![\\s\\S])"
        },
        "thread_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(?![\\s\\S])"
        },
        "frame_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stop_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(?![\\s\\S])"
        }
      },
      "required": [
        "process_id",
        "thread_id",
        "frame_id",
        "stop_id"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}(?![\\s\\S])"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "value": {
            "description": "Exact typed value; types containing callables use nex.debug-wire/1 rather than application JSON."
          },
          "unavailable": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "unavailable"
              ]
            }
          },
          {
            "required": [
              "unavailable"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "captures": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "binding": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}(?![\\s\\S])"
          },
          "path": {
            "type": "array",
            "maxItems": 56,
            "items": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              ]
            }
          },
          "kind": {
            "enum": [
              "value",
              "shape",
              "text_range"
            ]
          },
          "value": {
            "description": "Exact typed value, shape (including Unicode scalar string length), or text_range UTF-8 text of exactly count scalars. Range start/count are canonical nonnegative scalar indices. Callable aliases must agree across overlapping ranges and whole values."
          },
          "unavailable": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          },
          "start": {
            "$ref": "#/$defs/textStart"
          },
          "count": {
            "$ref": "#/$defs/textCount"
          }
        },
        "required": [
          "binding",
          "path",
          "kind"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "unavailable"
              ]
            }
          },
          {
            "required": [
              "unavailable"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "text_range"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "start",
                "count"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "start"
                    ]
                  },
                  {
                    "required": [
                      "count"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "language",
    "revision",
    "build_key",
    "function",
    "stop",
    "bindings",
    "truncated",
    "captures"
  ],
  "additionalProperties": false,
  "$defs": {
    "textStart": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])",
      "maxLength": 19
    },
    "textCount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])(?![\\s\\S])",
      "maxLength": 4
    }
  }
}
