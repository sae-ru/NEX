{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/operations-1.json",
  "title": "Checked NEX operation graph queries",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "nex.operations/1",
        "nex.operation-context/1"
      ]
    },
    "language": {
      "const": "0.7"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "identity_scope": {
      "const": "local_store"
    },
    "identity_policy": {
      "const": "nex.operation-identity/1"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
          },
          "site": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "function": {
            "type": "string"
          },
          "function_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
          },
          "path": {
            "type": "string"
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
          },
          "role": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "definition": {
            "type": [
              "object",
              "null"
            ]
          },
          "definition_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "definition_omitted": {
            "type": "boolean"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "byte_begin": {
                "type": "integer",
                "minimum": 0
              },
              "byte_end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "file",
              "line",
              "column",
              "byte_begin",
              "byte_end"
            ],
            "additionalProperties": false
          },
          "children": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
                },
                "site": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "role": {
                  "type": "string"
                },
                "ordinal": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "site",
                "role",
                "ordinal"
              ],
              "additionalProperties": false
            }
          },
          "child_count": {
            "type": "integer",
            "minimum": 0
          },
          "children_truncated": {
            "type": "boolean"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
                },
                "role": {
                  "enum": [
                    "binding",
                    "callee"
                  ]
                },
                "symbol": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "site",
          "function",
          "function_id",
          "path",
          "parent",
          "role",
          "ordinal",
          "kind",
          "hash",
          "definition",
          "definition_bytes",
          "definition_omitted",
          "location",
          "children",
          "child_count",
          "children_truncated",
          "references"
        ],
        "additionalProperties": false
      }
    },
    "ancestors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
          },
          "site": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "site",
          "path",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "language",
    "revision",
    "source_hash",
    "identity_scope",
    "identity_policy",
    "total",
    "offset",
    "truncated",
    "nodes"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "schema": {
        "const": "nex.operation-context/1"
      }
    }
  },
  "then": {
    "required": [
      "ancestors"
    ]
  }
}
