{
  "schema": "nex.language-pack/1",
  "language_version": "0.13",
  "protocol_version": 2,
  "discovery": "nex describe --json",
  "documents": {
    "specification": "docs/language.md",
    "grammar": "docs/grammar.ebnf",
    "prompt": "llm/SYSTEM_PROMPT.md",
    "workflow": "llm/WORKFLOW.md",
    "task_template": "llm/TASK_TEMPLATE.md",
    "protocol": "docs/protocol.md",
    "patch_schema": "llm/patch.schema.json",
    "web": "docs/web.md",
    "server": "docs/server.md",
    "api": "docs/api.md",
    "debug": "docs/debugging.md",
    "build": "docs/incremental.md",
    "profile": "docs/profiling.md",
    "verification": "docs/verification.md",
    "verification_contract_schema": "llm/verification.schema.json",
    "tasks": "docs/tasks.md",
    "task_schema": "llm/task.schema.json",
    "expressions": "docs/expressions.md",
    "debug_frame_schema": "llm/debug-frame.schema.json",
    "partial_debug_frame_schema": "llm/debug-frame-v2.schema.json",
    "debug_wire_schema": "llm/debug-wire.schema.json",
    "operations": "docs/operations.md",
    "operations_schema": "llm/operations.schema.json",
    "native_toolchain_schema": "llm/toolchain.schema.json",
    "toolchain_catalog_schema": "llm/toolchains.schema.json",
    "linux": "docs/linux.md",
    "linux_recipe": "tools/linux/Dockerfile",
    "linux_check": "tools/linux/check.py",
    "linux_verify": "tools/linux/verify.py",
    "linux_sdk_smoke": "tools/linux/sdk_smoke.py",
    "matching": "docs/matching.md",
    "functions": "docs/functions.md",
    "sdk_handoff": "docs/sdk.md",
    "sdk_acceptance": "tools/sdk_acceptance.py",
    "host_sdk_schema": "llm/sdk-host.schema.json",
    "sdk_bundle": "tools/sdk_bundle.py",
    "linux_sdk_bundle": "tools/linux/bundle.py",
    "application_packaging": "docs/packaging.md",
    "application_packager": "tools/app_bundle.py",
    "application_package_schema": "llm/application-package.schema.json",
    "application_package_acceptance": "tools/application_acceptance.py",
    "files": "docs/files.md",
    "bytes": "docs/bytes.md"
  },
  "document_access": "nex guide --kind prompt|language|grammar|protocol|web|server|api|debug|build|profile|verify|task|expression|operation|linux|match|function|files|bytes --json",
  "context_command": "nex context --symbol NAME",
  "examples": {
    "binary_browser": "examples/bytes-web.nex",
    "core": "examples/arithmetic.nex",
    "data": "examples/data.nex",
    "modules": "examples/modules/main.nex",
    "results_and_json": "examples/results.nex",
    "browser": "examples/web/main.nex",
    "server": "examples/server/main.nex",
    "fullstack_client": "examples/fullstack/client.nex",
    "fullstack_server": "examples/fullstack/server.nex",
    "api_service": "examples/api/service.nex",
    "api_client_generate_first": "examples/api/client.nex",
    "debugging": "examples/debugging/main.nex",
    "profiling": "examples/profiling/main.nex",
    "verification": "examples/verification/main.nex",
    "verification_contract": "examples/verification/contracts.json",
    "task_source": "examples/tasks/main.nex",
    "task_contract": "examples/tasks/task.json",
    "task_proof": "examples/tasks/proof.json",
    "large_debug_values": "examples/debugging/large.nex",
    "operations": "examples/operations/main.nex",
    "enums": "examples/enums/main.nex",
    "generics": "examples/generics/main.nex",
    "generic_browser": "examples/generics/web.nex",
    "constraints": "examples/constraints.nex",
    "matching": "examples/matching.nex",
    "functions": "examples/functions/main.nex",
    "function_browser": "examples/functions/web.nex",
    "numbers": "examples/numbers.nex",
    "numeric_browser": "examples/numbers-web.nex",
    "text_files": "examples/files.nex",
    "bytes": "examples/bytes.nex"
  },
  "patch_command": "nex apply --patch FILE --json",
  "validation_commands": [
    "nex check FILE --json",
    "nex test --revision HEAD --json",
    "nex build --revision HEAD --json"
  ],
  "web_validation_commands": [
    "nex test FILE --target web --json",
    "nex build FILE --target web --profile release --json"
  ],
  "server_validation_commands": [
    "nex test FILE --json",
    "nex build FILE --target server --profile release --json"
  ],
  "api_commands": [
    "nex api FILE --json",
    "nex api FILE --directory NEW_DIRECTORY --json"
  ],
  "debug_commands": [
    "nex debug FILE --kind dap --json",
    "nex debug FILE -- --no-lldbinit",
    "nex-values [inside LLDB at a stopped frame]",
    "nex debug FILE --kind nex-dap --json"
  ],
  "profile_commands": [
    "nex profile FILE --scenario TEXT --json",
    "nex build FILE --profile profile --json"
  ],
  "verification_commands": [
    "nex contract FILE --symbol NAME -o CONTRACT.json",
    "nex verify FILE --contracts CONTRACT.json --json"
  ],
  "task_commands": [
    "nex task FILE.nex --kind init -o task.json",
    "nex task task.json --kind check --json",
    "nex task task.json --kind run --task-hash HASH --json",
    "nex task RECEIPT.json --kind replay --json",
    "nex task task.json --kind history --json"
  ],
  "expression_commands": [
    "nex inspect FRAME.json --manifest DEBUG.json --expression TEXT --kind plan --json",
    "nex inspect FRAME.json --manifest DEBUG.json --expression TEXT --kind demand --json",
    "nex inspect FRAME.json --manifest DEBUG.json --expression TEXT --json",
    "nex-eval NEX_EXPRESSION (at an LLDB stop)",
    "nex-frame NEX_EXPRESSION (at an LLDB stop)"
  ],
  "operation_commands": [
    "nex operations --symbol NAME --offset 0 --limit 100 --json",
    "nex context --operation ID --revision REVISION --json",
    "nex context --site SITE --revision REVISION --json",
    "nex-operation (at an LLDB stop)"
  ],
  "toolchain_commands": [
    "nex toolchain FILE --json",
    "nex task TASK.json --kind check --toolchains CATALOG.json --json",
    "nex task TASK.json --kind run --toolchains CATALOG.json --json",
    "nex task RECEIPT.json --kind replay --toolchains CATALOG.json --json"
  ]
}
