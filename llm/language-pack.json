  "patch_command": "nex apply --patch FILE --json",
  "validation_commands": [
    "nex check FILE --json",
    "nex test --revision HEAD --json",
    "nex build --revision HEAD --json"
  ],
  "web_validation_commands": [
    "nex test FILE --target web --json",
    "nex build FILE --target web --profile release --json"
  ],
  "server_validation_commands": [
    "nex test FILE --json",
    "nex build FILE --target server --profile release --json"
  ],
  "api_commands": [
    "nex api FILE --json",
    "nex api FILE --directory NEW_DIRECTORY --json"
  ],
  "debug_commands": [
    "nex debug FILE --kind dap --json",
    "nex debug FILE -- --no-lldbinit",
    "nex-values [inside LLDB at a stopped frame]",
    "nex debug FILE --kind nex-dap --json"
  ],
  "profile_commands": [
    "nex profile FILE --scenario TEXT --json",
    "nex build FILE --profile profile --json"
  ],
  "verification_commands": [
    "nex contract FILE --symbol NAME -o CONTRACT.json",
    "nex verify FILE --contracts CONTRACT.json --json"
  ],
  "task_commands": [
    "nex task FILE.nex --kind init -o task.json",
    "nex task task.json --kind check --json",
    "nex task task.json --kind run --task-hash HASH --json",
    "nex task RECEIPT.json --kind replay --json",
    "nex task task.json --kind history --json"
  ],
  "expression_commands": [
    "nex inspect FRAME.json --manifest DEBUG.json --expression TEXT --kind plan --json",
    "nex inspect FRAME.json --manifest DEBUG.json --expression TEXT --kind demand --json",
    "nex inspect FRAME.json --manifest DEBUG.json --expression TEXT --json",
    "nex-eval NEX_EXPRESSION (at an LLDB stop)",
    "nex-frame NEX_EXPRESSION (at an LLDB stop)"
  ],
  "operation_commands": [
    "nex operations --symbol NAME --offset 0 --limit 100 --json",
    "nex context --operation ID --revision REVISION --json",
    "nex context --site SITE --revision REVISION --json",
    "nex-operation (at an LLDB stop)"
  ],
  "toolchain_commands": [
    "nex toolchain FILE --json",
    "nex task TASK.json --kind check --toolchains CATALOG.json --json",
    "nex task TASK.json --kind run --toolchains CATALOG.json --json",
    "nex task RECEIPT.json --kind replay --toolchains CATALOG.json --json"
  ],
  "foreign_signature_command": "nex ffi FILE --symbol NAME --json",
  "foreign_catalogue_command": "nex foreign HOST.json --json",
  "task_foreign_commands": [
    "nex task task.json --kind check --foreign HOST.json --json",
    "nex task task.json --kind run --task-hash HASH --foreign HOST.json --json",
    "nex task RECEIPT.json --kind replay --foreign CURRENT_HOST.json --json"
  ],
  "graph_commands": [
    "nex declarations --entity type --symbol MODULE::TYPE --json",
    "nex context --entity module --symbol MODULE --json",
    "nex identities --entity module --symbol MODULE --offset 0 --limit 100 -o PAGE.json",
    "nex identities --kind reconcile --manifest PAGE.json --expected-revision HEAD_HASH --json",
    "nex identities --kind resolve --origin NAMESPACE --from-revision SOURCE_HASH --node ID --json"
  ],
  "patch_entities": [
    "function",
    "endpoint",
    "type",
    "operation"
  ],
  "type_patch_example": "examples/type-patches/patch.json",
  "native_diagnostic_commands": [
    "nex run FILE --json",
    "nex diagnose --revision HASH --manifest DEBUG.json --log STDERR.log --json"
  ],
  "operation_patch_example": "examples/operation-patches/README.md",
  "history_commands": [
    "nex changes --offset 0 --limit 100 --json",
    "nex restore --revision HASH --expected-revision HEAD_HASH --note TEXT --json"
  ],
  "snapshot_commands": [
    "nex snapshot --directory NEW_SNAPSHOT --timeout 60 --json",
    "nex recover SNAPSHOT --directory NEW_PROJECT --timeout 60 --json"
  ],
  "migration_workflow": [
    "matching-old-sdk check --json",
    "matching-old-sdk graph --json > archived-graph.json",
    "nex snapshot --directory NEW_BACKUP --json",
    "nex migrate --json",
    "nex test --revision HEAD --json",
    "nex export --revision HEAD --directory NEW_CURRENT_PROJECT --json"
  ]
}
