{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.application-package/1",
  "title": "NEX native application package",
  "type": "object",
  "required": [
    "schema",
    "assembly_passed",
    "execution_verified",
    "entry",
    "toolchain",
    "language",
    "revision",
    "build_key",
    "compiler_build",
    "profile",
    "kind",
    "compiler_target",
    "host_compatible",
    "binary_sha256",
    "platform",
    "components",
    "system_libraries",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "nex.application-package/1"
    },
    "assembly_passed": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "entry": {
      "enum": [
        "bin/app",
        "bin/app.exe"
      ]
    },
    "toolchain": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "foreign_projection": {
      "$ref": "https://nex.dev/schemas/foreign-projection-1.json"
    },
    "build_key": {
      "type": "string"
    },
    "compiler_build": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "debug",
        "release",
        "profile"
      ]
    },
    "kind": {
      "enum": [
        "executable",
        "http_server"
      ]
    },
    "compiler_target": {
      "type": "string"
    },
    "host_compatible": {
      "type": "boolean"
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "enum": [
        "macos",
        "linux",
        "windows"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "url",
          "license_files"
        ]
      }
    },
    "system_libraries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "sha256",
              "bytes",
              "executable"
            ]
          },
          {
            "required": [
              "symlink"
            ]
          }
        ]
      }
    },
    "architecture": {
      "enum": [
        "x86_64",
        "arm64"
      ]
    },
    "static_link_inputs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "bytes",
          "component"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "component": {
            "type": "string"
          }
        }
      }
    }
  }
}
