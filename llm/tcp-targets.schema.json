{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.tcp-targets/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "endpoints"
  ],
  "properties": {
    "schema": {
      "const": "nex.tcp-targets/1"
    },
    "maximum_connections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 16
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address",
          "port"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "address": {
            "type": "string",
            "description": "Exact numeric IPv4/IPv6 without zone ID; enforced by preparer"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  },
  "$comment": "Preparer additionally rejects duplicate JSON fields, duplicate endpoint names, nonregular/symlink files, invalid UTF-8 and more than1MiB."
}
