{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/server-workload-result-1.json",
  "title": "Native server workload metrics inside a checked profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nex.server-workload-result/1"
    },
    "ok": {
      "type": "boolean"
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runner_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planned_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "completed_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "warmup_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "phases": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "requests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "duration_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "requests_per_second": {
            "type": "number",
            "minimum": 0
          },
          "latency_ns": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0
              },
              "p50": {
                "type": "number",
                "minimum": 0
              },
              "p95": {
                "type": "number",
                "minimum": 0
              },
              "p99": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "min",
              "p50",
              "p95",
              "p99",
              "max"
            ]
          },
          "samples_ns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        "required": [
          "concurrency",
          "iterations",
          "requests",
          "duration_ns",
          "requests_per_second",
          "latency_ns",
          "samples_ns"
        ]
      }
    },
    "connection_policy": {
      "const": "one HTTP/1.1 connection per request; no redirect or retry"
    },
    "authorization_values_captured": {
      "const": false
    },
    "request_payloads_captured": {
      "const": false
    },
    "loopback_only": {
      "const": true
    },
    "native_child_inherits_supervised_group": {
      "const": true
    },
    "server_exit_code": {
      "type": "integer"
    },
    "forced_stop": {
      "const": true
    },
    "all_expectations_met": {
      "type": "boolean"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "schema",
    "ok",
    "definition_sha256",
    "runner_sha256",
    "planned_requests",
    "completed_requests",
    "warmup_completed",
    "phases",
    "connection_policy",
    "authorization_values_captured",
    "request_payloads_captured",
    "loopback_only",
    "native_child_inherits_supervised_group",
    "all_expectations_met"
  ],
  "description": "Compiler-pinned workload evidence under observation.workload and in the full saved profile. Warmup is included in completed_requests and profile calls, excluded from phase latency statistics. A phase is appended only when all its requests meet expectations. Errors contain no response body or authorization value. Timeout/output/signal before a complete profile produces the ordinary bounded NEX diagnostic rather than inventing metrics."
}
