module typed_errors;
struct InputError { text: str; }
fn read_answer(text: str) -> i64 !{throw} {
    if text == "42" { return 42; }
    throw(InputError(text));
}
fn main() -> unit !{io,throw} {
    try { read_answer("invalid"); }
    catch(error: InputError) if error.text == "invalid" { print("caught"); }
    finally { print("finished"); }
}
test fn typed_value_and_finally() -> unit !{throw} {
    assert(read_answer("42") == 42);
    var caught: bool = false;
    var finalized: bool = false;
    try { read_answer("bad"); }
    catch(error: InputError) { assert(error.text == "bad"); caught = true; }
    finally { finalized = true; }
    assert(caught && finalized);
}
