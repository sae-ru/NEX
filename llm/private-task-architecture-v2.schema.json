{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.private-task-architecture/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "application", "components"],
  "properties": {
    "schema": {"const": "nex.private-task-architecture/2"},
    "mode": {"const": "mixed-fixed"},
    "application": {"type": "string", "minLength": 1, "maxLength": 64},
    "components": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,64}$"},
      "additionalProperties": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "strings": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "units", "exports", "dependencies", "linkage"],
      "properties": {
        "entry": {"type": "string", "minLength": 1},
        "units": {"allOf": [{"$ref": "#/$defs/strings"}], "minItems": 1},
        "exports": {"$ref": "#/$defs/strings"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "linkage": {"enum": ["application", "static", "shared"]}
      }
    }
  },
  "description": "Explicit private025 mixed fixed images. Checked source ownership and dependency frontiers must derive unique component/function image ownership. The root alone has application linkage. Static diamonds within one image are deduplicated; two loaded copies are rejected. Not public project selection or binary-only verification."
}
