{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/task-workload-state-1.json",
  "title": "Synthetic per-check server state; no credential values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nex.task-workload-state/1"
    },
    "user": {
      "const": "nex-task-workload"
    },
    "credential_scope": {
      "const": "fresh synthetic user per check"
    },
    "database_scope": {
      "const": "fresh owned database per check"
    },
    "credentials_captured": {
      "const": false
    },
    "database_captured": {
      "const": false
    },
    "server_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  },
  "required": [
    "schema",
    "user",
    "credential_scope",
    "database_scope",
    "credentials_captured",
    "database_captured",
    "server_workers"
  ]
}
