{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEX installed host SDK paths",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tools",
    "sqlite",
    "openssl"
  ],
  "properties": {
    "schema": {
      "const": "nex.sdk-host/1"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "archiver"
      ],
      "properties": {
        "compiler": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "archiver": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "linker": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "debug_packager": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "wasm_linker": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        }
      }
    },
    "sqlite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "library"
      ],
      "properties": {
        "include": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "library": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        }
      }
    },
    "openssl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "ssl",
        "crypto"
      ],
      "properties": {
        "include": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "ssl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "crypto": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        }
      }
    }
  },
  "$comment": "Paths are relative to the executable installation prefix. They must resolve to existing files/directories contained in that prefix. Linux requires linker; macOS requires debug_packager."
}
