{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/task-debug-catalog-1.json",
  "title": "NEX exact original-provider task debug catalog",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nex.task-debug-catalog/1"
    },
    "registry_abi": {
      "const": 1
    },
    "catalog_abi": {
      "const": 2
    },
    "mode": {
      "enum": [
        "static",
        "shared-fixed"
      ]
    },
    "artifact_kind": {
      "enum": [
        "code-archive",
        "pic-stage",
        "shared-image",
        "application"
      ]
    },
    "owner_image": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "registries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
          },
          "accessor": {
            "type": "string",
            "pattern": "^nex_task_debug_registry_[A-Za-z_][A-Za-z_0-9]{0,63}_v1$"
          },
          "owner_image": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "codes": {
            "type": "array",
            "maxItems": 16384,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                "function_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "function_source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_unit_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "debug_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                "contract": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "task_debug": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[^\\u0000]*$"
                    },
                    "slot_count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65536
                    },
                    "bindings": {
                      "type": "array",
                      "maxItems": 65536,
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "slot": {
                            "type": "integer",
                            "minimum": -1,
                            "maximum": 65535
                          },
                          "name": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}$"
                          },
                          "type": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "pattern": "^[^\\u0000]*$"
                          },
                          "scope": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "depth": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "opaque": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "slot",
                          "name",
                          "type",
                          "scope",
                          "depth",
                          "opaque"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "points": {
                      "type": "array",
                      "maxItems": 262144,
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "pc": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "line": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "column": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "begin": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "kind": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 5
                          },
                          "phase": {
                            "enum": [
                              "entry",
                              "statement",
                              "loop_test",
                              "call_entry",
                              "resume",
                              "return"
                            ]
                          },
                          "site": {
                            "type": "string",
                            "maxLength": 4096,
                            "pattern": "^[^\\u0000]*$"
                          },
                          "visible": {
                            "type": "array",
                            "maxItems": 65536,
                            "uniqueItems": true,
                            "items": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        },
                        "required": [
                          "id",
                          "pc",
                          "line",
                          "column",
                          "begin",
                          "end",
                          "kind",
                          "phase",
                          "site",
                          "visible"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "file",
                    "slot_count",
                    "bindings",
                    "points"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "function_hash",
                "function_source_hash",
                "source_unit_hash",
                "debug_path",
                "contract",
                "task_debug"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "component",
          "accessor",
          "owner_image",
          "codes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "registry_abi",
    "catalog_abi",
    "mode",
    "artifact_kind",
    "owner_image",
    "registries"
  ],
  "additionalProperties": false
}
