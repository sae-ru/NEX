{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/frontend-diagnostics-1.json",
  "title": "NEX CLI errors and captured-source frontend context",
  "description": "Content references are not graph identities or authenticated provenance. Compiler enforces byte limits and source-range/content agreement. Project completeness means loaded source closure; fragment completeness means supplied input. Preview output is bounded, not all outer messages or compiler inputs.",
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "enum": [
            "utf-8",
            "base64"
          ]
        },
        "data": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "truncated": {
          "type": "boolean"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "encoding",
        "data",
        "bytes",
        "truncated",
        "hash"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "utf-8"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "maxLength": 1024
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "maxLength": 1368,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/label"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "utf8": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "hash",
        "bytes",
        "utf8"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "diagnostic_span"
        },
        "byte_begin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "kind",
        "byte_begin",
        "byte_end"
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byte_begin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "encoding": {
          "enum": [
            "utf-8",
            "base64"
          ]
        },
        "data": {
          "type": "string"
        },
        "truncated_before": {
          "type": "boolean"
        },
        "truncated_after": {
          "type": "boolean"
        },
        "focus_fully_visible": {
          "type": "boolean"
        }
      },
      "required": [
        "byte_begin",
        "byte_end",
        "encoding",
        "data",
        "truncated_before",
        "truncated_after",
        "focus_fully_visible"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "utf-8"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "maxLength": 4096
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "maxLength": 5464,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "build": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "version",
        "build"
      ]
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "build_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "frame_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "stop_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "function_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "revision",
        "build_key",
        "frame_hash",
        "stop_hash",
        "function_hash"
      ]
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "nex.frontend-diagnostic/1"
        },
        "language": {
          "const": "0.16"
        },
        "phase": {
          "enum": [
            "load",
            "parse",
            "bind",
            "check"
          ]
        },
        "input_kind": {
          "enum": [
            "project",
            "unit",
            "expression",
            "statement",
            "pattern",
            "type"
          ]
        },
        "entry": {
          "$ref": "#/$defs/label"
        },
        "source_inputs_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "input_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "source_inputs_complete": {
          "type": "boolean"
        },
        "reported_key": {
          "$ref": "#/$defs/label"
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        },
        "location": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/location"
            }
          ]
        },
        "preview": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/preview"
            }
          ]
        },
        "code_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "message_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "compiler": {
          "$ref": "#/$defs/compiler"
        },
        "watch": {
          "$ref": "#/$defs/watch"
        }
      },
      "required": [
        "schema",
        "language",
        "phase",
        "input_kind",
        "entry",
        "source_inputs_hash",
        "input_files",
        "input_bytes",
        "source_inputs_complete",
        "reported_key",
        "source",
        "location",
        "preview",
        "code_hash",
        "message_hash",
        "id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "location": {
                "type": "null"
              },
              "preview": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "preview": {
                "$ref": "#/$defs/preview"
              }
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "nex.diagnostic/1"
        },
        "ok": {
          "const": false
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "operation_site": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
        },
        "frontend": {
          "$ref": "#/$defs/frontend"
        },
        "escaped_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "code",
              "message",
              "file",
              "stdout"
            ]
          }
        }
      },
      "required": [
        "schema",
        "ok",
        "code",
        "message",
        "line",
        "column",
        "file",
        "stdout"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "operation_site"
            ]
          },
          "then": {
            "required": [
              "revision",
              "source_hash"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/diagnostic"
    },
    {
      "$ref": "#/$defs/frontend"
    }
  ]
}
