{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nex.local/schemas/task-package-notices-1.json",
  "title":"Captured package notice catalogue and project-confined license text",
  "description":"Data only. Compiler additionally checks byte bounds, canonical roots, unique names, exact license references, snapshot hash and saved-input identity.",
  "type":"object","additionalProperties":false,"required":["schema","catalogue","files"],
  "properties":{
    "schema":{"const":"nex.task-package-notices/1"},
    "catalogue":{
      "type":"object","additionalProperties":false,"required":["schema","components"],
      "properties":{
        "schema":{"const":"nex.sdk-notices/1"},
        "components":{"type":"array","minItems":1,"maxItems":128,"items":{
          "type":"object","additionalProperties":false,"required":["name","version","url","roots","license_files"],
          "properties":{
            "name":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,80}$"},
            "version":{"type":"string","minLength":1,"maxLength":8192},
            "url":{"type":"string","minLength":1,"maxLength":8192},
            "roots":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"string","minLength":1,"maxLength":8192}},
            "license_files":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","pattern":"^licenses/[0-9]{1,4}\\.txt$"}}
          }
        }}
      }
    },
    "files":{"type":"object","minProperties":1,"maxProperties":256,"propertyNames":{"pattern":"^licenses/[0-9]{1,4}\\.txt$"},"additionalProperties":{"type":"string","maxLength":1048576}}
  }
}
