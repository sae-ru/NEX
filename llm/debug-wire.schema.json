{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/debug-wire-1.json",
  "title": "NEX debug value type descriptor, including checked callable targets",
  "description": "Language 0.10 callable debug values. Application JSON continues to use nex.wire/2 and rejects callables. The compiler checks nominal layouts, callable signatures, compiled entries, identities and resource budgets beyond this structural schema.",
  "type": "object",
  "required": ["schema", "root", "records", "enums", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "nex.debug-wire/1"},
    "root": {"$ref": "#/$defs/type"},
    "records": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/fields"}
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object", "required": ["name", "fields"], "additionalProperties": false,
          "properties": {"name": {"$ref": "#/$defs/name"}, "fields": {"$ref": "#/$defs/fields"}}
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["type", "symbol", "compiled", "captures"],
        "additionalProperties": false,
        "properties": {
          "type": {"$ref": "#/$defs/name"},
          "symbol": {"$ref": "#/$defs/name"},
          "compiled": {"type": "boolean"},
          "captures": {"$ref": "#/$defs/fields"}
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*(?![\\s\\S])"},
    "fields": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "required": ["name", "type"], "additionalProperties": false,
        "properties": {"name": {"$ref": "#/$defs/name"}, "type": {"$ref": "#/$defs/type"}}
      }
    },
    "type": {
      "oneOf": [
        {"enum": ["i64", "bool", "str"]},
        {"type": "object", "required": ["list"], "additionalProperties": false,
         "properties": {"list": {"$ref": "#/$defs/type"}}},
        {"type": "object", "required": ["result"], "additionalProperties": false,
         "properties": {"result": {"$ref": "#/$defs/type"}}},
        {"type": "object", "required": ["record"], "additionalProperties": false,
         "properties": {"record": {"$ref": "#/$defs/name"}}},
        {"type": "object", "required": ["enum"], "additionalProperties": false,
         "properties": {"enum": {"$ref": "#/$defs/name"}}},
        {"type": "object", "required": ["function"], "additionalProperties": false,
         "properties": {"function": {"$ref": "#/$defs/name"}}}
      ]
    },
    "stopped_identity": {
      "description": "Nonzero canonical decimal u64 object identity. The compiler also enforces the u64 upper bound.",
      "type": "string", "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
    },
    "stopped_callable_shape": {
      "type": "object", "required": ["function", "identity"], "additionalProperties": false,
      "properties": {"function": {"$ref": "#/$defs/name"}, "identity": {"$ref": "#/$defs/stopped_identity"}}
    },
    "stopped_callable": {
      "description": "Each capture is recursively decoded using its checked target's capture type. Native addresses are not executable wire data.",
      "type": "object", "required": ["function", "identity", "captures"], "additionalProperties": false,
      "properties": {
        "function": {"$ref": "#/$defs/name"}, "identity": {"$ref": "#/$defs/stopped_identity"},
        "captures": {"type": "object"}
      }
    }
  }
}
