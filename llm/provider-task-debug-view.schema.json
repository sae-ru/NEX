{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/provider-task-debug-view-2.json",
  "title": "NEX fixed loaded task provider catalog and source union",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nex.task-debug-view/2"
    },
    "abi": {
      "const": 2
    },
    "catalog_symbol": {
      "const": "nex_task_debug_catalog_v2"
    },
    "marker_symbol": {
      "const": "nex_task_debug_stop_marker"
    },
    "metadata_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,128}$"
    },
    "deadline_advances_while_stopped": {
      "const": true
    },
    "maximum_codes": {
      "const": 16384
    },
    "maximum_points": {
      "const": 262144
    },
    "maximum_bindings": {
      "const": 65536
    },
    "maximum_visible_bindings": {
      "const": 1048576
    },
    "registry_abi": {
      "const": 1
    },
    "catalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://nex.local/schemas/task-debug-catalog-1.json",
      "title": "NEX exact original-provider task debug catalog",
      "type": "object",
      "properties": {
        "schema": {
          "const": "nex.task-debug-catalog/1"
        },
        "registry_abi": {
          "const": 1
        },
        "catalog_abi": {
          "const": 2
        },
        "mode": {
          "enum": [
            "static",
            "shared-fixed"
          ]
        },
        "artifact_kind": {
          "enum": [
            "code-archive",
            "pic-stage",
            "shared-image",
            "application"
          ]
        },
        "owner_image": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "registries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
              },
              "accessor": {
                "type": "string",
                "pattern": "^nex_task_debug_registry_[A-Za-z_][A-Za-z_0-9]{0,63}_v1$"
              },
              "owner_image": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "codes": {
                "type": "array",
                "maxItems": 16384,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[^\\u0000]*$"
                    },
                    "function_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "function_source_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "source_unit_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "debug_path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[^\\u0000]*$"
                    },
                    "contract": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "task_debug": {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^[^\\u0000]*$"
                        },
                        "slot_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65536
                        },
                        "bindings": {
                          "type": "array",
                          "maxItems": 65536,
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "slot": {
                                "type": "integer",
                                "minimum": -1,
                                "maximum": 65535
                              },
                              "name": {
                                "type": "string",
                                "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,255}$"
                              },
                              "type": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4096,
                                "pattern": "^[^\\u0000]*$"
                              },
                              "scope": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "depth": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "opaque": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "id",
                              "slot",
                              "name",
                              "type",
                              "scope",
                              "depth",
                              "opaque"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "points": {
                          "type": "array",
                          "maxItems": 262144,
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "pc": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "line": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "column": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "begin": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "end": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "kind": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 5
                              },
                              "phase": {
                                "enum": [
                                  "entry",
                                  "statement",
                                  "loop_test",
                                  "call_entry",
                                  "resume",
                                  "return"
                                ]
                              },
                              "site": {
                                "type": "string",
                                "maxLength": 4096,
                                "pattern": "^[^\\u0000]*$"
                              },
                              "visible": {
                                "type": "array",
                                "maxItems": 65536,
                                "uniqueItems": true,
                                "items": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              }
                            },
                            "required": [
                              "id",
                              "pc",
                              "line",
                              "column",
                              "begin",
                              "end",
                              "kind",
                              "phase",
                              "site",
                              "visible"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "file",
                        "slot_count",
                        "bindings",
                        "points"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "function_hash",
                    "function_source_hash",
                    "source_unit_hash",
                    "debug_path",
                    "contract",
                    "task_debug"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "component",
              "accessor",
              "owner_image",
              "codes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "registry_abi",
        "catalog_abi",
        "mode",
        "artifact_kind",
        "owner_image",
        "registries"
      ],
      "additionalProperties": false
    },
    "source_union": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://nex.local/schemas/task-debug-source-union-1.json",
      "title": "NEX checked component source union",
      "type": "object",
      "properties": {
        "schema": {
          "const": "nex.task-debug-source-union/1"
        },
        "mode": {
          "enum": [
            "static",
            "shared-fixed"
          ]
        },
        "artifact_kind": {
          "enum": [
            "code-archive",
            "pic-stage",
            "shared-image",
            "application"
          ]
        },
        "owner_image": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
              },
              "owner_image": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "exports": {
                "type": "array",
                "maxItems": 16384,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                }
              },
              "language": {
                "enum": [
                  "0.19",
                  "0.20",
                  "0.21",
                  "0.22",
                  "0.23"
                ]
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bundle_file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
              },
              "bundle_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "definitions": {
                "type": "array",
                "maxItems": 16384,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[^\\u0000]*$"
                    },
                    "function_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "function_source_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "source_unit_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "debug_path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[^\\u0000]*$"
                    },
                    "contract": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "retained": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "function_hash",
                    "function_source_hash",
                    "source_unit_hash",
                    "debug_path",
                    "contract",
                    "line",
                    "retained"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "component",
              "owner_image",
              "entry",
              "exports",
              "language",
              "revision",
              "source_hash",
              "bundle_file",
              "bundle_hash",
              "definitions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "mode",
        "artifact_kind",
        "owner_image",
        "components"
      ],
      "additionalProperties": false
    },
    "catalog_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_union_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_image": {
      "type": "object",
      "properties": {
        "component": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\u0000]*$"
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,128}$"
        },
        "kind": {
          "enum": [
            "application",
            "shared-image",
            "runtime"
          ]
        }
      },
      "required": [
        "component",
        "path",
        "key",
        "hash",
        "sha256",
        "uuid",
        "kind"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "^[^\\u0000]*$"
          },
          "key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{16,128}$"
          },
          "kind": {
            "enum": [
              "application",
              "shared-image",
              "runtime"
            ]
          }
        },
        "required": [
          "component",
          "path",
          "key",
          "hash",
          "sha256",
          "uuid",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "registries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
          },
          "accessor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          },
          "owner_image": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
          },
          "first_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "code_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          }
        },
        "required": [
          "component",
          "accessor",
          "owner_image",
          "first_code",
          "code_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "abi",
    "catalog_symbol",
    "marker_symbol",
    "metadata_hash",
    "image_sha256",
    "image_uuid",
    "deadline_advances_while_stopped",
    "maximum_codes",
    "maximum_points",
    "maximum_bindings",
    "maximum_visible_bindings",
    "registry_abi",
    "catalog",
    "source_union",
    "catalog_hash",
    "source_union_hash",
    "runtime_image",
    "images",
    "registries"
  ],
  "additionalProperties": false
}
