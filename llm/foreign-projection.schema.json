{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.dev/schemas/foreign-projection-1.json",
  "title": "NEX checked native packaging source projection",
  "type": "object",
  "required": [
    "schema",
    "source_revision",
    "packaged_revision",
    "source_hash",
    "packaged_source_hash",
    "catalogue_hash",
    "changes",
    "preparation"
  ],
  "properties": {
    "schema": {
      "const": "nex.foreign-projection/1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packaged_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packaged_source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalogue_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "function",
          "library",
          "export",
          "source_manifest_sha256",
          "manifest_sha256"
        ],
        "properties": {
          "function": {
            "type": "string"
          },
          "library": {
            "type": "string"
          },
          "export": {
            "type": "string"
          },
          "source_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "preparation": {
      "$ref": "https://nex.dev/schemas/foreign-package-1.json"
    },
    "scope": {
      "const": "project"
    },
    "source_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Only exact external manifest literal tokens change. Source packages retain original/derived graph revisions without moving HEAD. Project scope preserves source files, locks and the Store, and projects the same physical declarations across all selected components; changes may be empty for an unaffected component. Actual per-application grants remain limited to its reachable exports.",
  "allOf": [
    {
      "if": {
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "source_plan_hash"
        ]
      },
      "else": {
        "properties": {
          "changes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
