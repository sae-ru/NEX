{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.dev/schemas/foreign-catalogue-report-1.json",
  "title": "NEX read-only operator catalogue report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hash",
    "platform",
    "normalized_catalogue",
    "libraries",
    "files",
    "bytes",
    "module_initialization"
  ],
  "properties": {
    "schema": {
      "const": "nex.foreign-catalogue-report/1"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "platform": {
      "enum": [
        "macos-arm64",
        "macos-x86_64",
        "linux-arm64",
        "linux-x86_64"
      ]
    },
    "normalized_catalogue": {
      "$ref": "foreign-host.schema.json"
    },
    "libraries": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest_sha256",
          "exports"
        ],
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "exports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,127}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8190
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 134217728
    },
    "module_initialization": {
      "const": false
    }
  },
  "description": "Inspection verifies grants and all pinned member bytes without dlopen. Normalized paths are relative to a materialized capture, not the original host file. Native ABI and behavior are checked at execution; current operator trust is always separate."
}
