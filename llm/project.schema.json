{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/project-1.json",
  "title": "Current NEX project manifest",
  "description": "Authoring schema for the advertised source languages. Old graphs require explicit migration; a manifest edit does not upgrade history.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "nex.project/1"
    },
    "language": {
      "enum": [
        "0.25",
        "0.26",
        "0.27",
        "0.28"
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+(?![\\s\\S])"
    },
    "libraries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z_0-9]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000]+(?![\\s\\S])"
      }
    }
  }
}
