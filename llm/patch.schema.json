{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEX protocol 2 function, endpoint or type replacement patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "replacements"
  ],
  "properties": {
    "expected_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^([A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "function",
              "endpoint",
              "type"
            ]
          }
        }
      }
    }
  }
}
