{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/task-debug-expression-1.json",
  "title": "NEX pure logical task watch protocol; captured data lives outside the inferior",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "nex.task-expression-plan/1",
        "nex.task-expression-demand/1",
        "nex.task-expression/1"
      ]
    },
    "ok": {
      "const": true
    },
    "language": {
      "enum": [
        "0.19",
        "0.20",
        "0.21",
        "0.22",
        "0.23",
        "0.24",
        "0.25"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "function": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "stop": {
      "$ref": "task-debug-frame.schema.json#/properties/stop"
    },
    "frame_truncated": {
      "type": "boolean"
    },
    "limits": {
      "type": "object"
    },
    "type": {
      "type": "string",
      "maxLength": 4096
    },
    "steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "variables": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "wire_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "maxLength": 4096
          },
          "wire_schema": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "request": {
      "type": "object"
    },
    "wire_schema": {
      "type": "object"
    },
    "value": {},
    "display": {
      "type": "string",
      "maxLength": 4097
    },
    "display_truncated": {
      "type": "boolean"
    },
    "read_bindings": {
      "type": "array"
    },
    "read_paths": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ok",
    "language",
    "revision",
    "build_key",
    "function",
    "expression",
    "stop",
    "frame_truncated",
    "limits",
    "type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.task-expression-plan/1"
          }
        }
      },
      "then": {
        "required": [
          "variables"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.task-expression-demand/1"
          }
        }
      },
      "then": {
        "required": [
          "request",
          "steps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.task-expression/1"
          }
        }
      },
      "then": {
        "required": [
          "value",
          "display",
          "steps",
          "display_truncated",
          "read_bindings",
          "read_paths"
        ]
      }
    }
  ]
}
