{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-lang.local/schema/core-capsule/1",
  "title": "NEX native core capsule receipt and successful export",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/export"
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "identity",
        "host",
        "recorded_program",
        "build_directory",
        "core",
        "original_manifest",
        "native_dependencies",
        "dependency_scope",
        "application_execution",
        "files",
        "original_program"
      ],
      "properties": {
        "schema": {
          "const": "nex.core-capsule/1"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolchain",
            "language",
            "compiler_build",
            "runtime_view",
            "expression_protocol",
            "build_key",
            "revision",
            "source_hash"
          ],
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "compiler_build": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "runtime_view": {
              "const": "nex.runtime-view/3"
            },
            "expression_protocol": {
              "const": "nex.debug-expression/3"
            },
            "build_key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "machine"
          ],
          "properties": {
            "os": {
              "enum": [
                "darwin",
                "linux"
              ]
            },
            "machine": {
              "enum": [
                "arm64",
                "x86_64"
              ]
            }
          }
        },
        "recorded_program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "build_directory": {
          "type": "string",
          "pattern": "^build/[0-9a-f]{64}$"
        },
        "core": {
          "const": "process.core"
        },
        "original_manifest": {
          "const": "original-debug.json"
        },
        "native_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "dependency_scope": {
          "enum": [
            "matching_host_system_only",
            "captured_first_party_and_matching_host_system"
          ]
        },
        "application_execution": {
          "const": false
        },
        "files": {
          "type": "object",
          "minProperties": 9,
          "maxProperties": 4096,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\\\\\x00]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "bytes"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 34359738368
              }
            }
          }
        },
        "original_program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "recorded_images": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 129,
          "propertyNames": {
            "pattern": "^images/libnex_[A-Za-z_][A-Za-z_0-9]{0,63}_[0-9a-f]{64}\\.(so|dylib)$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "^/"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dependency_scope": {
                "const": "captured_first_party_and_matching_host_system"
              }
            }
          },
          "then": {
            "required": [
              "recorded_images"
            ]
          },
          "else": {
            "not": {
              "required": [
                "recorded_images"
              ]
            }
          }
        }
      ]
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "directory",
        "manifest",
        "manifest_sha256",
        "build_key",
        "revision",
        "files",
        "bytes",
        "read_after_export",
        "inferior_execution"
      ],
      "properties": {
        "schema": {
          "const": "nex.core-capsule-export/1"
        },
        "ok": {
          "const": true
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 9,
          "maximum": 4096
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35433480192
        },
        "read_after_export": {
          "const": true
        },
        "inferior_execution": {
          "const": false
        }
      }
    }
  }
}
