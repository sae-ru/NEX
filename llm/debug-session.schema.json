{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/debug-session-1.json",
  "title": "Fresh checked native debugger session (toolchain0.85+)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "revision",
    "build_key",
    "application_kind",
    "host_compatible",
    "manifest",
    "adapter",
    "launch",
    "nex_adapter"
  ],
  "properties": {
    "schema": {
      "const": "nex.debug-session/1"
    },
    "ok": {
      "const": true
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "application_kind": {
      "enum": [
        "executable",
        "http_server"
      ]
    },
    "host_compatible": {
      "const": true
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "enum": [
        "nex-dap",
        "lldb-dap"
      ]
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "nex_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "available",
        "command",
        "launch"
      ],
      "properties": {
        "schema": {
          "const": "nex.dap-adapter/1"
        },
        "available": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "launch": {
          "$ref": "#/$defs/launch"
        }
      }
    },
    "adapter_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      }
    },
    "task_debug": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "nex.task-debug-session/1"
            },
            "catalog_abi": {
              "const": 1
            },
            "deadline_advances_while_stopped": {
              "const": true
            },
            "task_execution": {
              "$ref": "#/$defs/native_task_execution"
            }
          },
          "required": [
            "schema",
            "catalog_abi",
            "deadline_advances_while_stopped",
            "task_execution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "nex.task-debug-session/2"
            },
            "catalog_abi": {
              "const": 2
            },
            "deadline_advances_while_stopped": {
              "const": true
            },
            "task_execution": {
              "$ref": "#/$defs/native_task_execution"
            },
            "registry_abi": {
              "const": 1
            },
            "metadata_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "catalog_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_union_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "schema",
            "catalog_abi",
            "deadline_advances_while_stopped",
            "task_execution",
            "registry_abi",
            "metadata_hash",
            "catalog_hash",
            "source_union_hash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "task_execution": {
      "$ref": "#/$defs/native_task_execution"
    }
  },
  "$defs": {
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request",
        "name",
        "program",
        "cwd",
        "stopOnEntry",
        "initCommands"
      ],
      "properties": {
        "type": {
          "enum": [
            "nex",
            "lldb-dap"
          ]
        },
        "request": {
          "const": "launch"
        },
        "name": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "stopOnEntry": {
          "type": "boolean"
        },
        "initCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "sourceMap": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          }
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "nexTaskDebug": {
          "const": true
        }
      }
    },
    "task_limits": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 3,
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "steps",
        "timeout_ms",
        "workers"
      ]
    },
    "native_task_execution": {
      "type": "object",
      "properties": {
        "configured": {
          "$ref": "#/$defs/task_limits"
        },
        "effective": {
          "$ref": "#/$defs/task_limits"
        },
        "backend": {
          "const": "native"
        },
        "executor_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "step_model": {
          "const": "native resume and runtime polls"
        },
        "cooperative_deadline": {
          "const": true
        },
        "identical_step_thresholds": {
          "const": false
        }
      },
      "required": [
        "configured",
        "effective",
        "backend",
        "executor_workers",
        "step_model",
        "cooperative_deadline",
        "identical_step_thresholds"
      ],
      "additionalProperties": false
    }
  },
  "description": "A fresh compiler response selects the checked executable/server and matching captured adapter. Paths are absolute compiler metadata, not authority from a saved receipt. Preparing this descriptor does not start the application, read runtime credentials or create its database. Runtime args are UTF-8 without NUL,4 KiB per member and64 KiB total. Project/server debugging preserves declared binary edges and request limits.",
  "allOf": [
    {
      "if": {
        "required": [
          "task_debug"
        ]
      },
      "then": {
        "properties": {
          "adapter": {
            "const": "nex-dap"
          },
          "application_kind": {
            "const": "executable"
          },
          "launch": {
            "required": [
              "nexTaskDebug"
            ],
            "properties": {
              "nexTaskDebug": {
                "const": true
              },
              "type": {
                "const": "nex"
              },
              "stopOnEntry": {
                "const": false
              }
            }
          },
          "nex_adapter": {
            "properties": {
              "launch": {
                "required": [
                  "nexTaskDebug"
                ],
                "properties": {
                  "nexTaskDebug": {
                    "const": true
                  },
                  "type": {
                    "const": "nex"
                  },
                  "stopOnEntry": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "launch": {
            "not": {
              "required": [
                "nexTaskDebug"
              ]
            }
          },
          "nex_adapter": {
            "properties": {
              "launch": {
                "not": {
                  "required": [
                    "nexTaskDebug"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
