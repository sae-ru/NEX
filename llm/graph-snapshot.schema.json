{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/graph-snapshot-1.json",
  "title": "NEX complete graph snapshot manifest and recovery results",
  "description": "The compiler additionally enforces byte limits, SQLite structure/integrity and state/digest agreement. External artifacts and application data are excluded. Hashes do not authenticate provenance.",
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graph_schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})?(?![\\s\\S])"
        },
        "head_language": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "namespace": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{32})?(?![\\s\\S])"
        },
        "table_counts": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\u0000]+(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "required": [
            "metadata",
            "revisions",
            "head",
            "node_ids",
            "nodes",
            "edges"
          ]
        }
      },
      "required": [
        "graph_schema",
        "head",
        "head_language",
        "namespace",
        "table_counts"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "head": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "head_language": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "head_language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "nex.graph-snapshot/1"
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000]+(?![\\s\\S])"
        },
        "compiler_build": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})(?![\\s\\S])"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "const": "graph.db"
            },
            "sha256": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{64})(?![\\s\\S])"
            },
            "bytes": {
              "type": "integer",
              "minimum": 512,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "file",
            "sha256",
            "bytes"
          ]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "contents": {
          "const": [
            "graph_database",
            "archived_sources",
            "local_identities",
            "identity_aliases",
            "change_journal",
            "task_run_index"
          ]
        },
        "external_artifacts_included": {
          "const": false
        }
      },
      "required": [
        "schema",
        "created",
        "toolchain",
        "compiler_build",
        "database",
        "state",
        "contents",
        "external_artifacts_included"
      ]
    },
    "snapshot_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "nex.snapshot-result/1"
        },
        "ok": {
          "const": true
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "database_sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 9223372036854775807
        },
        "source_unchanged": {
          "const": true
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})?(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{32})?(?![\\s\\S])"
        },
        "graph_schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "required": [
        "schema",
        "ok",
        "directory",
        "manifest",
        "database_sha256",
        "bytes",
        "source_unchanged",
        "head",
        "namespace",
        "graph_schema"
      ]
    },
    "recovery_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "nex.recovery-result/1"
        },
        "ok": {
          "const": true
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "database_sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})(?![\\s\\S])"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})?(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{32})?(?![\\s\\S])"
        },
        "graph_schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "materialized": {
          "const": false
        },
        "existing_project_unchanged": {
          "const": true
        }
      },
      "required": [
        "schema",
        "ok",
        "directory",
        "database_sha256",
        "head",
        "namespace",
        "graph_schema",
        "materialized",
        "existing_project_unchanged"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/snapshot_result"
    },
    {
      "$ref": "#/$defs/recovery_result"
    }
  ]
}
