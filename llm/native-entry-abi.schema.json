{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEX compiler-private native library entry ABI",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "toolchain", "language", "compiler_build", "build_key", "library_abi", "target", "compiler_target", "data_layout", "llvm_sha256", "stable_public_abi", "runtime_header", "synchronous_call_scope", "cleanup_after_scopes", "task_calls_require_executor", "entries"],
  "properties": {
    "schema": {"const": "nex.native-entry-abi/1"},
    "toolchain": {"type": "string"},
    "language": {"type": "string"},
    "compiler_build": {"$ref": "#/$defs/hash"},
    "build_key": {"$ref": "#/$defs/hash"},
    "library_abi": {"$ref": "#/$defs/hash"},
    "target": {"type": "string"},
    "compiler_target": {"type": "string"},
    "data_layout": {"type": "string", "minLength": 1},
    "llvm_sha256": {"$ref": "#/$defs/hash"},
    "stable_public_abi": {"const": false},
    "runtime_header": {"const": "nex_host.h"},
    "synchronous_call_scope": {"const": "nexrt::RequestScope"},
    "cleanup_after_scopes": {"const": "nex_runtime_finish"},
    "task_calls_require_executor": {"const": true},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_function", "native_symbol", "source_result", "source_effects", "source_function_hash", "defined", "mode", "direct_host_call", "calling_convention", "variadic", "llvm_function_type", "llvm_function_attributes", "return", "parameters"],
      "properties": {
        "source_function": {"type": "string"},
        "native_symbol": {"type": "string"},
        "source_result": {"type": "string"},
        "source_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_function_hash": {"$ref": "#/$defs/hash"},
        "defined": {"type": "boolean"},
        "mode": {"enum": ["synchronous", "closure", "task_executor"]},
        "direct_host_call": {"type": "boolean"},
        "calling_convention": {"type": "integer", "minimum": 0},
        "variadic": {"type": "boolean"},
        "llvm_function_type": {"type": "string"},
        "llvm_function_attributes": {"type": "string"},
        "return": {
          "type": "object", "additionalProperties": false,
          "required": ["llvm_type", "llvm_attributes", "ownership"],
          "properties": {
            "llvm_type": {"type": "string"},
            "llvm_attributes": {"type": "string"},
            "ownership": {"enum": ["executor", "same_runtime_scope_managed_handle", "none", "value"]}
          }
        },
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"enum": ["task_executor", "closure"]}}},
        "then": {"properties": {"direct_host_call": {"const": false}}}
      }]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "llvm_type", "llvm_attributes", "role"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "llvm_type": {"type": "string"},
        "llvm_attributes": {"type": "string"},
        "role": {"enum": ["source_parameter", "source_error_out", "closure_environment", "task_executor_argument"]},
        "source_name": {"type": "string"},
        "source_type": {"type": "string"},
        "ownership": {"enum": ["same_runtime_handle_valid_for_call", "value"]},
        "initialize": {"const": "null_handle"},
        "runtime_cpp_type": {"const": "nexrt::Handle **"},
        "on_non_null": {"const": "nex_source_error_unhandled"}
      },
      "allOf": [{
        "if": {"properties": {"role": {"const": "source_parameter"}}},
        "then": {"required": ["source_name", "source_type", "ownership"]}
      }, {
        "if": {"properties": {"role": {"const": "source_error_out"}}},
        "then": {"required": ["initialize", "runtime_cpp_type", "on_non_null"], "properties": {"llvm_type": {"const": "ptr"}}}
      }]
    }
  }
}
