{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.discovery/1",
  "title": "Readonly compiler capability projection",
  "type": "object",
  "required": ["schema", "language", "toolchain", "compiler_build", "descriptor_hash", "kind"],
  "properties": {
    "schema": {"const": "nex.discovery/1"},
    "language": {"type": "string", "minLength": 1, "maxLength": 32},
    "toolchain": {"type": "string", "minLength": 1},
    "compiler_build": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["index", "field"]},
    "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"}},
    "full_schema": {"const": "nex.language/1"},
    "full_command": {"const": "nex describe --json"},
    "field_command": {"const": "nex describe --field PATH --json"},
    "guide": {"const": "docs/discovery.md"},
    "bootstrap_prompt": {"const": "llm/BOOTSTRAP.md"},
    "field": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z_0-9]*(\\.[A-Za-z_][A-Za-z_0-9]*){0,7}$"},
    "value": {}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "index"}}, "required": ["fields", "full_schema", "full_command", "field_command", "guide", "bootstrap_prompt"], "not": {"anyOf": [{"required": ["field"]}, {"required": ["value"]}]}},
    {"properties": {"kind": {"const": "field"}}, "required": ["field", "value"], "not": {"anyOf": [{"required": ["fields"]}, {"required": ["full_schema"]}, {"required": ["full_command"]}, {"required": ["field_command"]}, {"required": ["guide"]}, {"required": ["bootstrap_prompt"]}]}}
  ],
  "additionalProperties": false
}
