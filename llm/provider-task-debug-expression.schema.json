{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/provider-task-debug-expression-2.json",
  "title": "Read-only provider task expression with checked component source identity",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "nex.task-expression-plan/2",
        "nex.task-expression-demand/2",
        "nex.task-expression/2"
      ]
    },
    "ok": {
      "const": true
    },
    "language": {
      "enum": [
        "0.19",
        "0.20",
        "0.21",
        "0.22",
        "0.23",
        "0.24",
        "0.25",
        "0.26",
        "0.27",
        "0.28"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "function": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "stop": {
      "$ref": "task-debug-frame.schema.json#/properties/stop"
    },
    "frame_truncated": {
      "type": "boolean"
    },
    "limits": {
      "type": "object"
    },
    "type": {
      "type": "string",
      "maxLength": 4096
    },
    "steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "variables": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "wire_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "maxLength": 4096
          },
          "wire_schema": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "request": {
      "type": "object"
    },
    "wire_schema": {
      "type": "object"
    },
    "value": {},
    "display": {
      "type": "string",
      "maxLength": 4097
    },
    "display_truncated": {
      "type": "boolean"
    },
    "read_bindings": {
      "type": "array"
    },
    "read_paths": {
      "type": "array"
    },
    "source_identity": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
        },
        "owner_image": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
        },
        "language": {
          "enum": [
            "0.19",
            "0.20",
            "0.21",
            "0.22",
            "0.23",
            "0.24",
            "0.25",
            "0.26",
            "0.27",
            "0.28"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_unit_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "component",
        "owner_image",
        "language",
        "revision",
        "source_hash",
        "source_unit_hash",
        "contract"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "ok",
    "language",
    "revision",
    "build_key",
    "function",
    "expression",
    "stop",
    "frame_truncated",
    "limits",
    "type",
    "source_identity"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.task-expression-plan/2"
          }
        }
      },
      "then": {
        "required": [
          "variables"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.task-expression-demand/2"
          }
        }
      },
      "then": {
        "required": [
          "request",
          "steps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "nex.task-expression/2"
          }
        }
      },
      "then": {
        "required": [
          "value",
          "display",
          "steps",
          "display_truncated",
          "read_bindings",
          "read_paths"
        ]
      }
    }
  ]
}
