{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/project-foreign-projection-1.json",
  "title": "Checked project-wide foreign pin projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_plan_hash",
    "source_catalogue_hash",
    "components",
    "source_files_modified",
    "graph_store_opened",
    "module_initialization",
    "preparation"
  ],
  "properties": {
    "schema": {
      "const": "nex.project-foreign-projection/1"
    },
    "source_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_catalogue_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_revision",
          "packaged_revision",
          "source_hash",
          "packaged_source_hash",
          "changes"
        ],
        "properties": {
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "packaged_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "packaged_source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "https://nex.dev/schemas/foreign-projection-1.json#/properties/changes/items"
            }
          }
        }
      }
    },
    "source_files_modified": {
      "const": false
    },
    "graph_store_opened": {
      "const": false
    },
    "module_initialization": {
      "const": false
    },
    "preparation": {
      "$ref": "https://nex.dev/schemas/foreign-package-1.json"
    }
  }
}
