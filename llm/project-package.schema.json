{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/project-package-1.json",
  "title": "Captured NEX project deployment package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "plan_hash",
    "compiler_version",
    "compiler_build",
    "language",
    "configuration",
    "profile",
    "components",
    "files",
    "graph_store_opened",
    "application_execution",
    "target_execution_verified",
    "native_dependencies_inspected"
  ],
  "properties": {
    "schema": {
      "const": "nex.project-package/1"
    },
    "ok": {
      "const": true
    },
    "plan_hash": {
      "$ref": "#/$defs/hash"
    },
    "compiler_version": {
      "type": "string",
      "maxLength": 256
    },
    "compiler_build": {
      "$ref": "#/$defs/hash"
    },
    "language": {
      "const": "0.16"
    },
    "configuration": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
    },
    "profile": {
      "enum": [
        "debug",
        "release",
        "profile"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "kind",
          "directory",
          "entry",
          "revision"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,63}$"
          },
          "kind": {
            "enum": [
              "executable",
              "server",
              "web"
            ]
          },
          "directory": {
            "$ref": "#/$defs/path"
          },
          "entry": {
            "$ref": "#/$defs/path"
          },
          "manifest": {
            "$ref": "#/$defs/path"
          },
          "revision": {
            "$ref": "#/$defs/hash"
          },
          "build_key": {
            "$ref": "#/$defs/hash"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "executable",
                    "server"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "manifest",
                "build_key"
              ]
            }
          }
        ]
      }
    },
    "files": {
      "type": "object",
      "maxProperties": 16384,
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "bytes",
              "executable"
            ],
            "properties": {
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "executable": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symlink"
            ],
            "properties": {
              "symlink": {
                "$ref": "#/$defs/path"
              }
            }
          }
        ]
      }
    },
    "graph_store_opened": {
      "const": false
    },
    "application_execution": {
      "const": false
    },
    "target_execution_verified": {
      "const": false
    },
    "native_dependencies_inspected": {
      "type": "boolean"
    },
    "directory": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "foreign_projection": {
      "$ref": "https://nex.local/schemas/project-foreign-projection-1.json"
    }
  },
  "dependentRequired": {
    "directory": [
      "manifest"
    ],
    "manifest": [
      "directory"
    ]
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
    }
  }
}
