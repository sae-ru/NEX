{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/project-task-linkage-2.json",
  "title": "Checked fixed task-image ownership per application load closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "execution_abi",
    "definitions",
    "imports",
    "exports",
    "mode",
    "load_closure"
  ],
  "properties": {
    "schema": {
      "const": "nex.project-task-linkage/2"
    },
    "component": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "execution_abi": {
      "const": 3
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "contract"
        ],
        "properties": {
          "function": {
            "$ref": "native-task-provider.schema.json#/$defs/function"
          },
          "contract": {
            "$ref": "native-task-provider.schema.json#/$defs/hash"
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "provider",
          "contract",
          "calling_mode"
        ],
        "properties": {
          "function": {
            "$ref": "native-task-provider.schema.json#/$defs/function"
          },
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "contract": {
            "$ref": "native-task-provider.schema.json#/$defs/hash"
          },
          "calling_mode": {
            "enum": [
              "task-code/3",
              "sync/1"
            ]
          }
        }
      }
    },
    "exports": {
      "type": "object",
      "propertyNames": {
        "$ref": "native-task-provider.schema.json#/$defs/function"
      },
      "additionalProperties": {
        "$ref": "native-task-provider.schema.json#/$defs/export"
      }
    },
    "mode": {
      "const": "shared-fixed"
    },
    "load_closure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "images"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 129,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "component",
                  "kind",
                  "definitions",
                  "static_components",
                  "dynamic_components"
                ],
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "kind": {
                    "enum": [
                      "application",
                      "shared-image"
                    ]
                  },
                  "definitions": {
                    "type": "array",
                    "maxItems": 65536,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "function",
                        "source_component",
                        "contract"
                      ],
                      "properties": {
                        "function": {
                          "$ref": "native-task-provider.schema.json#/$defs/function"
                        },
                        "source_component": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "contract": {
                          "$ref": "native-task-provider.schema.json#/$defs/hash"
                        }
                      }
                    }
                  },
                  "static_components": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "dynamic_components": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
