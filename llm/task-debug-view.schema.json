{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/task-debug-view-1.json",
  "title": "NEX native logical task debugger catalog binding",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nex.task-debug-view/1"
    },
    "abi": {
      "const": 1
    },
    "catalog_symbol": {
      "const": "nex_task_debug_catalog_v1"
    },
    "marker_symbol": {
      "const": "nex_task_debug_stop_marker"
    },
    "metadata_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,128}$"
    },
    "deadline_advances_while_stopped": {
      "const": true
    },
    "maximum_codes": {
      "const": 16384
    },
    "maximum_points": {
      "const": 262144
    },
    "maximum_bindings": {
      "const": 65536
    },
    "maximum_visible_bindings": {
      "const": 1048576
    }
  },
  "required": [
    "schema",
    "abi",
    "catalog_symbol",
    "marker_symbol",
    "metadata_hash",
    "image_sha256",
    "image_uuid",
    "deadline_advances_while_stopped",
    "maximum_codes",
    "maximum_points",
    "maximum_bindings",
    "maximum_visible_bindings"
  ],
  "additionalProperties": false
}
