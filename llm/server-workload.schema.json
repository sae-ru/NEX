{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/server-workload-1.json",
  "title": "Bounded local NEX native server workload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nex.server-workload/1"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/(?!/)[\\x21-\\x22\\x24-\\x5b\\x5d-\\x7e]*$"
          },
          "body": {
            "type": "string",
            "maxLength": 65536
          },
          "content_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[ -~]+$",
            "default": "application/json"
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "text": {
                "type": "string",
                "maxLength": 65536
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "path",
          "expect"
        ]
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "concurrency",
          "iterations"
        ]
      }
    },
    "warmup": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128,
      "default": 0
    },
    "authorization_env": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,127}$"
    },
    "request_timeout_ms": {
      "type": "integer",
      "minimum": 50,
      "maximum": 5000,
      "default": 1000
    },
    "startup_timeout_ms": {
      "type": "integer",
      "minimum": 50,
      "maximum": 15000,
      "default": 5000
    }
  },
  "required": [
    "schema",
    "requests",
    "phases"
  ],
  "description": "Compiler and runner additionally enforce strict UTF-8, unique keys, integer JSON tokens, depth32, one MiB total, UTF-8 byte limits (rather than schema character limits), compatible text/SHA256 expectations and requests.length * (warmup + sum(concurrency * iterations)) <=4096. Paths start with exactly one slash, contain only ASCII33..126 and exclude # and backslash. No executable, environment values, headers, external address, redirects or retries are selectable here."
}
