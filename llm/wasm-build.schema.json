{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"NEX scalar Wasm build response",
 "type":"object","additionalProperties":false,
 "required":["ok","schema","kind","target","abi","cached","revision","build_key","directory","module","wrapper","metadata","notices","mlir","llvm","reachable_functions"],
 "properties":{
  "ok":{"const":true},"schema":{"const":"nex.wasm-build/1"},"kind":{"const":"scalar_wasm_module"},
  "target":{"const":"wasm32-unknown-unknown"},"abi":{"const":1},"cached":{"type":"boolean"},
  "revision":{"type":"string","pattern":"^[a-f0-9]{64}$"},"build_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "directory":{"type":"string","minLength":1},"module":{"type":"string","minLength":1},"wrapper":{"type":"string","minLength":1},
  "metadata":{"type":"string","minLength":1},"notices":{"type":"string","minLength":1},"mlir":{"type":"string","minLength":1},"llvm":{"type":"string","minLength":1},
  "reachable_functions":{"type":"integer","minimum":1,"maximum":128}
 }
}
