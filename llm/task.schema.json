{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/schemas/task-1.json",
  "title": "NEX task and acceptance checks",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nex.task/1"
    },
    "language": {
      "const": "0.21"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "goal": {
      "$ref": "#/$defs/text"
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "test"
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "$ref": "#/$defs/short"
                    },
                    "content_hash": {
                      "$ref": "#/$defs/hash"
                    }
                  },
                  "required": [
                    "symbol",
                    "content_hash"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              },
              "foreign_hash": {
                "$ref": "#/$defs/hash"
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "task_limits": {
                "$ref": "#/$defs/task_limits"
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target",
              "tests"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "toolchain": [
                "toolchain_hash"
              ],
              "toolchain_hash": [
                "toolchain"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "toolchain"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "native"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "foreign_hash"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "native"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "build"
              },
              "entry": {
                "$ref": "#/$defs/short"
              },
              "profile": {
                "enum": [
                  "debug",
                  "release",
                  "profile"
                ]
              },
              "mode": {
                "enum": [
                  "application",
                  "library",
                  "module"
                ]
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "task_limits": {
                "$ref": "#/$defs/task_limits"
              },
              "task_debug": {
                "type": "boolean",
                "description": "Native application build preparation only; task_debug true requires a dedicated debug-profile configuration in a captured project. It never launches an inferior."
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "toolchain": [
                "toolchain_hash"
              ],
              "toolchain_hash": [
                "toolchain"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "toolchain"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "not": {
                        "const": "web"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "run"
              },
              "entry": {
                "$ref": "#/$defs/short"
              },
              "profile": {
                "enum": [
                  "debug",
                  "release",
                  "profile"
                ]
              },
              "expect": {
                "type": "object",
                "properties": {
                  "stdout": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 8192
                  },
                  "exit_code": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "runtime_code": {
                    "$ref": "#/$defs/short"
                  }
                },
                "required": [
                  "stdout",
                  "exit_code"
                ],
                "additionalProperties": false
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              },
              "foreign_hash": {
                "$ref": "#/$defs/hash"
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "task_limits": {
                "$ref": "#/$defs/task_limits"
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target",
              "expect"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "toolchain": [
                "toolchain_hash"
              ],
              "toolchain_hash": [
                "toolchain"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "toolchain"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "native"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "foreign_hash"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "native"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "verify"
              },
              "contracts": {
                "$ref": "#/$defs/path"
              },
              "intent_hash": {
                "$ref": "#/$defs/hash"
              },
              "solver_timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              },
              "resource_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target",
              "contracts",
              "intent_hash"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "effects"
              },
              "symbols": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/short"
                },
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true
              },
              "allowed_effects": {
                "type": "array",
                "items": {
                  "enum": [
                    "io",
                    "db",
                    "fs",
                    "ffi",
                    "task"
                  ]
                },
                "minItems": 0,
                "maxItems": 64,
                "uniqueItems": true
              },
              "allowed_realms": {
                "type": "array",
                "items": {
                  "enum": [
                    "shared",
                    "client",
                    "server"
                  ]
                },
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target",
              "symbols",
              "allowed_effects"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "profile"
              },
              "entry": {
                "$ref": "#/$defs/short"
              },
              "scenario": {
                "$ref": "#/$defs/text"
              },
              "budget": {
                "type": "object",
                "properties": {
                  "max_duration_ns": {
                    "$ref": "#/$defs/decimal"
                  },
                  "max_peak_handles": {
                    "$ref": "#/$defs/decimal"
                  },
                  "max_peak_objects": {
                    "$ref": "#/$defs/decimal"
                  },
                  "max_calls": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 64,
                    "propertyNames": {
                      "$ref": "#/$defs/short"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/decimal"
                    }
                  },
                  "max_p95_latency_ns": {
                    "$ref": "#/$defs/decimal"
                  },
                  "max_p99_latency_ns": {
                    "$ref": "#/$defs/decimal"
                  },
                  "min_requests_per_second": {
                    "$ref": "#/$defs/decimal"
                  }
                },
                "required": [],
                "additionalProperties": false,
                "minProperties": 1
              },
              "hardware": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "$ref": "#/$defs/text"
                  },
                  "target": {
                    "$ref": "#/$defs/text"
                  }
                },
                "required": [
                  "cpu",
                  "target"
                ],
                "additionalProperties": false
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              },
              "foreign_hash": {
                "$ref": "#/$defs/hash"
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "workload": {
                "$ref": "#/$defs/path"
              },
              "workload_hash": {
                "$ref": "#/$defs/hash"
              },
              "server_workers": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "default": 8
              },
              "task_limits": {
                "$ref": "#/$defs/task_limits"
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target",
              "entry",
              "scenario",
              "budget"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "budget": {
                      "required": [
                        "max_duration_ns"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "hardware"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "toolchain"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "enum": [
                        "native",
                        "server"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "foreign_hash"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "enum": [
                        "native",
                        "server"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "workload"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "server"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "budget": {
                      "anyOf": [
                        {
                          "required": [
                            "max_p95_latency_ns"
                          ]
                        },
                        {
                          "required": [
                            "max_p99_latency_ns"
                          ]
                        },
                        {
                          "required": [
                            "min_requests_per_second"
                          ]
                        }
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "hardware",
                    "workload"
                  ]
                }
              }
            ],
            "dependentRequired": {
              "toolchain": [
                "toolchain_hash"
              ],
              "toolchain_hash": [
                "toolchain"
              ],
              "workload": [
                "workload_hash",
                "configuration"
              ],
              "workload_hash": [
                "workload"
              ],
              "server_workers": [
                "workload"
              ]
            }
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/short"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "kind": {
                "const": "api"
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "id",
              "program",
              "kind",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "Package a project-backed program using its declared configuration. Compiler requires program.project and an executable, server or web component. This builds/captures but never executes the application. Reachable native/server external bindings require foreign_hash and a current operator catalogue; preparation never initializes the module.",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "program": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "enum": [
                  "native",
                  "server",
                  "web"
                ]
              },
              "kind": {
                "const": "package"
              },
              "configuration": {
                "$ref": "#/$defs/id"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "toolchain": {
                "$ref": "#/$defs/id"
              },
              "toolchain_hash": {
                "$ref": "#/$defs/hash"
              },
              "notices": {
                "$ref": "#/$defs/path"
              },
              "notices_hash": {
                "$ref": "#/$defs/hash"
              },
              "foreign_hash": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "id",
              "program",
              "target",
              "kind",
              "configuration"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "toolchain": [
                "toolchain_hash"
              ],
              "toolchain_hash": [
                "toolchain"
              ],
              "notices": [
                "notices_hash"
              ],
              "notices_hash": [
                "notices"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "foreign_hash"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "enum": [
                        "native",
                        "server"
                      ]
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schema",
    "language",
    "id",
    "title",
    "goal",
    "programs",
    "requirements",
    "checks"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]*(?![\\s\\S])"
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]*(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+(?![\\s\\S])"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
    },
    "program": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "entry": {
          "$ref": "#/$defs/path"
        },
        "baseline_revision": {
          "$ref": "#/$defs/hash"
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manifest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^/\\\\]+$"
            },
            "component": {
              "$ref": "#/$defs/id"
            },
            "architecture_hash": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "manifest",
            "component",
            "architecture_hash"
          ]
        }
      },
      "required": [
        "id",
        "entry"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "program": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "function",
            "structure",
            "endpoint"
          ]
        },
        "symbol": {
          "$ref": "#/$defs/short"
        }
      },
      "required": [
        "program",
        "kind",
        "symbol"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/short"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "text",
        "bindings",
        "targets",
        "checks"
      ],
      "additionalProperties": false
    },
    "task_limits": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  }
}
