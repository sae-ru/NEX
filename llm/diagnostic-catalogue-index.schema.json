{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex.diagnostic-catalogue-index/1",
  "type": "object",
  "required": ["schema", "language", "toolchain", "compiler_build", "descriptor_hash", "catalogue_hash", "codes", "complete_code_registry", "command"],
  "properties": {
    "schema": {"const": "nex.diagnostic-catalogue-index/1"},
    "language": {"type": "string", "minLength": 1, "maxLength": 32},
    "toolchain": {"type": "string", "minLength": 1},
    "compiler_build": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalogue_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E_[A-Z0-9_]+$", "maxLength": 128}},
    "complete_code_registry": {"const": false},
    "command": {"const": "nex explain CODE --json"}
  },
  "additionalProperties": false
}
