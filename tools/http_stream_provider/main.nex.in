module http_stream_example;
import "std/http_stream.nex" as hs;
server extern fn open_raw(value:hs::Request)->result<hs::Response> !{ffi}=foreign("http_stream","open","@PIN@");
server extern fn read_raw(body:hs::Body,maximum:i64)->result<hs::Chunk> !{ffi}=foreign("http_stream","read","@PIN@");
server extern fn statistics_raw()->list<i64> !{ffi}=foreign("http_stream","statistics","@PIN@");
server fn open_checked(value:hs::Request)->result<hs::Response> !{task,ffi}{return open_raw(value);}
server fn read_checked(body:hs::Body,maximum:i64)->result<hs::Chunk> !{task,ffi}{return read_raw(body,maximum);}
server fn make_client()->hs::Client{return hs::client_context(open_checked,read_checked);}
client fn client_value()->i64{return 42;}
server fn main()->unit !{task,ffi,io}{
 let ctx:hs::Client=make_client();let response:hs::Response=unwrap(hs::open(ctx,hs::request("@AUTHORITY@","@METHOD@","@URL@",utf8_bytes(""),16777216,10000)));
 var total:i64=0;var done:bool=false;while !done{let part:hs::Chunk=unwrap(hs::read(ctx,response.body,65536));total=total+len(part.data);done=part.done;}
 assert(hs::close(response.body));print(total);
}
