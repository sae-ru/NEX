 static std::atomic<uint32_t> g_pipe_serial(0);
 static constexpr llvm::StringLiteral g_pipe_name_prefix = "\\\\.\\Pipe\\";
 
+// AppContainer named pipes use the per-package LOCAL namespace. Keep the
+// ordinary host namespace unchanged, and use the same decision at both ends.
+static Status GetPipePath(llvm::StringRef name, std::string &path) {
+  HANDLE token = nullptr;
+  if (!::OpenProcessToken(::GetCurrentProcess(), TOKEN_QUERY, &token))
+    return Status(::GetLastError(), eErrorTypeWin32);
+  DWORD app_container = 0;
+  DWORD bytes = 0;
+  // TokenIsAppContainer is hidden by some supported SDK header targets.
+  BOOL inspected = ::GetTokenInformation(
+      token, static_cast<TOKEN_INFORMATION_CLASS>(29), &app_container,
+      sizeof(app_container), &bytes);
+  DWORD error = inspected ? ERROR_SUCCESS : ::GetLastError();
+  ::CloseHandle(token);
+  if (!inspected)
+    return Status(error, eErrorTypeWin32);
+  path = g_pipe_name_prefix.str();
+  if (app_container && !name.take_front(6).equals_insensitive("LOCAL\\"))
+    path.append("LOCAL\\");
+  path.append(name.str());
+  return Status();
+}
