module tcp_example;
import "std/tcp.nex" as tcp;
server extern fn exchange_raw(endpoint:str,body:bytes,reply_limit:i64,timeout_ms:i64)->result<bytes> !{ffi}=foreign("tcp","exchange","@PIN@");
server extern fn statistics_raw()->list<i64> !{ffi}=foreign("tcp","statistics","@PIN@");
server fn exchange_provider(request:tcp::Request)->result<bytes> !{task,ffi} {
  return exchange_raw(request.endpoint,request.body,request.reply_limit,request.timeout_ms);
}
pub server fn make_client()->tcp::Client {return tcp::client_context(exchange_provider);}
client fn client_value()->i64 {return 42;}
server fn main()->unit !{task,ffi,io} {
  // Preparation selects a permitted endpoint name. The operator starts the
  // corresponding service; the body is arbitrary protocol data, not HTTP.
  let response:result<bytes>=tcp::execute(make_client(),tcp::request("@ENDPOINT@",utf8_bytes("hello"),4096,5000));
  print(encode_json(response));
}
